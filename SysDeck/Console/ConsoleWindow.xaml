<Window x:Class="SysDeck.ConsoleMode.ConsoleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SysDeck - Mode console" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="#FF07090E" Topmost="True" WindowStartupLocation="Manual" Left="0" Top="0" Width="1280" Height="720"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal" FontFamily="Segoe UI">
    <Grid ClipToBounds="True">
        <!-- Fond du thème, images « hero » (fondu enchaîné), décor animé, puis dégradés (couleurs posées par ApplyTheme) -->
        <Rectangle x:Name="BaseBg"/>
        <Image x:Name="HeroA" Stretch="UniformToFill" Opacity="0"/>
        <Image x:Name="HeroB" Stretch="UniformToFill" Opacity="0"/>
        <!-- Glitch du fond (thème Néon glitch) : tranches de l'image décalées par moments -->
        <Grid x:Name="BgGlitchLayer" IsHitTestVisible="False" ClipToBounds="True"/>
        <Viewbox Stretch="UniformToFill" IsHitTestVisible="False">
            <Canvas x:Name="AmbientCanvas" Width="1920" Height="1080" ClipToBounds="True"/>
        </Viewbox>
        <Rectangle x:Name="ShadeH"/>
        <Rectangle x:Name="ShadeV"/>

        <Viewbox Stretch="Uniform">
            <Grid Width="1920" Height="1080">
                <!-- Barre du haut : onglets à gauche, manette + heure à droite -->
                <StackPanel x:Name="TabsPanel" Orientation="Horizontal" Margin="100,46,0,0"
                            HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <StackPanel Orientation="Horizontal" Margin="0,46,100,0" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <StackPanel x:Name="ControllersPanel" Orientation="Horizontal" Margin="0,0,44,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ClockText" Foreground="White" FontSize="38" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Rangée de jaquettes -->
                <Canvas x:Name="Shelf" Height="440" Margin="0,125,0,0" VerticalAlignment="Top" ClipToBounds="False"/>

                <!-- Détail du jeu sélectionné -->
                <StackPanel x:Name="Detail" Margin="100,585,0,0" Width="1000" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <StackPanel.RenderTransform><TranslateTransform x:Name="DetailShift"/></StackPanel.RenderTransform>
                    <Grid Height="96">
                        <Image x:Name="LogoImage" Stretch="Uniform" HorizontalAlignment="Left" MaxWidth="560" Visibility="Collapsed"/>
                        <TextBlock x:Name="TitleText" Foreground="White" FontSize="58" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                    </Grid>
                    <Border x:Name="PlatformBadge" Background="#335B8DEF" BorderBrush="#FF5B8DEF" BorderThickness="1" CornerRadius="6"
                            HorizontalAlignment="Left" Padding="12,2" Margin="0,4,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="PlatformText" Foreground="#FFBBD0FF" FontSize="21" FontWeight="SemiBold"/>
                    </Border>
                    <TextBlock x:Name="DescriptionText" Foreground="#FFD5DAE3" FontSize="24" TextWrapping="Wrap"
                               MaxHeight="93" TextTrimming="CharacterEllipsis" Margin="0,10,0,0" LineHeight="31"/>
                    <TextBlock x:Name="InfoText" Foreground="#FF9AA3B5" FontSize="20" Margin="0,12,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                        <Border x:Name="PlayButton" CornerRadius="12" Width="260" Height="70" Cursor="Hand"
                                BorderThickness="3" MouseLeftButtonUp="PlayButton_Click" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform x:Name="PlayScale"/></Border.RenderTransform>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="PlayGlyph" Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="White"
                                           VerticalAlignment="Center" Margin="0,0,14,0"/>
                                <TextBlock x:Name="PlayText" Text="Jouer" Foreground="White" FontSize="30" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="QuitButton" CornerRadius="12" Width="250" Height="70" Cursor="Hand" Margin="20,0,0,0"
                                BorderThickness="3" MouseLeftButtonUp="QuitButton_Click" RenderTransformOrigin="0.5,0.5" Visibility="Collapsed">
                            <Border.RenderTransform><ScaleTransform x:Name="QuitScale"/></Border.RenderTransform>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="QuitGlyph" Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="White"
                                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock x:Name="QuitText" Text="Quitter" Foreground="White" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="InfoButton" CornerRadius="12" Width="190" Height="70" Cursor="Hand" Margin="20,0,0,0"
                                BorderThickness="3" MouseLeftButtonUp="InfoButton_Click" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform x:Name="InfoScale"/></Border.RenderTransform>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="InfoGlyph" Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="White"
                                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock x:Name="InfoLabel" Text="Infos" Foreground="White" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Bibliothèque vide -->
                <TextBlock x:Name="EmptyText" Visibility="Collapsed" Foreground="#FFD5DAE3" FontSize="40" TextAlignment="Center"
                           TextWrapping="Wrap" Width="1200" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Text="Ajoute tes jeux dans Paramètres &gt; Mode console"/>

                <!-- Aide : boutons de la manette, en bas à droite -->
                <StackPanel x:Name="HintsPanel" Orientation="Horizontal" Margin="0,0,100,40"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom"/>

                <!-- Fiche complète du jeu -->
                <Grid x:Name="InfoPanel" Visibility="Collapsed" Background="#E607090E">
                    <Border x:Name="InfoCard" Background="#FF121722" BorderBrush="#FF2A3245" BorderThickness="1" CornerRadius="18"
                            Width="1400" Height="760" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="50">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="400"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border CornerRadius="14" ClipToBounds="True" Width="400" Height="600" VerticalAlignment="Top" Background="#FF1A1F2B">
                                <Image x:Name="InfoCover" Stretch="UniformToFill"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="50,0,0,0">
                                <TextBlock x:Name="InfoTitle" Foreground="White" FontSize="52" FontWeight="Bold" TextWrapping="Wrap"/>
                                <TextBlock x:Name="InfoMeta" Foreground="#FF9AA3B5" FontSize="22" Margin="0,12,0,0" TextWrapping="Wrap"/>
                                <ScrollViewer x:Name="InfoScroll" VerticalScrollBarVisibility="Hidden" MaxHeight="460" Margin="0,26,0,0">
                                    <TextBlock x:Name="InfoDescription" Foreground="#FFD5DAE3" FontSize="27" TextWrapping="Wrap" LineHeight="38"/>
                                </ScrollViewer>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Choix du thème : aperçu en direct sur toute l'interface -->
                <Grid x:Name="ThemePanel" Visibility="Collapsed">
                    <Rectangle x:Name="ThemeShade" Height="430" VerticalAlignment="Bottom"/>
                    <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,110">
                        <TextBlock x:Name="ThemeHeader" Text="Thème" FontSize="40" FontWeight="SemiBold" Margin="100,0,0,8"/>
                        <TextBlock x:Name="ThemeHint" Text="Aperçu en direct : ⬅ ➡ pour changer, A pour garder, B pour annuler"
                                   FontSize="22" Margin="100,0,0,24"/>
                        <Canvas Height="175" ClipToBounds="False">
                            <StackPanel x:Name="ThemeStrip" Orientation="Horizontal" Canvas.Left="100">
                                <StackPanel.RenderTransform><TranslateTransform x:Name="ThemeStripShift"/></StackPanel.RenderTransform>
                            </StackPanel>
                        </Canvas>
                    </StackPanel>
                </Grid>

                <!-- Jauge de volume (gâchettes LT / RT) -->
                <Border x:Name="VolumeOsd" Opacity="0" CornerRadius="34" Padding="34,16" HorizontalAlignment="Center" VerticalAlignment="Top"
                        Margin="0,40,0,0" IsHitTestVisible="False">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="VolumeGlyph" Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="34" VerticalAlignment="Center"/>
                        <Grid Width="380" Height="10" Margin="22,0,22,0" VerticalAlignment="Center">
                            <Border x:Name="VolumeTrack" CornerRadius="5"/>
                            <Border x:Name="VolumeFill" CornerRadius="5" HorizontalAlignment="Left" Width="0"/>
                        </Grid>
                        <TextBlock x:Name="VolumeText" FontSize="30" FontWeight="SemiBold" MinWidth="56" TextAlignment="Right" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Effet « glitch » (thème Néon glitch) : barres décalées au changement de jeu -->
                <Canvas x:Name="GlitchLayer" IsHitTestVisible="False" ClipToBounds="True"/>

                <!-- Message d'erreur transitoire -->
                <Border x:Name="Toast" Opacity="0" Background="#F01B2030" BorderBrush="#FF5B8DEF" BorderThickness="1" CornerRadius="10"
                        Padding="30,16" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,120" IsHitTestVisible="False">
                    <TextBlock x:Name="ToastText" Foreground="White" FontSize="28"/>
                </Border>
            </Grid>
        </Viewbox>

        <!-- Calque de chargement : démarrage, lancement d'un jeu, pendant le jeu (fond derrière le jeu) -->
        <Grid x:Name="LoadingLayer" Background="#FF07090E" Visibility="Collapsed">
            <Image x:Name="LoadingHero" Stretch="UniformToFill" Opacity="0.28"/>
            <Rectangle x:Name="LoadingVignette"/>
            <Viewbox Stretch="Uniform">
                <Grid Width="1920" Height="1080">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border x:Name="LoadingCoverHost" CornerRadius="14" ClipToBounds="True" Width="240" Height="360"
                                HorizontalAlignment="Center" Margin="0,0,0,40" Visibility="Collapsed">
                            <Border.Effect><DropShadowEffect Color="#FF5B8DEF" BlurRadius="60" ShadowDepth="0" Opacity="0.5"/></Border.Effect>
                            <Image x:Name="LoadingCover" Stretch="UniformToFill"/>
                        </Border>
                        <TextBlock x:Name="LoadingTitle" Text="SysDeck" Foreground="White" FontSize="72" FontWeight="Light"
                                   HorizontalAlignment="Center" TextAlignment="Center"/>
                        <Grid x:Name="LoadingSpinnerHost" Margin="0,40,0,0" HorizontalAlignment="Center">
                            <Ellipse x:Name="LoadingSpinner" Width="60" Height="60" StrokeThickness="6" Stroke="#FF5B8DEF"
                                     StrokeDashArray="7,4" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform><RotateTransform x:Name="SpinnerRotate"/></Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <TextBlock x:Name="LoadingText" Foreground="#FF9AA3B5" FontSize="30" Margin="0,30,0,0"
                                   HorizontalAlignment="Center" TextAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Viewbox>
        </Grid>

        <!-- Animation de lancement (au-dessus de tout) -->
        <Grid x:Name="IntroLayer" Visibility="Collapsed" Background="Transparent" Cursor="None"/>
    </Grid>
</Window>
