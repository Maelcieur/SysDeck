                                                        <Slider x:Name="DeckNightBrightnessSlider" Minimum="1" Maximum="30" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="DeckSlider_Changed"/>
                                                    </DockPanel>
                                                </controls:SettingRow>
                                            </StackPanel>
                                        </Border>
