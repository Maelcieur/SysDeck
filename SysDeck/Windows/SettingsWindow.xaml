                                                </controls:SettingRow>
                                            </StackPanel>
                                        </Border>

                                        <ContentControl Style="{StaticResource SectionHeader}" Content="Veille (PC éteint)"/>
                                        <Border Style="{StaticResource RowCard}" Padding="14,0" local:SettingsSearch.Keywords="horloge nuit veille éteint luminosité minimale heure">
