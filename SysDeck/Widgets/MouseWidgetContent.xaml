<UserControl x:Class="SysDeck.Widgets.MouseWidgetContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SysDeck.Controls"
             Width="165" Height="68">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Width="66" Height="66" VerticalAlignment="Center" controls:Movable.Key="ring">
            <controls:RadialGauge x:Name="BatteryGauge" Thickness="5"/>
            <TextBlock controls:TextPart.Key="battery" Style="{StaticResource GaugeValueText}" VerticalAlignment="Center">
                <Run x:Name="BatteryValueRun" Text="--" FontSize="16"/><Run Text="%" FontSize="9" Foreground="{DynamicResource SubTextBrush}"/>
            </TextBlock>
        </Grid>

        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
            <StackPanel controls:Movable.Key="title" Orientation="Horizontal">
                <TextBlock controls:TextPart.Key="title" x:Name="MouseNameText" Text="SOURIS" Style="{StaticResource WidgetCaption}"/>
            </StackPanel>
            <StackPanel controls:Movable.Key="status" Orientation="Horizontal" Margin="0,6,0,0">
                <!-- Éclair "en charge" -->
                <Path x:Name="MouseChargingBolt" Data="M13,2 L4,14 L11,14 L10,22 L20,10 L13,10 Z"
                      Fill="{DynamicResource GaugeGradientBrush}" Width="9" Height="12" Stretch="Uniform"
                      Margin="0,0,5,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                <TextBlock controls:TextPart.Key="status" x:Name="MouseChargingText" Text="" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="MouseLowText" Text="Batterie faible" FontSize="10" Foreground="#FF5A5A"
                       Margin="0,3,0,0" Visibility="Collapsed"/>
        </StackPanel>
    </Grid>
</UserControl>
