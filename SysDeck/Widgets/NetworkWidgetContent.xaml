<UserControl x:Class="SysDeck.Widgets.NetworkWidgetContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SysDeck.Controls"
             Width="165" Height="68">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel controls:Movable.Key="title" Orientation="Horizontal">
            <TextBlock controls:TextPart.Key="title" Text="RÉSEAU" Style="{StaticResource WidgetCaption}"/>
        </StackPanel>

        <!-- Débits : réception (couleur de début du dégradé), envoi (couleur de fin) -->
        <Grid controls:Movable.Key="rates" Grid.Row="1" Margin="0,3,0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Path Width="8" Height="9" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"
                      Data="M6,1 L6,9 M2,6 L6,10 L10,6" StrokeThickness="1.8"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
                    <Path.Stroke>
                        <SolidColorBrush Color="{DynamicResource GaugeStartColor}"/>
                    </Path.Stroke>
                </Path>
                <TextBlock controls:TextPart.Key="download" x:Name="DownloadText" Text="--" Style="{StaticResource NumberText}" FontSize="11.5"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Path Width="8" Height="9" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"
                      Data="M6,9 L6,1 M2,5 L6,1 L10,5" StrokeThickness="1.8"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
                    <Path.Stroke>
                        <SolidColorBrush Color="{DynamicResource GaugeEndColor}"/>
                    </Path.Stroke>
                </Path>
                <TextBlock controls:TextPart.Key="upload" x:Name="UploadText" Text="--" Style="{StaticResource NumberText}" FontSize="11.5"/>
            </StackPanel>
        </Grid>

        <!-- Historique des débits ; échelle minimale de 100 Ko/s -->
        <controls:Sparkline controls:Movable.Key="graph" x:Name="History" Grid.Row="2" MinimumScale="102400"/>
    </Grid>
</UserControl>
