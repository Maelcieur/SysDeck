<Application x:Class="SysDeck.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SysDeck"
             xmlns:controls="clr-namespace:SysDeck.Controls"
             xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Application.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="BgBrush" Color="#1B1D22"/>
            <SolidColorBrush x:Key="PanelBrush" Color="#E0232530"/>
            <SolidColorBrush x:Key="AccentBrush" Color="#7C5CFF"/>
            <SolidColorBrush x:Key="AccentBrush2" Color="#7C5CFF"/>
            <SolidColorBrush x:Key="TextBrush" Color="#E8E9EE"/>
            <SolidColorBrush x:Key="SubTextBrush" Color="#9A9DAC"/>
            <SolidColorBrush x:Key="BorderBrush2" Color="#33FFFFFF"/>
            <SolidColorBrush x:Key="DockPanelBrush" Color="#E0232530"/>
            <SolidColorBrush x:Key="DockBorderBrush" Color="#40FFFFFF"/>
            <SolidColorBrush x:Key="ButtonBrush" Color="#22FFFFFF"/>
            <SolidColorBrush x:Key="TileBrush" Color="#14FFFFFF"/>
            <SolidColorBrush x:Key="TileStrongBrush" Color="#22FFFFFF"/>
            <SolidColorBrush x:Key="TileBorderBrush" Color="#0FFFFFFF"/>

            <!-- Thème : valeurs par défaut, remplacées au démarrage par ThemeService.ApplyTheme (thème global),
                 et éventuellement redéfinies dans les ressources d'une fenêtre de widget (style propre au module). -->
            <Color x:Key="GaugeStartColor">#00E0FF</Color>
            <Color x:Key="GaugeEndColor">#8B5CFF</Color>
            <LinearGradientBrush x:Key="GaugeGradientBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#00E0FF" Offset="0"/>
                <GradientStop Color="#8B5CFF" Offset="1"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="GaugeGradientVerticalBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#8B5CFF" Offset="0"/>
                <GradientStop Color="#00E0FF" Offset="1"/>
            </LinearGradientBrush>

            <!-- Chiffres : Bahnschrift (police DIN fournie avec Windows 10/11), allure tableau de bord. -->
            <FontFamily x:Key="NumberFont">Bahnschrift SemiBold, Bahnschrift, Segoe UI</FontFamily>
            <FontFamily x:Key="TextFont">Segoe UI</FontFamily>
            <CornerRadius x:Key="CardCornerRadius">18</CornerRadius>
            <!-- Épaisseur du contour des cartes ; remplacée par le thème (ThemeService.ApplyTheme). -->
            <Thickness x:Key="CardBorderThickness">1</Thickness>
            <sys:Double x:Key="GaugeSweepAngle">270</sys:Double>
            <sys:Double x:Key="GaugeThicknessScale">1</sys:Double>
            <sys:String x:Key="GaugeDesign">Smooth</sys:String>
            <sys:String x:Key="GaugeTickDesign">Lines</sys:String>
            <sys:Boolean x:Key="GaugeTicks">True</sys:Boolean>
            <sys:Boolean x:Key="GaugeGlow">True</sys:Boolean>
            <sys:Double x:Key="AnimationScale">1</sys:Double>
            <sys:String x:Key="AnimationEasing">Smooth</sys:String>
            <sys:Boolean x:Key="IntroAnimation">True</sys:Boolean>

            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            </Style>

            <Style x:Key="SubText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
                <Setter Property="FontSize" Value="11"/>
            </Style>

            <Style TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource ButtonBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="10,5"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="controls:RadialGauge">
                <Setter Property="StartColor" Value="{DynamicResource GaugeStartColor}"/>
                <Setter Property="EndColor" Value="{DynamicResource GaugeEndColor}"/>
                <Setter Property="SweepAngle" Value="{DynamicResource GaugeSweepAngle}"/>
                <Setter Property="ThicknessScale" Value="{DynamicResource GaugeThicknessScale}"/>
                <Setter Property="Design" Value="{DynamicResource GaugeDesign}"/>
                <Setter Property="TickDesign" Value="{DynamicResource GaugeTickDesign}"/>
                <Setter Property="TicksEnabled" Value="{DynamicResource GaugeTicks}"/>
                <Setter Property="GlowEnabled" Value="{DynamicResource GaugeGlow}"/>
                <Setter Property="AnimationScale" Value="{DynamicResource AnimationScale}"/>
                <Setter Property="Easing" Value="{DynamicResource AnimationEasing}"/>
                <Setter Property="IntroAnimation" Value="{DynamicResource IntroAnimation}"/>
            </Style>

            <Style TargetType="controls:VolumeControl">
                <Setter Property="StartColor" Value="{DynamicResource GaugeStartColor}"/>
                <Setter Property="EndColor" Value="{DynamicResource GaugeEndColor}"/>
            </Style>

            <Style TargetType="controls:LinearGauge">
                <Setter Property="Design" Value="{DynamicResource GaugeDesign}"/>
                <Setter Property="StartColor" Value="{DynamicResource GaugeStartColor}"/>
                <Setter Property="EndColor" Value="{DynamicResource GaugeEndColor}"/>
                <Setter Property="GlowEnabled" Value="{DynamicResource GaugeGlow}"/>
                <Setter Property="AnimationScale" Value="{DynamicResource AnimationScale}"/>
            </Style>

            <Style TargetType="controls:SpectrumVisualizer">
                <Setter Property="StartColor" Value="{DynamicResource GaugeStartColor}"/>
                <Setter Property="EndColor" Value="{DynamicResource GaugeEndColor}"/>
                <Setter Property="GlowEnabled" Value="{DynamicResource GaugeGlow}"/>
            </Style>

            <Style TargetType="controls:Sparkline">
                <Setter Property="StartColor" Value="{DynamicResource GaugeStartColor}"/>
                <Setter Property="EndColor" Value="{DynamicResource GaugeEndColor}"/>
            </Style>

            <!-- En-tête de widget : titre en petites capitales. -->

            <Style x:Key="WidgetCaption" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
                <Setter Property="FontSize" Value="10.5"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>

            <!-- Chiffres : la police vient du style (et non d'un attribut local) pour qu'une police propre
                 à un texte puisse être retirée et retrouver celle du thème. -->
            <Style x:Key="NumberText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource NumberFont}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            </Style>

            <Style x:Key="GaugeValueText" TargetType="TextBlock" BasedOn="{StaticResource NumberText}">
                <Setter Property="HorizontalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="GaugeLabelText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
                <Setter Property="FontSize" Value="8.5"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
            </Style>

            <!-- Petite tuile de statistique (fond légèrement éclairci). -->
            <Style x:Key="StatTile" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource TileBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource TileBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="9"/>
                <Setter Property="Padding" Value="8,5"/>
            </Style>

            <Style TargetType="ScrollViewer">
                <Setter Property="Background" Value="Transparent"/>
            </Style>

            <!-- Pas d'Effect (DropShadowEffect, etc.) ici : combiné à AllowsTransparency="True" sur une
                 fenêtre sans bordure, WPF peint les coins hors du Border arrondi en noir opaque au lieu
                 de transparent. La bordure suffit à détacher visuellement le widget du bureau. -->
            <Style x:Key="CardChromeStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
                <Setter Property="BorderThickness" Value="{DynamicResource CardBorderThickness}"/>
                <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}"/>
            </Style>

            <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Width" Value="20"/>
                <Setter Property="Height" Value="20"/>
                <Setter Property="FontSize" Value="10"/>
            </Style>

            <!-- Menus contextuels sombres, partout dans l'application. -->
            <Style TargetType="ContextMenu">
                <Setter Property="Background" Value="#202126"/>
                <Setter Property="BorderBrush" Value="#383A42"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="4"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContextMenu">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"
                                    Padding="{TemplateBinding Padding}">
                                <StackPanel IsItemsHost="True"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="MenuItem">
                <Setter Property="Foreground" Value="#E7E8EB"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuItem">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="#6A6D77"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="Separator">
                <Setter Property="Background" Value="#2C2E34"/>
                <Setter Property="Height" Value="1"/>
                <Setter Property="Margin" Value="6,4"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
