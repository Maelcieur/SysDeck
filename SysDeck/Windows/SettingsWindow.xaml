<Window x:Class="SysDeck.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SysDeck.Controls"
        xmlns:local="clr-namespace:SysDeck"
        PreviewKeyDown="Window_PreviewKeyDown"
        Title="SysDeck — Paramètres"
        Width="1220" Height="780" MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Foreground="{DynamicResource UiText}"
        Background="{DynamicResource UiWindowBg}">
    <!-- Barre de titre personnalisée ; WindowChrome garde le redimensionnement et l'ancrage Windows. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/SettingsStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <local:UpperCaseConverter x:Key="Upper"/>

            <Style x:Key="CaptionButton" TargetType="Button">
                <Setter Property="Width" Value="46"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource UiHoverStrong}"/>
                                    <Setter Property="Foreground" Value="{StaticResource UiText}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PreviewPartButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="8"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Frame" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Frame" Property="Background" Value="{StaticResource UiHoverStrong}"/>
                                    <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource CardBorder}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource UiAccent}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PreviewHotspot" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Frame" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Frame" Property="Background" Value="{StaticResource UiHoverStrong}"/>
                                    <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource UiAccent}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PageScroller" TargetType="ScrollViewer">
                <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
                <Setter Property="Padding" Value="32,0,26,28"/>
            </Style>

            <!-- Titre de page 20 SemiBold et sous-titre gris (remplace les valeurs par défaut de SettingsStyles pour cette fenêtre). -->
            <Style x:Key="PageTitle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource UiText}"/>
            </Style>

            <Style x:Key="PageSubtitle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="0,4,0,4"/>
            </Style>

            <!-- Titre de section : petites capitales grises au-dessus d'une carte (le texte est saisi en casse normale). -->
            <Style x:Key="SectionHeader" TargetType="ContentControl">
                <Setter Property="Margin" Value="2,22,0,8"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="IsTabStop" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContentControl">
                            <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Upper}}"
                                       FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Carte de lignes de réglage : pas de marge intérieure horizontale, les lignes portent leur propre espacement. -->
            <Style x:Key="RowCard" TargetType="Border" BasedOn="{StaticResource Card}">
                <Setter Property="Padding" Value="20,0"/>
            </Style>

            <!-- Pile de lignes : -1 en bas pour que le trait de la dernière ligne se confonde avec le contour de la carte. -->
            <Style x:Key="RowsPanel" TargetType="StackPanel">
                <Setter Property="Margin" Value="0,0,0,-1"/>
            </Style>

            <!-- Bloc libre dans une carte de lignes (liste, texte d'état...) avec son trait de séparation. -->
            <Style x:Key="RowBorder" TargetType="Border">
                <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="Padding" Value="0,12"/>
            </Style>

            <!-- Ligne de réglage : libellé + description à gauche, contrôle à droite. -->
            <Style TargetType="controls:SettingRow">
                <Setter Property="IsTabStop" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="controls:SettingRow">
                            <Border BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1" Padding="0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel x:Name="Texts" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Name="LabelText" Text="{TemplateBinding Label}" Foreground="{StaticResource UiText}"
                                                   FontSize="13" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="DescText" Text="{TemplateBinding Description}" Foreground="{StaticResource Muted}"
                                                   FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ContentPresenter x:Name="Body" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Label" Value="{x:Null}">
                                    <Setter TargetName="LabelText" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="DescText" Property="Margin" Value="0"/>
                                </Trigger>
                                <Trigger Property="Description" Value="{x:Null}">
                                    <Setter TargetName="DescText" Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                                <Trigger Property="Stacked" Value="True">
                                    <Setter TargetName="Body" Property="Grid.Row" Value="1"/>
                                    <Setter TargetName="Body" Property="Grid.Column" Value="0"/>
                                    <Setter TargetName="Body" Property="Grid.ColumnSpan" Value="2"/>
                                    <Setter TargetName="Body" Property="HorizontalAlignment" Value="Stretch"/>
                                    <Setter TargetName="Body" Property="Margin" Value="0,10,0,0"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Texts" Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Largeur et hauteur : seulement en taille manuelle. -->
            <Style x:Key="ManualOnlyRow" TargetType="controls:SettingRow" BasedOn="{StaticResource {x:Type controls:SettingRow}}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding AutoSize}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Lien texte (accent, sans cadre). -->
            <Style x:Key="LinkButton" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource UiAccent}"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="Padding" Value="8,3"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{StaticResource UiFocusVisual}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource UiAccentSoft}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Bouton discret du bas de menu (Quitter) : pas de cadre, texte secondaire. -->
            <Style x:Key="QuietButton" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{StaticResource UiFocusVisual}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Height="34" CornerRadius="6" Background="Transparent" Padding="14,0">
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource UiHover}"/>
                                    <Setter Property="Foreground" Value="{StaticResource UiText}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Fenêtre agrandie : WindowChrome déborde de l'écran de l'épaisseur du cadre, on compense. -->
    <Border x:Name="Root">
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="Margin" Value="7"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavColumn" Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Barre latérale : recherche, menu groupé par thème, verrouillage et sortie en bas ; masquable (☰ ou Ctrl+B) -->
            <Border x:Name="Sidebar" Background="{StaticResource SidebarBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,1,0">
                <DockPanel Margin="18,20,18,14">
                    <!-- Nom et version -->
                    <StackPanel DockPanel.Dock="Top" Margin="6,0,0,18">
                        <TextBlock Text="SysDeck" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource UiText}"/>
                        <TextBlock x:Name="VersionText" FontSize="11" Foreground="{StaticResource Muted}"/>
                    </StackPanel>

                    <!-- Bas de barre : verrouillage et sortie -->
                    <StackPanel DockPanel.Dock="Bottom">
                        <Border Style="{StaticResource NavDivider}"/>
                        <CheckBox x:Name="LockWidgetsCheck" Style="{StaticResource ToggleSwitch}" Margin="14,6,14,6"
                                  Checked="LockWidgets_Changed" Unchecked="LockWidgets_Changed">
                            <StackPanel>
                                <TextBlock Text="Verrouiller"/>
                                <TextBlock Text="Empêche le déplacement" FontSize="11" Foreground="{StaticResource Muted}"/>
                            </StackPanel>
                        </CheckBox>
                        <Button Style="{StaticResource QuietButton}" Click="Quit_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7E8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Quitter SysDeck" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Recherche : le panneau de résultats remplace le menu tant qu'on tape -->
                    <Border DockPanel.Dock="Top" Margin="0,0,0,8" Height="36" CornerRadius="8"
                            Background="{StaticResource InputBg}" BorderBrush="{StaticResource InputBorder}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource Muted}"
                                       VerticalAlignment="Center" Margin="12,0,0,0"/>
                            <TextBox x:Name="SearchInput" Grid.Column="1" Background="Transparent" BorderThickness="0" Height="34" Padding="8,0,4,0"
                                     TextChanged="SearchInput_TextChanged" KeyDown="SearchInput_KeyDown" ToolTip="Rechercher un réglage (Ctrl+F)"/>
                            <TextBlock Grid.Column="1" Text="Rechercher un réglage…" Foreground="{StaticResource Muted}" FontSize="12.5"
                                       IsHitTestVisible="False" VerticalAlignment="Center" Margin="12,0,0,0"
                                       Visibility="{Binding Text, ElementName=SearchInput, Converter={StaticResource EmptyToVis}}"/>
                            <Button x:Name="SearchClearButton" Grid.Column="2" Style="{StaticResource RowIconButton}" Content="&#xE711;"
                                    Margin="0,0,4,0" Visibility="Collapsed" Click="SearchClear_Click" ToolTip="Effacer la recherche (Échap)"/>
                        </Grid>
                    </Border>

                    <Grid>
                        <ScrollViewer x:Name="NavScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="NavPanel">
                                <TextBlock Text="MODULES" Style="{StaticResource NavSection}" Margin="14,2,0,6"/>
                                <RadioButton Style="{StaticResource NavButton}" Tag="&#xE71D;" Content="Modules" x:Name="NavModules" GroupName="SettingsNav" Checked="Nav_Checked" Click="NavModules_Click" IsChecked="True"/>
                                <RadioButton Style="{StaticResource NavButton}" Tag="&#xE718;" Content="Barre de raccourcis" x:Name="NavDock" GroupName="SettingsNav" Checked="Nav_Checked"/>
                                <TextBlock Text="APPARENCE" Style="{StaticResource NavSection}"/>
                                <RadioButton Style="{StaticResource NavButton}" Tag="&#xE790;" Content="Thème" x:Name="NavTheme" GroupName="SettingsNav" Checked="Nav_Checked"/>
                                <RadioButton Style="{StaticResource NavButton}" Tag="&#xE77B;" Content="Profils" x:Name="NavProfiles" GroupName="SettingsNav" Checked="Nav_Checked"/>
                                <TextBlock Text="APPAREILS" Style="{StaticResource NavSection}"/>
                                <RadioButton Style="{StaticResource NavButton}" Tag="&#xE7FC;" Content="Switch" x:Name="NavSwitch" GroupName="SettingsNav" Checked="Nav_Checked"/>
                                <RadioButton Style="{StaticResource NavButton}" Tag="&#xE7F4;" Content="Mode console" x:Name="NavConsole" GroupName="SettingsNav" Checked="Nav_Checked"/>
                                <TextBlock Text="APPLICATIONS" Style="{StaticResource NavSection}"/>
                                <RadioButton Style="{StaticResource NavButton}" Tag="&#xE71B;" Content="Applications connectées" x:Name="NavIntegrations" GroupName="SettingsNav" Checked="Nav_Checked"/>
                                <RadioButton Style="{StaticResource NavButton}" Tag="&#xEA86;" Content="Plugins" x:Name="NavPlugins" GroupName="SettingsNav" Checked="Nav_Checked"/>
                                <TextBlock Text="NOTIFICATIONS" Style="{StaticResource NavSection}"/>
                                <RadioButton Style="{StaticResource NavButton}" Tag="&#xEA8F;" Content="Alertes" x:Name="NavAlerts" GroupName="SettingsNav" Checked="Nav_Checked"/>
                                <TextBlock Text="OUTILS" Style="{StaticResource NavSection}"/>
                                <RadioButton Style="{StaticResource NavButton}" Tag="&#xE70F;" Content="Correction de texte" x:Name="NavCorrection" GroupName="SettingsNav" Checked="Nav_Checked"/>
                                <RadioButton Style="{StaticResource NavButton}" Tag="&#xE76E;" Content="Émojis" x:Name="NavEmoji" GroupName="SettingsNav" Checked="Nav_Checked"/>
                                <TextBlock Text="SYSTÈME" Style="{StaticResource NavSection}"/>
                                <RadioButton Style="{StaticResource NavButton}" Tag="&#xE713;" Content="Général" x:Name="NavGeneral" GroupName="SettingsNav" Checked="Nav_Checked"/>
                                <RadioButton Style="{StaticResource NavButton}" Tag="&#xE945;" Content="Énergie" x:Name="NavEnergy" GroupName="SettingsNav" Checked="Nav_Checked"/>
                            </StackPanel>
                        </ScrollViewer>

                        <ScrollViewer x:Name="SearchResultsScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <ItemsControl x:Name="SearchResultsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource SearchResultButton}" Click="SearchResult_Click">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource UiText}" FontWeight="SemiBold" FontSize="12.5" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Path}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="SearchEmptyText" Text="Aucun réglage trouvé." Foreground="{StaticResource Muted}" FontSize="12"
                                           Margin="12,8,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Contenu -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Afficher / masquer le menu de gauche, et nom de la page quand il est masqué -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,8,0,0">
                    <Button x:Name="NavToggleButton" Style="{StaticResource CaptionButton}" Click="NavToggle_Click" ToolTip="Masquer le menu (Ctrl+B)">
                        <TextBlock Text="&#xE700;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <TextBlock x:Name="CollapsedTitle" Text="SysDeck" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Muted}"
                               VerticalAlignment="Center" Margin="8,0,0,0" Visibility="Collapsed"/>
                </StackPanel>

                <!-- Boutons de fenêtre -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,10,0">
                    <Button Style="{StaticResource CaptionButton}" Click="Minimize_Click" ToolTip="Réduire">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <Button Style="{StaticResource CaptionButton}" Click="Maximize_Click" ToolTip="Agrandir">
                        <TextBlock Text="&#xE922;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <Button Style="{StaticResource CaptionButton}" Click="Close_Click" ToolTip="Fermer">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                </StackPanel>

                <!-- ===== Page : Modules (liste) ===== -->
                <ScrollViewer x:Name="PageModules" Grid.Row="1" Style="{StaticResource PageScroller}">
                    <StackPanel>
                        <TextBlock Text="Modules" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Choisis les modules affichés sur le bureau. « Personnaliser » ouvre les réglages d'apparence propres à chaque module."
                                   Style="{StaticResource PageSubtitle}"/>

                        <Border Style="{StaticResource RowCard}" Margin="0,16,0,12">
                            <ItemsControl x:Name="WidgetsList" Margin="0,0,0,-1">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource RowBorder}" Padding="0,9">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                                           Foreground="{StaticResource Muted}" Width="24" TextAlignment="Center" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="13.5" Foreground="{StaticResource UiText}" VerticalAlignment="Center"/>
                                                <Button Grid.Column="2" Style="{StaticResource LinkButton}" Content="Personnaliser" Tag="{Binding Id}"
                                                        Click="CustomizeModule_Click" Margin="0,0,14,0" VerticalAlignment="Center"
                                                        Visibility="{Binding CanCustomize, Converter={StaticResource BoolToVis}}"/>
                                                <CheckBox Grid.Column="3" Style="{StaticResource ToggleSwitch}" Margin="0" VerticalAlignment="Center"
                                                          IsChecked="{Binding IsVisible, Mode=OneTime}" Tag="{Binding Id}"
                                                          Checked="WidgetCheck_Changed" Unchecked="WidgetCheck_Changed"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== Page : Thème (sous-onglets : un éditeur par groupe de réglages) ===== -->
                <ScrollViewer x:Name="PageTheme" Grid.Row="1" Style="{StaticResource PageScroller}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Thème" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Appliqué à tous les modules qui n'ont pas leur propre style. Les changements s'affichent en direct sur le bureau."
                                   Style="{StaticResource PageSubtitle}" Margin="0,4,0,14"/>
                        <WrapPanel>
                            <RadioButton x:Name="GlobalTabColorsButton" Style="{StaticResource TabButton}" GroupName="GlobalThemeTabs" Content="Couleurs et polices"
                                         IsChecked="True" Checked="GlobalThemeTab_Checked"/>
                            <RadioButton x:Name="GlobalTabCardButton" Style="{StaticResource TabButton}" GroupName="GlobalThemeTabs" Content="Carte"
                                         Checked="GlobalThemeTab_Checked"/>
                            <RadioButton x:Name="GlobalTabGaugesButton" Style="{StaticResource TabButton}" GroupName="GlobalThemeTabs" Content="Jauges"
                                         Checked="GlobalThemeTab_Checked"/>
                            <RadioButton x:Name="GlobalTabAnimationsButton" Style="{StaticResource TabButton}" GroupName="GlobalThemeTabs" Content="Animations"
                                         Checked="GlobalThemeTab_Checked"/>
                        </WrapPanel>
                        <Border Height="1" Background="{StaticResource CardBorder}" Margin="0,0,0,16"/>
                        <controls:ThemeEditor x:Name="GlobalThemeEditor" Section="ColorsFonts"/>
                        <controls:ThemeEditor x:Name="GlobalCardEditor" Section="Card" Visibility="Collapsed"/>
                        <controls:ThemeEditor x:Name="GlobalGaugesEditor" Section="Gauges" Visibility="Collapsed"/>
                        <controls:ThemeEditor x:Name="GlobalAnimationsEditor" Section="Animations" Visibility="Collapsed"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== Page : Profils ===== -->
                <ScrollViewer x:Name="PageProfiles" Grid.Row="1" Style="{StaticResource PageScroller}" Visibility="Collapsed">
                    <StackPanel x:Name="ProfilesContent">
                        <StackPanel.Resources>
                            <!-- Tuile de la galerie de thèmes : cadre qui s'éclaire au survol et au clavier -->
                            <Style x:Key="PresetTile" TargetType="Button">
                                <Setter Property="Width" Value="190"/>
                                <Setter Property="Margin" Value="0,0,12,12"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Frame" CornerRadius="8" Background="{StaticResource UiHover}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                                                    ClipToBounds="True">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource UiAccent}"/>
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource UiAccent}"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Frame" Property="Opacity" Value="0.8"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </StackPanel.Resources>

                        <TextBlock Text="Profils" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Change d'ambiance en un clic avec un thème prêt à l'emploi, ou enregistre ta configuration pour la retrouver plus tard."
                                   Style="{StaticResource PageSubtitle}"/>

                        <!-- Thèmes prêts à l'emploi -->
                        <ContentControl Style="{StaticResource SectionHeader}" Content="Thèmes prêts à l'emploi"/>
                        <Border Style="{StaticResource RowCard}" local:SettingsSearch.Keywords="thème préréglage palette ambiance couleurs style prêt galerie néon clair sombre">
                            <StackPanel Style="{StaticResource RowsPanel}">
                                <controls:SettingRow Description="Un clic remplace le thème global (couleurs, polices, carte, jauges, animations). La disposition des modules ne change pas."/>
                                <Border Style="{StaticResource RowBorder}" Padding="0,14,0,2">
                                    <WrapPanel x:Name="PresetGallery"/>
                                </Border>
                                <controls:SettingRow Label="Appliquer aussi aux modules qui ont leur propre style">
                                    <CheckBox x:Name="PresetResetModulesCheck" Style="{StaticResource ToggleSwitch}" Margin="0"/>
                                </controls:SettingRow>
                                <controls:SettingRow Label="Colonnes de tuiles" Stacked="True"
                                                     Description="Automatique adapte le nombre de colonnes à la largeur du bloc.">
                                    <ComboBox x:Name="DeckAppsColumnsBox" SelectionChanged="DeckAppsColumns_Changed">
                                        <ComboBoxItem Content="Automatique"/>
                                        <ComboBoxItem Content="2 colonnes"/>
                                        <ComboBoxItem Content="3 colonnes"/>
                                        <ComboBoxItem Content="4 colonnes"/>
                                        <ComboBoxItem Content="5 colonnes"/>
                                        <ComboBoxItem Content="6 colonnes"/>
                                        <ComboBoxItem Content="7 colonnes"/>
                                        <ComboBoxItem Content="8 colonnes"/>
                                    </ComboBox>
                                </controls:SettingRow>
                                <Border x:Name="PresetUndoBar" Visibility="Collapsed" Margin="0,0,0,12" Padding="14,8" CornerRadius="6"
                                        Background="{StaticResource UiHoverStrong}" local:SettingsSearch.Ignore="True">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Annuler" Click="PresetUndo_Click" Margin="12,0,0,0"/>
                                        <TextBlock x:Name="PresetUndoText" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource UiText}"/>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Mes profils -->
                        <ContentControl Style="{StaticResource SectionHeader}" Content="Mes profils"/>
                        <Border Style="{StaticResource RowCard}" local:SettingsSearch.Keywords="profil enregistrer sauvegarder configuration importer exporter partager renommer supprimer appliquer disposition fichier">
                            <StackPanel Style="{StaticResource RowsPanel}">
                                <controls:SettingRow Description="Un profil garde tout le style : thème, apparence des modules (bureau et Switch), barre de raccourcis, émojis et fond de la Switch."/>
                                <controls:SettingRow Label="Nom du profil" Stacked="True">
                                    <DockPanel>
                                        <Button x:Name="ProfileSaveButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"
                                                Content="Enregistrer la configuration actuelle" Click="ProfileSave_Click"/>
                                        <TextBox x:Name="ProfileNameBox" MaxLength="80" VerticalContentAlignment="Center" KeyDown="ProfileNameBox_KeyDown"
                                                 TextChanged="ProfileNameBox_TextChanged"/>
                                    </DockPanel>
                                </controls:SettingRow>

                                <Border x:Name="ProfileOverwriteBar" Visibility="Collapsed" Margin="0,12,0,0" Padding="14,8" CornerRadius="6"
                                        Background="{StaticResource UiHoverStrong}" local:SettingsSearch.Ignore="True">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                                            <Button Content="Remplacer" Style="{StaticResource DangerButton}" Click="ProfileOverwriteConfirm_Click"/>
                                            <Button Content="Annuler" Margin="6,0,0,0" Click="ProfileOverwriteCancel_Click"/>
                                        </StackPanel>
                                        <TextBlock x:Name="ProfileOverwriteText" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource UiText}"/>
                                    </DockPanel>
                                </Border>

                                <controls:SettingRow Label="Appliquer aussi la disposition" Description="Modules affichés et positions.">
                                    <CheckBox x:Name="ProfileLayoutCheck" Style="{StaticResource ToggleSwitch}" Margin="0"/>
                                </controls:SettingRow>

                                <TextBlock x:Name="ProfilesStatus" Visibility="Collapsed" Foreground="{StaticResource UiSuccess}" TextWrapping="Wrap" Margin="0,10,0,4"
                                           local:SettingsSearch.Ignore="True"/>
                                <TextBlock x:Name="ProfilesError" Visibility="Collapsed" Foreground="{StaticResource UiDanger}" TextWrapping="Wrap" Margin="0,10,0,4"
                                           local:SettingsSearch.Ignore="True"/>

                                <StackPanel x:Name="ProfilesListPanel" local:SettingsSearch.Ignore="True"/>
                                <Border Style="{StaticResource RowBorder}" local:SettingsSearch.Ignore="True">
                                    <TextBlock x:Name="ProfilesEmptyText" Text="Aucun profil enregistré pour l'instant." Foreground="{StaticResource Muted}"
                                               FontStyle="Italic"/>
                                </Border>

                                <controls:SettingRow Label="Importer un profil" Description="Ajoute un fichier .sysdeckprofile à la liste (il n'est pas appliqué tout de suite).">
                                    <Button Content="Importer…" Click="ProfileImport_Click"/>
                                </controls:SettingRow>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== Page : Personnaliser un module (ouverte depuis Modules ; « Modules » reste surligné dans le menu) ===== -->
                <!-- Aperçu interactif en haut ; réglages généraux à gauche et réglages de la sélection à droite. -->
                <Grid x:Name="PageCustomize" Grid.Row="1" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Margin="24,0,26,0">
                        <!-- Fil d'Ariane et choix du module -->
                        <DockPanel Margin="0,0,0,12">
                            <ComboBox x:Name="ModuleSelector" DockPanel.Dock="Right" Width="200" DisplayMemberPath="Label"
                                      VerticalAlignment="Center" SelectionChanged="ModuleSelector_SelectionChanged"
                                      ToolTip="Changer de module"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource LinkButton}" Content="Modules" FontSize="20" FontWeight="SemiBold"
                                        Foreground="{StaticResource Muted}" Padding="0,2" Click="CustomizeBack_Click"
                                        ToolTip="Revenir à la liste des modules"/>
                                <TextBlock Text="›" FontSize="20" Foreground="{StaticResource Muted}" Margin="10,0,10,2" VerticalAlignment="Center"/>
                                <TextBlock x:Name="BreadcrumbModuleText" Style="{StaticResource PageTitle}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DockPanel>
                        <!-- Cible : apparence du module sur le bureau ou sur la Switch (réglages indépendants). -->
                        <WrapPanel Margin="0,0,0,14">
                            <TextBlock Text="Apparence pour :" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,6"/>
                            <RadioButton x:Name="TargetDesktop" Style="{StaticResource Chip}" Content="Bureau" GroupName="CustomizeTarget"
                                         IsChecked="True" Checked="CustomizeTarget_Changed"/>
                            <RadioButton x:Name="TargetSwitch" Style="{StaticResource Chip}" Content="Switch" GroupName="CustomizeTarget"
                                         Checked="CustomizeTarget_Changed"/>
                            <Button x:Name="CopyFromDesktopButton" Content="Reprendre l'apparence du bureau" Margin="6,0,0,6" VerticalAlignment="Center"
                                    Visibility="Collapsed" Click="CopyFromDesktop_Click"
                                    ToolTip="Remplace l'apparence Switch de ce module par celle du bureau"/>
                        </WrapPanel>
                        <WrapPanel Visibility="Collapsed">
                            <RadioButton x:Name="TabSizeButton" Style="{StaticResource TabButton}" GroupName="CustomizeTabs" Content="Taille"
                                         IsChecked="True" Checked="CustomizeTab_Checked"/>
                            <RadioButton x:Name="TabElementsButton" Style="{StaticResource TabButton}" GroupName="CustomizeTabs" Content="Éléments"
                                         Checked="CustomizeTab_Checked"/>
                            <RadioButton x:Name="TabTextsButton" Style="{StaticResource TabButton}" GroupName="CustomizeTabs" Content="Textes"
                                         Checked="CustomizeTab_Checked"/>
                            <RadioButton x:Name="TabButtonsButton" Style="{StaticResource TabButton}" GroupName="CustomizeTabs" Content="Boutons"
                                         Visibility="Collapsed" Checked="CustomizeTab_Checked"/>
                            <RadioButton x:Name="TabStyleButton" Style="{StaticResource TabButton}" GroupName="CustomizeTabs" Content="Style"
                                         Checked="CustomizeTab_Checked"/>
                        </WrapPanel>
                        <Border Height="1" Background="{StaticResource CardBorder}" Margin="0,0,0,8"/>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="320"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid x:Name="CustomizePreviewArea" Grid.Row="0" Margin="24,0,26,10" Background="Transparent">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Button x:Name="PreviewWidgetOptionsButton" Grid.Row="0" Content="Options du widget"
                                    Style="{StaticResource LinkButton}" HorizontalAlignment="Right"
                                    Click="PreviewWidgetOptions_Click"/>
                            <Viewbox x:Name="PreviewWidgetViewbox" Grid.Row="1" Stretch="Uniform" Visibility="Collapsed">
                                <Grid x:Name="PreviewWidgetSurface">
                                    <Border x:Name="PreviewWidgetSnapshot"/>
                                    <Canvas x:Name="PreviewWidgetParts"/>
                                </Grid>
                            </Viewbox>
                            <TextBlock x:Name="PreviewWidgetEmptyText" Grid.Row="1"
                                       Text="Ce module n'est pas affiché sur cette cible. Affichez-le sur le bureau ou placez-le sur une page Switch pour obtenir son aperçu réel."
                                       Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                       Margin="14"/>
                        </Grid>

                        <Grid x:Name="ModuleEditor" Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ScrollViewer x:Name="CustomizeScroller" Grid.Column="0" Style="{StaticResource PageScroller}" Padding="24,0,12,24">
                                <StackPanel>
                                    <TextBlock Text="RÉGLAGES GÉNÉRAUX" FontSize="10.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource Muted}" Margin="0,2,0,10"/>
                                    <Expander x:Name="SizeExpander" Style="{StaticResource SectionExpander}" Header="Taille" Margin="0,0,0,8">
                                        <ContentControl x:Name="SizeExpanderHost"/>
                                    </Expander>
                                    <Expander x:Name="FitExpander" Style="{StaticResource SectionExpander}" Header="Adaptation du contenu" Margin="0,0,0,8">
                                        <ContentControl x:Name="FitExpanderHost"/>
                                    </Expander>
                                    <Expander x:Name="ElementsExpander" Style="{StaticResource SectionExpander}" Header="Éléments du module" Margin="0,0,0,8">
                                        <ContentControl x:Name="ElementsExpanderHost"/>
                                    </Expander>
                                    <Expander x:Name="TextsExpander" Style="{StaticResource SectionExpander}" Header="Textes du module" Margin="0,0,0,8">
                                        <ContentControl x:Name="TextsExpanderHost"/>
                                    </Expander>
                                    <Expander x:Name="ButtonsExpander" Style="{StaticResource SectionExpander}" Header="Boutons du module" Margin="0,0,0,8">
                                        <ContentControl x:Name="ButtonsExpanderHost"/>
                                    </Expander>
                                    <Expander x:Name="ColorsExpander" Style="{StaticResource SectionExpander}" Header="Couleurs et polices" Margin="0,0,0,8">
                                        <ContentControl x:Name="ColorsExpanderHost"/>
                                    </Expander>
                                    <Expander x:Name="OptionsExpander" Style="{StaticResource SectionExpander}" Header="Apparence et options du module" Margin="0,0,0,8">
                                        <ContentControl x:Name="OptionsExpanderHost"/>
                                    </Expander>
                                </StackPanel>
                            </ScrollViewer>
                            <ScrollViewer x:Name="SelectionScroller" Grid.Column="1" Style="{StaticResource PageScroller}" Padding="12,0,24,24">
                                <StackPanel x:Name="SelectedPartPanel">
                                    <TextBlock Text="RÉGLAGES DE L'ÉLÉMENT" FontSize="10.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource Muted}" Margin="0,2,0,10"/>
                                    <TextBlock x:Name="SelectedPartTitle" Style="{StaticResource PageTitle}" FontSize="16"
                                               Margin="0,0,0,10" Text="Sélectionnez un élément dans l'aperçu"/>
                                    <TextBlock x:Name="SelectedPartEmptyText"
                                               Text="Ses réglages apparaîtront ici. Pour modifier l'ensemble du widget, utilisez les sections générales à gauche."
                                               Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                    <ContentControl x:Name="SelectedElementListHost" Visibility="Collapsed"/>
                                    <ContentControl x:Name="SelectedTextListHost" Visibility="Collapsed"/>
                                    <ContentControl x:Name="SelectedButtonListHost" Visibility="Collapsed"/>
                                    <StackPanel x:Name="SelectedElementAdvancedHost"/>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- ===== Onglet Taille : taille, adaptation et réglages propres au module ===== -->
                            <StackPanel x:Name="TabSize" Visibility="Collapsed">
                                <!-- Taille (bureau seulement : sur la Switch, la taille se règle dans la page Switch) -->
                                <StackPanel x:Name="SizeCard">
                                    <ContentControl Style="{StaticResource SectionHeader}" Content="Taille" Margin="2,10,0,8"/>
                                    <Border Style="{StaticResource RowCard}" local:SettingsSearch.Keywords="largeur hauteur dimension taille automatique">
                                        <StackPanel Style="{StaticResource RowsPanel}">
                                            <controls:SettingRow Label="Taille automatique"
                                                                 Description="Désactive pour fixer la largeur et la hauteur : le contenu s'adapte à la carte.">
                                                <CheckBox Style="{StaticResource ToggleSwitch}" Margin="0" IsChecked="{Binding AutoSize}"/>
                                            </controls:SettingRow>
                                            <controls:SettingRow Style="{StaticResource ManualOnlyRow}" Label="Largeur">
                                                <DockPanel Width="260">
                                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}" Text="{Binding Width, StringFormat={}{0:0} px}"/>
                                                    <Slider Minimum="80" Maximum="900" Value="{Binding Width}" IsSnapToTickEnabled="True" TickFrequency="2"/>
                                                </DockPanel>
                                            </controls:SettingRow>
                                            <controls:SettingRow Style="{StaticResource ManualOnlyRow}" Label="Hauteur">
                                                <DockPanel Width="260">
                                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}" Text="{Binding Height, StringFormat={}{0:0} px}"/>
                                                    <Slider Minimum="50" Maximum="900" Value="{Binding Height}" IsSnapToTickEnabled="True" TickFrequency="2"/>
                                                </DockPanel>
                                            </controls:SettingRow>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Adaptation du contenu : une seule propriété (StretchMode) pour le bureau comme pour la Switch.
                                     Bureau : seulement en taille manuelle. Switch : toujours (la taille vient du cadre de la page Switch). -->
                                <StackPanel x:Name="FitCard">
                                    <ContentControl Style="{StaticResource SectionHeader}" Content="Adaptation du contenu" Margin="2,10,0,8"/>
                                    <Border Style="{StaticResource RowCard}" local:SettingsSearch.Keywords="adaptation cadre proportions étirer remplir taille réelle switch">
                                        <StackPanel Style="{StaticResource RowsPanel}">
                                            <controls:SettingRow x:Name="SwitchSizeNote" Visibility="Collapsed"
                                                                 Description="La taille du module se règle en redimensionnant son cadre dans la page Switch."/>
                                            <controls:SettingRow Label="Adaptation du contenu" Stacked="True">
                                                <WrapPanel>
                                                    <RadioButton Style="{StaticResource Chip}" Content="Garder les proportions"
                                                                 IsChecked="{Binding StretchMode, Converter={StaticResource Equals}, ConverterParameter=Uniform}"/>
                                                    <RadioButton Style="{StaticResource Chip}" Content="Étirer pour remplir"
                                                                 IsChecked="{Binding StretchMode, Converter={StaticResource Equals}, ConverterParameter=Fill}"/>
                                                    <RadioButton Style="{StaticResource Chip}" Content="Taille réelle (espace libre)"
                                                                 IsChecked="{Binding StretchMode, Converter={StaticResource Equals}, ConverterParameter=None}"
                                                                 ToolTip="Le contenu garde sa taille d'origine : la place restante sert à disposer librement les éléments."/>
                                                </WrapPanel>
                                            </controls:SettingRow>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Forme des réglages de volume (module Volume par application uniquement) -->
                                <StackPanel x:Name="VolumeStyleCard" Visibility="Collapsed">
                                    <ContentControl Style="{StaticResource SectionHeader}" Content="Forme des réglages de volume"/>
                                    <Border Style="{StaticResource RowCard}" local:SettingsSearch.Module="volumemixer" local:SettingsSearch.Keywords="barre cercle segments égaliseur volume">
                                        <StackPanel Style="{StaticResource RowsPanel}">
                                            <controls:SettingRow Label="Forme" Stacked="True"
                                                                 Description="Toutes les formes se règlent au clic, en glissant ou à la molette, et prennent le dégradé du thème.">
                                                <WrapPanel>
                                                    <RadioButton Style="{StaticResource Chip}" Content="Barre verticale"
                                                                 IsChecked="{Binding VolumeStyle, Converter={StaticResource Equals}, ConverterParameter=Vertical}"/>
                                                    <RadioButton Style="{StaticResource Chip}" Content="Barre horizontale"
                                                                 IsChecked="{Binding VolumeStyle, Converter={StaticResource Equals}, ConverterParameter=Horizontal}"/>
                                                    <RadioButton Style="{StaticResource Chip}" Content="Cercle"
                                                                 IsChecked="{Binding VolumeStyle, Converter={StaticResource Equals}, ConverterParameter=Circle}"/>
                                                    <RadioButton Style="{StaticResource Chip}" Content="Demi-cercle"
                                                                 IsChecked="{Binding VolumeStyle, Converter={StaticResource Equals}, ConverterParameter=Half}"/>
                                                    <RadioButton Style="{StaticResource Chip}" Content="Segments (égaliseur)"
                                                                 IsChecked="{Binding VolumeStyle, Converter={StaticResource Equals}, ConverterParameter=Segments}"/>
                                                </WrapPanel>
                                            </controls:SettingRow>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Forme des jauges (module Disques uniquement) -->
                                <StackPanel x:Name="DiskStyleCard" Visibility="Collapsed">
                                    <ContentControl Style="{StaticResource SectionHeader}" Content="Forme des jauges"/>
                                    <Border Style="{StaticResource RowCard}" local:SettingsSearch.Module="disk" local:SettingsSearch.Keywords="anneaux lignes barres jauges disque">
                                        <StackPanel Style="{StaticResource RowsPanel}">
                                            <controls:SettingRow Label="Forme" Stacked="True">
                                                <WrapPanel>
                                                    <RadioButton Style="{StaticResource Chip}" Content="Anneaux"
                                                                 IsChecked="{Binding DiskStyle, Converter={StaticResource Equals}, ConverterParameter=Ring}"/>
                                                    <RadioButton Style="{StaticResource Chip}" Content="Lignes horizontales"
                                                                 IsChecked="{Binding DiskStyle, Converter={StaticResource Equals}, ConverterParameter=Bar}"/>
                                                </WrapPanel>
                                            </controls:SettingRow>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Visualiseur audio uniquement -->
                                <StackPanel x:Name="VisualizerCard" Visibility="Collapsed">
                                    <ContentControl Style="{StaticResource SectionHeader}" Content="Visualiseur"/>
                                    <Border Style="{StaticResource RowCard}" local:SettingsSearch.Module="visualizer" local:SettingsSearch.Keywords="spectre barres onde miroir sensibilité son audio">
                                        <StackPanel Style="{StaticResource RowsPanel}">
                                            <controls:SettingRow Description="Réagit à tout le son qui sort du PC (musique, jeux, vidéos), sur la sortie audio par défaut. Les couleurs suivent le dégradé du thème."/>
                                            <controls:SettingRow Label="Forme" Stacked="True">
                                                <WrapPanel>
                                                    <RadioButton Style="{StaticResource Chip}" Content="Barres verticales"
                                                                 IsChecked="{Binding VisualizerStyle, Converter={StaticResource Equals}, ConverterParameter=Bars}"/>
                                                    <RadioButton Style="{StaticResource Chip}" Content="Onde miroir"
                                                                 IsChecked="{Binding VisualizerStyle, Converter={StaticResource Equals}, ConverterParameter=Mirror}"/>
                                                    <RadioButton Style="{StaticResource Chip}" Content="Cercle"
                                                                 IsChecked="{Binding VisualizerStyle, Converter={StaticResource Equals}, ConverterParameter=Circle}"/>
                                                </WrapPanel>
                                            </controls:SettingRow>
                                            <controls:SettingRow Label="Nombre de barres">
                                                <DockPanel Width="260">
                                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}" Text="{Binding VisualizerBars}"/>
                                                    <Slider Minimum="8" Maximum="96" Value="{Binding VisualizerBars}" IsSnapToTickEnabled="True" TickFrequency="4"/>
                                                </DockPanel>
                                            </controls:SettingRow>
                                            <controls:SettingRow Label="Sensibilité">
                                                <DockPanel Width="260">
                                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}" Text="{Binding VisualizerSensitivity, Converter={StaticResource Multiplier}}"/>
                                                    <Slider Minimum="0.4" Maximum="2.5" Value="{Binding VisualizerSensitivity}" IsSnapToTickEnabled="True" TickFrequency="0.1"/>
                                                </DockPanel>
                                            </controls:SettingRow>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Icônes des boutons (module Lecture en cours uniquement) -->
                                <StackPanel x:Name="MediaIconsCard" Visibility="Collapsed">
                                    <ContentControl Style="{StaticResource SectionHeader}" Content="Style du lecteur"/>
                                    <Border Style="{StaticResource RowCard}" local:SettingsSearch.Module="media" local:SettingsSearch.Keywords="lecteur style disposition vinyle pochette bannière barre temps progression fond boutons">
                                        <StackPanel Style="{StaticResource RowsPanel}">
                                            <controls:SettingRow Label="Disposition" Stacked="True">
                                                <WrapPanel>
                                                    <RadioButton Style="{StaticResource Chip}" Content="Compact"
                                                                 IsChecked="{Binding MediaLayout, Converter={StaticResource Equals}, ConverterParameter=Compact}"/>
                                                    <RadioButton Style="{StaticResource Chip}" Content="Bannière (grande pochette)"
                                                                 IsChecked="{Binding MediaLayout, Converter={StaticResource Equals}, ConverterParameter=Banner}"/>
                                                    <RadioButton Style="{StaticResource Chip}" Content="Vinyle"
                                                                 IsChecked="{Binding MediaLayout, Converter={StaticResource Equals}, ConverterParameter=Vinyl}"/>
                                                    <RadioButton Style="{StaticResource Chip}" Content="Pochette et disque"
                                                                 IsChecked="{Binding MediaLayout, Converter={StaticResource Equals}, ConverterParameter=Sleeve}"/>
                                                </WrapPanel>
                                            </controls:SettingRow>
                                            <controls:SettingRow Label="Barre de temps" Description="Temps écoulé et durée du morceau ; un clic sur la barre avance ou recule dans le morceau." Stacked="True">
                                                <WrapPanel>
                                                    <RadioButton Style="{StaticResource Chip}" Content="Aucune"
                                                                 IsChecked="{Binding MediaProgress, Converter={StaticResource Equals}, ConverterParameter=None}"/>
                                                    <RadioButton Style="{StaticResource Chip}" Content="Fine"
                                                                 IsChecked="{Binding MediaProgress, Converter={StaticResource Equals}, ConverterParameter=Line}"/>
                                                    <RadioButton Style="{StaticResource Chip}" Content="Épaisse avec curseur"
                                                                 IsChecked="{Binding MediaProgress, Converter={StaticResource Equals}, ConverterParameter=Thick}"/>
                                                    <RadioButton Style="{StaticResource Chip}" Content="Segments"
                                                                 IsChecked="{Binding MediaProgress, Converter={StaticResource Equals}, ConverterParameter=Segments}"/>
                                                </WrapPanel>
                                            </controls:SettingRow>
                                            <controls:SettingRow Label="Fond des boutons" Description="Éteint : seulement les icônes, sans rond ni carré derrière.">
                                                <CheckBox Style="{StaticResource ToggleSwitch}" Margin="0" IsChecked="{Binding MediaButtonBackground}"/>
                                            </controls:SettingRow>
                                        </StackPanel>
                                    </Border>

                                    <ContentControl Style="{StaticResource SectionHeader}" Content="Icônes des boutons"/>
                                    <Border Style="{StaticResource RowCard}" local:SettingsSearch.Module="media" local:SettingsSearch.Keywords="boutons précédent suivant lecture pause stop icônes musique">
                                        <StackPanel Style="{StaticResource RowsPanel}">
                                            <controls:SettingRow Label="Jeu d'icônes" Description="Précédent, lecture, pause, suivant et stop." Stacked="True">
                                                <WrapPanel>
                                                    <RadioButton Style="{StaticResource Chip}" Content="Classique"
                                                                 IsChecked="{Binding MediaIconSet, Converter={StaticResource Equals}, ConverterParameter=Classic}"/>
                                                    <RadioButton Style="{StaticResource Chip}" Content="Plein"
                                                                 IsChecked="{Binding MediaIconSet, Converter={StaticResource Equals}, ConverterParameter=Solid}"/>
                                                    <RadioButton Style="{StaticResource Chip}" Content="Double flèche ◀◀ ▶▶"
                                                                 IsChecked="{Binding MediaIconSet, Converter={StaticResource Equals}, ConverterParameter=Double}"/>
                                                    <RadioButton Style="{StaticResource Chip}" Content="Chevrons"
                                                                 IsChecked="{Binding MediaIconSet, Converter={StaticResource Equals}, ConverterParameter=Chevron}"/>
                                                    <RadioButton Style="{StaticResource Chip}" Content="Néon"
                                                                 IsChecked="{Binding MediaIconSet, Converter={StaticResource Equals}, ConverterParameter=Neon}"/>
                                                </WrapPanel>
                                            </controls:SettingRow>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Fond de lecture (module Lecture en cours uniquement) -->
                                <StackPanel x:Name="MediaBackgroundCard" Visibility="Collapsed">
                                    <ContentControl Style="{StaticResource SectionHeader}" Content="Fond de lecture"/>
                                    <Border Style="{StaticResource RowCard}" local:SettingsSearch.Module="media" local:SettingsSearch.Keywords="pochette flou animation spotify musique fond">
                                        <StackPanel Style="{StaticResource RowsPanel}">
                                            <controls:SettingRow Label="Fond" Stacked="True"
                                                                 Description="Utilise la pochette du morceau en cours (Spotify, YouTube, lecteurs…) comme fond du module. L'opacité et le voile sombre se règlent dans « Image de fond » (onglet Style) ; sans lecture en cours, l'image de fond choisie reprend sa place.">
                                                <WrapPanel>
                                                    <RadioButton Style="{StaticResource Chip}" Content="Aucun"
                                                                 IsChecked="{Binding MediaBackground, Converter={StaticResource Equals}, ConverterParameter=None}"/>
                                                    <RadioButton Style="{StaticResource Chip}" Content="Pochette fixe"
                                                                 IsChecked="{Binding MediaBackground, Converter={StaticResource Equals}, ConverterParameter=Cover}"/>
                                                    <RadioButton Style="{StaticResource Chip}" Content="Pochette animée"
                                                                 IsChecked="{Binding MediaBackground, Converter={StaticResource Equals}, ConverterParameter=Animated}"/>
                                                </WrapPanel>
                                            </controls:SettingRow>
                                            <controls:SettingRow Label="Intensité du flou">
                                                <DockPanel Width="260">
                                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}" Text="{Binding MediaBlur, Converter={StaticResource Percent}}"/>
                                                    <Slider Minimum="0" Maximum="1" Value="{Binding MediaBlur}"/>
                                                </DockPanel>
                                            </controls:SettingRow>

                                            <!-- Réglages de l'animation : seulement en mode « Pochette animée » -->
                                            <StackPanel>
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding MediaBackground}" Value="Animated">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>

                                                <controls:SettingRow Label="Style d'animation" Stacked="True">
                                                    <WrapPanel>
                                                        <RadioButton Style="{StaticResource Chip}" Content="Zoom + glissement"
                                                                     IsChecked="{Binding MediaAnimStyle, Converter={StaticResource Equals}, ConverterParameter=KenBurns}"/>
                                                        <RadioButton Style="{StaticResource Chip}" Content="Zoom"
                                                                     IsChecked="{Binding MediaAnimStyle, Converter={StaticResource Equals}, ConverterParameter=Zoom}"/>
                                                        <RadioButton Style="{StaticResource Chip}" Content="Glissement"
                                                                     IsChecked="{Binding MediaAnimStyle, Converter={StaticResource Equals}, ConverterParameter=Pan}"/>
                                                        <RadioButton Style="{StaticResource Chip}" Content="Balancement"
                                                                     IsChecked="{Binding MediaAnimStyle, Converter={StaticResource Equals}, ConverterParameter=Rotate}"/>
                                                    </WrapPanel>
                                                </controls:SettingRow>
                                                <controls:SettingRow Label="Durée d'un cycle" Description="Plus court = plus rapide.">
                                                    <DockPanel Width="260">
                                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}" Text="{Binding MediaAnimDuration, StringFormat={}{0:0} s}"/>
                                                        <Slider Minimum="2" Maximum="60" Value="{Binding MediaAnimDuration}" IsSnapToTickEnabled="True" TickFrequency="1"/>
                                                    </DockPanel>
                                                </controls:SettingRow>
                                                <controls:SettingRow Label="Intensité du zoom">
                                                    <DockPanel Width="260">
                                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}" Text="{Binding MediaAnimZoom, Converter={StaticResource Percent}}"/>
                                                        <Slider Minimum="0" Maximum="0.8" Value="{Binding MediaAnimZoom}"/>
                                                    </DockPanel>
                                                </controls:SettingRow>
                                                <controls:SettingRow Label="Amplitude du mouvement" Description="Glissement et balancement.">
                                                    <DockPanel Width="260">
                                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}" Text="{Binding MediaAnimPan, Converter={StaticResource Percent}}"/>
                                                        <Slider Minimum="0" Maximum="0.25" Value="{Binding MediaAnimPan}"/>
                                                    </DockPanel>
                                                </controls:SettingRow>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <!-- ===== Onglet Éléments ===== -->
                            <StackPanel x:Name="TabElements">
                                <ContentControl Style="{StaticResource SectionHeader}" Content="Éléments du module" Margin="2,10,0,8"/>
                                <Border Style="{StaticResource RowCard}"
                                        local:SettingsSearch.Keywords="déplacer masquer afficher taille position couleurs éléments">
                                    <StackPanel Style="{StaticResource RowsPanel}">
                                        <controls:SettingRow x:Name="EditOnSwitchRow" Visibility="Collapsed" Label="Éléments sur la Switch"
                                                             Description="Déplace les éléments directement sur l'aperçu de la page Switch.">
                                            <Button x:Name="EditOnSwitchButton" Content="Ouvrir l'aperçu de la Switch" Style="{StaticResource PrimaryButton}"
                                                    Click="EditOnSwitch_Click"/>
                                        </controls:SettingRow>
                                        <controls:SettingRow x:Name="LayoutEditRow" Label="Déplacer les éléments sur le bureau"
                                                             Description="Glisser pour déplacer · molette pour la taille · clic droit pour masquer (tous les modules).">
                                            <CheckBox x:Name="LayoutEditCheck" Style="{StaticResource ToggleSwitch}" Margin="0"
                                                      Checked="LayoutEdit_Changed" Unchecked="LayoutEdit_Changed"/>
                                        </controls:SettingRow>

                                        <Border x:Name="ElementRowsBorder" Style="{StaticResource RowBorder}">
                                            <StackPanel x:Name="ElementRowsPanel">
                                                <!-- En-têtes de colonnes -->
                                                <Grid Margin="0,0,0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="54"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="202"/>
                                                        <ColumnDefinition Width="66"/>
                                                        <ColumnDefinition Width="36"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Afficher" Style="{StaticResource FieldLabel}" Margin="0"/>
                                                    <TextBlock Grid.Column="1" Text="Élément" Style="{StaticResource FieldLabel}" Margin="0"/>
                                                    <TextBlock Grid.Column="2" Text="Taille" Style="{StaticResource FieldLabel}" Margin="0"/>
                                                    <TextBlock Grid.Column="3" Text="Couleurs" Style="{StaticResource FieldLabel}" Margin="12,0,0,0"/>
                                                </Grid>

                                                <TextBlock x:Name="ElementsEmptyText" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,8,0,0"
                                                           Text="Affiche ce module (page Modules) pour régler ses éléments."/>
                                                <ItemsControl x:Name="ElementsList">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Style="{StaticResource ListRow}">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="54"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="150"/>
                                                                        <ColumnDefinition Width="52"/>
                                                                        <ColumnDefinition Width="66"/>
                                                                        <ColumnDefinition Width="36"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <CheckBox Style="{StaticResource ToggleSwitch}" Margin="0" VerticalAlignment="Center"
                                                                              IsChecked="{Binding Visible}" ToolTip="Afficher cet élément"/>
                                                                    <TextBlock Grid.Column="1" Text="{Binding Label}" Foreground="{StaticResource UiText}" VerticalAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis" Margin="4,0,8,0"/>
                                                                    <Slider Grid.Column="2" Minimum="0.3" Maximum="3" Value="{Binding Scale}" IsSnapToTickEnabled="True"
                                                                            TickFrequency="0.05" VerticalAlignment="Center" IsEnabled="{Binding Visible}"/>
                                                                    <TextBlock Grid.Column="3" Style="{StaticResource FieldValue}" Text="{Binding Scale, Converter={StaticResource Percent}}"/>
                                                                    <StackPanel Grid.Column="4" Orientation="Horizontal" IsEnabled="{Binding Visible}" Margin="12,0,0,0">
                                                                        <controls:ColorSwatch Style="{StaticResource ColorDot}" Hex="{Binding AccentStart}" Margin="0"
                                                                                              ToolTip="Couleur de début du dégradé (pointillés = couleur du thème)"/>
                                                                        <controls:ColorSwatch Style="{StaticResource ColorDot}" Hex="{Binding AccentEnd}"
                                                                                              ToolTip="Couleur de fin du dégradé (pointillés = couleur du thème)"/>
                                                                    </StackPanel>
                                                                    <Button Grid.Column="5" Style="{StaticResource RowIconButton}" Content="&#xE72C;" Click="ResetElement_Click"
                                                                            ToolTip="Réinitialiser cet élément (position, taille, visibilité, couleurs)"/>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <!-- Tous les éléments du module avec leur état : affiché ou masqué (les masqués ne sont plus cliquables dans l'aperçu) -->
                                        <Border Style="{StaticResource RowBorder}">
                                            <StackPanel>
                                                <TextBlock Text="Afficher ou masquer les éléments" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                                                <TextBlock x:Name="AllElementsEmptyText" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" Visibility="Collapsed"
                                                           Text="Aucun élément réglable : le module n'est pas affiché sur cette cible."/>
                                                <ItemsControl x:Name="AllElementsList">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <DockPanel Margin="0,3">
                                                                <CheckBox Style="{StaticResource ToggleSwitch}" Margin="0,0,10,0" VerticalAlignment="Center"
                                                                          IsChecked="{Binding Visible}" Click="AllElementToggle_Click" ToolTip="Afficher cet élément"/>
                                                                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="11.5" Margin="8,0,0,0">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Text" Value="Affiché"/>
                                                                            <Setter Property="Foreground" Value="{StaticResource UiAccent}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Visible}" Value="False">
                                                                                    <Setter Property="Text" Value="Masqué"/>
                                                                                    <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{StaticResource UiText}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Visible}" Value="False">
                                                                                    <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </DockPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource RowBorder}">
                                            <WrapPanel>
                                                <Button Content="Tout réafficher" Click="ShowHiddenElements_Click" Margin="0,0,8,0"/>
                                                <Button Content="Tout réinitialiser" Click="ResetLayout_Click"/>
                                            </WrapPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Sortie audio : nom court et icône de chaque périphérique (valables pour le bureau et la Switch) -->
                                <StackPanel x:Name="AudioDevicesSection" Visibility="Collapsed">
                                    <ContentControl Style="{StaticResource SectionHeader}" Content="Périphériques" Margin="2,18,0,8"/>
                                    <Border Style="{StaticResource RowCard}" local:SettingsSearch.Module="audio"
                                            local:SettingsSearch.Keywords="périphérique sortie audio nom court casque enceinte icône renommer">
                                        <StackPanel Style="{StaticResource RowsPanel}">
                                            <controls:SettingRow Description="Donne un nom court (« Casque », « Enceinte »…) et une icône à chaque sortie audio. Vide = nom d'origine, sans icône. Réglage commun au bureau et à la Switch."/>
                                            <TextBlock x:Name="AudioDevicesEmptyText" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,8,0,8"
                                                       Text="Aucune sortie audio détectée."/>
                                            <ItemsControl x:Name="AudioDevicesList">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource ListRow}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="32"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="190"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="36"/>
                                                                </Grid.ColumnDefinitions>
                                                                <controls:CustomIconView Icon="{Binding Icon}" IconColor="{Binding IconColor}" Size="18"
                                                                                         HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                                                    <TextBlock Text="{Binding OriginalName}" Foreground="{StaticResource UiText}" TextTrimming="CharacterEllipsis"
                                                                               ToolTip="{Binding OriginalName}"/>
                                                                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource FieldLabel}" Margin="0,2,0,0"/>
                                                                </StackPanel>
                                                                <Grid Grid.Column="2" VerticalAlignment="Center">
                                                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="40"
                                                                             ToolTip="Nom affiché dans le widget à la place du nom complet"/>
                                                                    <TextBlock Text="Nom affiché" Foreground="{StaticResource Muted}" IsHitTestVisible="False"
                                                                               VerticalAlignment="Center" Margin="13,0,0,0" FontStyle="Italic"
                                                                               Visibility="{Binding Name, Converter={StaticResource EmptyToVis}}"/>
                                                                </Grid>
                                                                <Button Grid.Column="3" Content="Icône…" Margin="8,0,0,0" VerticalAlignment="Center" Click="AudioDeviceIcon_Click"
                                                                        ToolTip="Choisir le symbole, l'émoji ou l'image affiché à gauche du nom"/>
                                                                <Button Grid.Column="4" Style="{StaticResource RowIconButton}" Content="&#xE72C;" Click="AudioDeviceReset_Click"
                                                                        ToolTip="Réinitialiser ce périphérique (nom et icône d'origine)"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Volume par application : icône choisie à la place du logo automatique -->
                                <StackPanel x:Name="AppIconsSection" Visibility="Collapsed">
                                    <ContentControl Style="{StaticResource SectionHeader}" Content="Applications" Margin="2,18,0,8"/>
                                    <Border Style="{StaticResource RowCard}" local:SettingsSearch.Module="volumemixer"
                                            local:SettingsSearch.Keywords="application logo icône mixeur volume remplacer">
                                        <StackPanel Style="{StaticResource RowsPanel}">
                                            <controls:SettingRow Description="Choisis le logo de chaque application. « Réinitialiser » revient au logo trouvé automatiquement. Les applications apparaissent ici quand elles jouent du son (clic droit sur une application du widget : « Changer l'icône… »)."/>
                                            <TextBlock x:Name="AppIconsEmptyText" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,8,0,8"
                                                       Text="Aucune application vue pour l'instant : lance un son pour qu'elle apparaisse."/>
                                            <ItemsControl x:Name="AppIconsList">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource ListRow}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="34"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="36"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Grid Width="22" Height="22" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                    <Image Source="{Binding AutoIcon}" RenderOptions.BitmapScalingMode="HighQuality"
                                                                           Visibility="{Binding ShowAuto, Converter={StaticResource BoolToVis}}"/>
                                                                    <TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="18"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource UiText}"
                                                                               Visibility="{Binding ShowFallback, Converter={StaticResource BoolToVis}}"/>
                                                                    <controls:CustomIconView Icon="{Binding Icon}" IconColor="{Binding IconColor}" Size="22"
                                                                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Grid>
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                                                    <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource UiText}" TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource FieldLabel}" Margin="0,2,0,0"/>
                                                                </StackPanel>
                                                                <Button Grid.Column="2" Content="Icône…" VerticalAlignment="Center" Click="AppIcon_Click"
                                                                        ToolTip="Choisir le logo de cette application"/>
                                                                <Button Grid.Column="3" Style="{StaticResource RowIconButton}" Content="&#xE72C;" Click="AppIconReset_Click"
                                                                        ToolTip="Revenir au logo automatique"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <!-- ===== Onglet Boutons (Sortie audio, Volume par application, Lecture en cours) ===== -->
                            <StackPanel x:Name="TabButtons" Visibility="Collapsed">
                                <ContentControl Style="{StaticResource SectionHeader}" Content="Boutons du module" Margin="2,10,0,8"/>
                                <Border Style="{StaticResource RowCard}"
                                        local:SettingsSearch.Keywords="boutons couleur fond survol icône masquer afficher lecture pause muet utiliser fermer">
                                    <StackPanel Style="{StaticResource RowsPanel}">
                                        <controls:SettingRow Description="Pour chaque bouton : couleur de fond, du texte ou de l'icône, couleur au survol, icône de remplacement et affichage. Pointillés = couleur du thème."/>
                                        <Border x:Name="ButtonRowsBorder" Style="{StaticResource RowBorder}">
                                            <StackPanel x:Name="ButtonRowsPanel">
                                                <Grid Margin="0,0,0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="54"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="44"/>
                                                        <ColumnDefinition Width="44"/>
                                                        <ColumnDefinition Width="44"/>
                                                        <ColumnDefinition Width="132"/>
                                                        <ColumnDefinition Width="36"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Afficher" Style="{StaticResource FieldLabel}" Margin="0"/>
                                                    <TextBlock Grid.Column="1" Text="Bouton" Style="{StaticResource FieldLabel}" Margin="0"/>
                                                    <TextBlock Grid.Column="2" Text="Fond" Style="{StaticResource FieldLabel}" Margin="0"/>
                                                    <TextBlock Grid.Column="3" Text="Texte" Style="{StaticResource FieldLabel}" Margin="0"/>
                                                    <TextBlock Grid.Column="4" Text="Survol" Style="{StaticResource FieldLabel}" Margin="0"/>
                                                    <TextBlock Grid.Column="5" Text="Icône" Style="{StaticResource FieldLabel}" Margin="8,0,0,0"/>
                                                </Grid>
                                                <ItemsControl x:Name="ButtonPartsList">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Style="{StaticResource ListRow}">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="54"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="44"/>
                                                                        <ColumnDefinition Width="44"/>
                                                                        <ColumnDefinition Width="44"/>
                                                                        <ColumnDefinition Width="132"/>
                                                                        <ColumnDefinition Width="36"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <CheckBox Style="{StaticResource ToggleSwitch}" Margin="0" VerticalAlignment="Center"
                                                                              IsChecked="{Binding Style.Visible}" ToolTip="Afficher ce bouton"/>
                                                                    <TextBlock Grid.Column="1" Text="{Binding Label}" Foreground="{StaticResource UiText}" VerticalAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis" Margin="4,0,8,0" ToolTip="{Binding Label}"/>
                                                                    <controls:ColorSwatch Grid.Column="2" Style="{StaticResource ColorDot}" Hex="{Binding Style.Background}" Margin="0"
                                                                                          IsEnabled="{Binding Style.Visible}" ToolTip="Fond du bouton (pointillés = couleur du thème)"/>
                                                                    <controls:ColorSwatch Grid.Column="3" Style="{StaticResource ColorDot}" Hex="{Binding Style.Foreground}" Margin="0"
                                                                                          IsEnabled="{Binding Style.Visible}" ToolTip="Texte ou icône du bouton (pointillés = couleur du thème)"/>
                                                                    <controls:ColorSwatch Grid.Column="4" Style="{StaticResource ColorDot}" Hex="{Binding Style.HoverBackground}" Margin="0"
                                                                                          IsEnabled="{Binding HoverEnabled}" ToolTip="{Binding HoverTip}"/>
                                                                    <DockPanel Grid.Column="5" Margin="8,0,0,0" IsEnabled="{Binding Style.Visible}">
                                                                        <controls:CustomIconView DockPanel.Dock="Left" Icon="{Binding Style.Glyph}" Size="18" Margin="0,0,8,0"
                                                                                                 VerticalAlignment="Center"/>
                                                                        <Button Content="Icône…" VerticalAlignment="Center" Click="ButtonIcon_Click"
                                                                                ToolTip="Remplacer le contenu du bouton par un symbole, un émoji ou une image"/>
                                                                    </DockPanel>
                                                                    <Button Grid.Column="6" Style="{StaticResource RowIconButton}" Content="&#xE72C;" Click="ResetButtonRow_Click"
                                                                            ToolTip="Réinitialiser ce bouton (fond, texte, survol, icône, affichage)"/>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource RowBorder}">
                                            <Button Content="Tout réinitialiser" Click="ResetButtons_Click" HorizontalAlignment="Left"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ===== Onglet Textes ===== -->
                            <StackPanel x:Name="TabTexts">
                                <ContentControl Style="{StaticResource SectionHeader}" Content="Textes du module" Margin="2,10,0,8"/>
                                <Border Style="{StaticResource RowCard}"
                                        local:SettingsSearch.Keywords="renommer libellé titre police taille texte">
                                    <StackPanel Style="{StaticResource RowsPanel}">
                                        <StackPanel x:Name="TextRowsPanel">
                                        <controls:SettingRow Description="Les titres et libellés peuvent être renommés ; les valeurs (températures, pourcentages…) gardent leur texte. Dans une liste (disques, applications…), le réglage vaut pour toutes les lignes."/>

                                        <ItemsControl x:Name="TextPartsList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource ListRow}">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="54"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="36"/>
                                                                <ColumnDefinition Width="150"/>
                                                                <ColumnDefinition Width="52"/>
                                                                <ColumnDefinition Width="36"/>
                                                            </Grid.ColumnDefinitions>

                                                            <CheckBox Style="{StaticResource ToggleSwitch}" Margin="0" VerticalAlignment="Center"
                                                                      IsChecked="{Binding Style.Visible}" ToolTip="Afficher ce texte"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Label}" Foreground="{StaticResource UiText}" VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis" Margin="4,0,8,0"/>
                                                            <controls:ColorSwatch Grid.Column="2" Style="{StaticResource ColorDot}" Hex="{Binding Style.Color}" Margin="0"
                                                                                  IsEnabled="{Binding Style.Visible}" ToolTip="Couleur du texte (pointillés = couleur du thème)"/>
                                                            <Slider Grid.Column="3" Minimum="0.4" Maximum="3" Value="{Binding Style.Scale}" IsSnapToTickEnabled="True"
                                                                    TickFrequency="0.05" VerticalAlignment="Center" IsEnabled="{Binding Style.Visible}" ToolTip="Taille de ce texte"/>
                                                            <TextBlock Grid.Column="4" Style="{StaticResource FieldValue}" Text="{Binding Style.Scale, Converter={StaticResource Percent}}"/>
                                                            <Button Grid.Column="5" Style="{StaticResource RowIconButton}" Content="&#xE72C;" Click="ResetTextRow_Click"
                                                                    ToolTip="Réinitialiser ce texte (libellé, police, taille, couleur)"/>

                                                            <!-- Seconde ligne : libellé personnalisé (textes fixes) et police -->
                                                            <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="5" Margin="4,8,0,0" IsEnabled="{Binding Style.Visible}">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="12"/>
                                                                    <ColumnDefinition Width="230"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Grid Visibility="{Binding Editable, Converter={StaticResource BoolToVis}}">
                                                                    <TextBox Text="{Binding Style.CustomText, UpdateSourceTrigger=PropertyChanged}" MaxLength="60"
                                                                             ToolTip="Texte affiché à la place de l'original ; vide = texte d'origine"/>
                                                                    <TextBlock Text="{Binding DefaultText}" Foreground="{StaticResource Muted}" IsHitTestVisible="False"
                                                                               VerticalAlignment="Center" Margin="13,0,0,0" FontStyle="Italic"
                                                                               Visibility="{Binding Style.CustomText, Converter={StaticResource EmptyToVis}}"/>
                                                                </Grid>
                                                                <controls:FontPicker Grid.Column="2" AllowThemeDefault="True" ShowImport="False" FontKey="{Binding Style.Font}"/>
                                                            </Grid>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        </StackPanel>

                                        <!-- Échelle propre au module (s'ajoute à la taille du texte du thème) -->
                                        <controls:SettingRow Label="Taille de tous les textes du module"
                                                             Description="S'ajoute à la taille du texte réglée dans le thème.">
                                            <DockPanel Width="400">
                                                <Button DockPanel.Dock="Right" Content="Tout réinitialiser" Margin="12,0,0,0" Click="ResetTexts_Click"/>
                                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}" Text="{Binding FontScale, Converter={StaticResource Percent}}"/>
                                                <Slider Minimum="0.5" Maximum="2" Value="{Binding FontScale}" IsSnapToTickEnabled="True" TickFrequency="0.05"/>
                                            </DockPanel>
                                        </controls:SettingRow>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ===== Onglet Style : couleurs et polices, carte, jauges, animations ===== -->
                            <!-- Chaque section suit le thème global tant que « Propre à ce module » est éteint. -->
                            <StackPanel x:Name="TabStyle" Visibility="Collapsed">
                                <DockPanel Margin="0,8,0,0" local:SettingsSearch.Ignore="True">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Modifier le thème global"
                                            Click="EditGlobalTheme_Click"/>
                                    <TextBlock Text="Chaque section suit le thème global tant que « Propre à ce module » est éteint."
                                               Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </DockPanel>

                                <!-- Couleurs et polices -->
                                <StackPanel x:Name="StyleColorsSection">
                                    <ContentControl Style="{StaticResource SectionHeader}" Content="Couleurs et polices"/>
                                    <Border Style="{StaticResource RowCard}" local:SettingsSearch.Keywords="couleur couleurs police polices dégradé thème texte boutons">
                                        <StackPanel Style="{StaticResource RowsPanel}">
                                            <controls:SettingRow Label="Propre à ce module" Description="Dégradé, couleur des textes et des boutons, polices.">
                                                <CheckBox Style="{StaticResource ToggleSwitch}" Margin="0" IsChecked="{Binding UseCustomTheme}"/>
                                            </controls:SettingRow>
                                            <Border x:Name="InheritColorsBar" Style="{StaticResource RowBorder}" BorderThickness="0" Padding="0,2,0,14" local:SettingsSearch.Ignore="True">
                                                <TextBlock Text="Suit le thème global" Foreground="{StaticResource Muted}" FontStyle="Italic"/>
                                            </Border>
                                            <Border x:Name="ColorsEditorHost" Padding="0,0,0,16">
                                                <controls:ThemeEditor x:Name="ColorsEditor" Section="ColorsFonts" Embedded="True"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Horloge à cases uniquement (réglages communs PC et Switch) -->
                                <StackPanel x:Name="TileClockCard" Visibility="Collapsed">
                                    <ContentControl Style="{StaticResource SectionHeader}" Content="Horloge à cases"/>
                                    <Border Style="{StaticResource RowCard}" local:SettingsSearch.Module="tileclock" local:SettingsSearch.Keywords="horloge cases couleur secondes">
                                        <StackPanel Style="{StaticResource RowsPanel}">
                                            <controls:SettingRow Label="Couleur des cases" Description="Commune au PC et à la Switch.">
                                                <controls:ColorSwatch Style="{StaticResource ColorDot}" Hex="{Binding TileClockColor}" Margin="0"/>
                                            </controls:SettingRow>
                                            <controls:SettingRow Label="Afficher les secondes">
                                                <CheckBox Style="{StaticResource ToggleSwitch}" Margin="0" IsChecked="{Binding TileClockSeconds}"/>
                                            </controls:SettingRow>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Météo uniquement -->
                                <StackPanel x:Name="WeatherCard" Visibility="Collapsed">
                                    <ContentControl Style="{StaticResource SectionHeader}" Content="Ville (météo, qualité de l'air, soleil)"/>
                                    <Border Style="{StaticResource RowCard}" local:SettingsSearch.Module="weather" local:SettingsSearch.Keywords="météo ville open-meteo">
                                        <StackPanel Style="{StaticResource RowsPanel}">
                                            <controls:SettingRow Label="Ville" Description="Données Open-Meteo (gratuites, sans compte), mises à jour toutes les 15 minutes.">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBox x:Name="WeatherCityBox" Width="170" Height="30" VerticalContentAlignment="Center" KeyDown="WeatherCityBox_KeyDown"/>
                                                    <Button Content="Rechercher" Margin="8,0,0,0" Click="WeatherSearch_Click"/>
                                                </StackPanel>
                                            </controls:SettingRow>
                                            <Border Style="{StaticResource RowBorder}" BorderThickness="0">
                                                <TextBlock x:Name="WeatherStatusText" TextWrapping="Wrap" Foreground="{DynamicResource SubTextBrush}"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Barres de capteurs uniquement (réglages communs PC et Switch) -->
                                <StackPanel x:Name="SensorBarsCard" Visibility="Collapsed">
                                    <ContentControl Style="{StaticResource SectionHeader}" Content="Données affichées"/>
                                    <Border Style="{StaticResource RowCard}" local:SettingsSearch.Module="sensorbars" local:SettingsSearch.Keywords="capteurs barres données ventilateur température vram ram">
                                        <StackPanel Style="{StaticResource RowsPanel}">
                                            <controls:SettingRow Description="Une barre par donnée. Les ventilateurs de la carte graphique sont lus directement ; ceux de la carte mère seulement si Windows autorise le pilote de mesure (Intégrité de la mémoire désactivée)."/>
                                            <StackPanel x:Name="SensorBarsItems"/>
                                            <Border Style="{StaticResource RowBorder}" BorderThickness="0">
                                                <Button Content="Ajouter une donnée" HorizontalAlignment="Left" Click="SensorBarAdd_Click"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                    <ContentControl Style="{StaticResource SectionHeader}" Content="Style des barres"/>
                                    <Border Style="{StaticResource RowCard}" local:SettingsSearch.Module="sensorbars" local:SettingsSearch.Keywords="barres style segments dégradé halo alerte largeur hauteur arrondi">
                                        <StackPanel Style="{StaticResource RowsPanel}">
                                            <controls:SettingRow Label="Sens" Stacked="True">
                                                <WrapPanel>
                                                    <RadioButton Style="{StaticResource Chip}" Content="Horizontales" IsChecked="{Binding Orientation, Converter={StaticResource Equals}, ConverterParameter=Horizontal}"/>
                                                    <RadioButton Style="{StaticResource Chip}" Content="Verticales" IsChecked="{Binding Orientation, Converter={StaticResource Equals}, ConverterParameter=Vertical}"/>
                                                </WrapPanel>
                                            </controls:SettingRow>
                                            <controls:SettingRow Label="Forme" Stacked="True">
                                                <WrapPanel>
                                                    <RadioButton Style="{StaticResource Chip}" Content="Segments" IsChecked="{Binding Style, Converter={StaticResource Equals}, ConverterParameter=Segments}"/>
                                                    <RadioButton Style="{StaticResource Chip}" Content="Pleine" IsChecked="{Binding Style, Converter={StaticResource Equals}, ConverterParameter=Solid}"/>
                                                    <RadioButton Style="{StaticResource Chip}" Content="Dégradé" IsChecked="{Binding Style, Converter={StaticResource Equals}, ConverterParameter=Gradient}"/>
                                                </WrapPanel>
                                            </controls:SettingRow>
                                            <controls:SettingRow Label="Nombre de segments">
                                                <DockPanel Width="260">
                                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}" Text="{Binding Segments}"/>
                                                    <Slider Minimum="4" Maximum="40" Value="{Binding Segments}" IsSnapToTickEnabled="True" TickFrequency="1"/>
                                                </DockPanel>
                                            </controls:SettingRow>
                                            <controls:SettingRow Label="Épaisseur des barres">
                                                <DockPanel Width="260">
                                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}" Text="{Binding BarWidth, StringFormat={}{0:0} px}"/>
                                                    <Slider Minimum="6" Maximum="80" Value="{Binding BarWidth}" IsSnapToTickEnabled="True" TickFrequency="1"/>
                                                </DockPanel>
                                            </controls:SettingRow>
                                            <controls:SettingRow Label="Longueur des barres">
                                                <DockPanel Width="260">
                                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}" Text="{Binding BarHeight, StringFormat={}{0:0} px}"/>
                                                    <Slider Minimum="60" Maximum="500" Value="{Binding BarHeight}" IsSnapToTickEnabled="True" TickFrequency="5"/>
                                                </DockPanel>
                                            </controls:SettingRow>
                                            <controls:SettingRow Label="Espacement">
                                                <DockPanel Width="260">
                                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}" Text="{Binding Spacing, StringFormat={}{0:0} px}"/>
                                                    <Slider Minimum="4" Maximum="60" Value="{Binding Spacing}" IsSnapToTickEnabled="True" TickFrequency="1"/>
                                                </DockPanel>
                                            </controls:SettingRow>
                                            <controls:SettingRow Label="Arrondi">
                                                <DockPanel Width="260">
                                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}" Text="{Binding CornerRadius, StringFormat={}{0:0} px}"/>
                                                    <Slider Minimum="0" Maximum="40" Value="{Binding CornerRadius}" IsSnapToTickEnabled="True" TickFrequency="1"/>
                                                </DockPanel>
                                            </controls:SettingRow>
                                            <controls:SettingRow Label="Halo lumineux">
                                                <CheckBox Style="{StaticResource ToggleSwitch}" Margin="0" IsChecked="{Binding Glow}"/>
                                            </controls:SettingRow>
                                            <controls:SettingRow Label="Couleur d'alerte" Description="La barre change de couleur au-delà du seuil.">
                                                <StackPanel Orientation="Horizontal">
                                                    <controls:ColorSwatch Style="{StaticResource ColorDot}" Hex="{Binding AlertColor}" Margin="0,0,12,0"/>
                                                    <CheckBox Style="{StaticResource ToggleSwitch}" Margin="0" IsChecked="{Binding Alert}"/>
                                                </StackPanel>
                                            </controls:SettingRow>
                                            <controls:SettingRow Label="Seuil d'alerte">
                                                <DockPanel Width="260">
                                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}" Text="{Binding AlertPercent, StringFormat={}{0:0} %}"/>
                                                    <Slider Minimum="10" Maximum="100" Value="{Binding AlertPercent}" IsSnapToTickEnabled="True" TickFrequency="5"/>
                                                </DockPanel>
                                            </controls:SettingRow>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- SimHub uniquement -->
                                <StackPanel x:Name="SimHubCard" Visibility="Collapsed">
                                    <ContentControl Style="{StaticResource SectionHeader}" Content="SimHub"/>
                                    <Border Style="{StaticResource RowCard}" local:SettingsSearch.Module="simhub" local:SettingsSearch.Keywords="simhub course simracing property server port">
                                        <StackPanel Style="{StaticResource RowsPanel}">
                                            <controls:SettingRow Description="Le module lit SimHub grâce au plugin gratuit « SimHub Property Server » (github.com/pre-martin/SimHubPropertyServer) : copier PropertyServer.dll dans le dossier de SimHub, puis l'activer dans SimHub › Settings › Plugins."/>
                                            <controls:SettingRow Label="Port du plugin" Description="18082 par défaut.">
                                                <TextBox Width="90" Height="30" VerticalContentAlignment="Center" Text="{Binding SimHubPort, UpdateSourceTrigger=LostFocus}"/>
                                            </controls:SettingRow>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Températures CPU / GPU uniquement -->
                                <StackPanel x:Name="TemperatureCard" Visibility="Collapsed">
                                    <ContentControl Style="{StaticResource SectionHeader}" Content="Courbes"/>
                                    <Border Style="{StaticResource RowCard}" local:SettingsSearch.Module="temperatures" local:SettingsSearch.Keywords="courbe couleur température processeur carte graphique cpu gpu">
                                        <StackPanel Style="{StaticResource RowsPanel}">
                                            <controls:SettingRow Label="Courbe du processeur" Description="Commune au PC et à la Switch.">
                                                <controls:ColorSwatch Style="{StaticResource ColorDot}" Hex="{Binding CpuCurveColor}" Margin="0"/>
                                            </controls:SettingRow>
                                            <controls:SettingRow Label="Courbe de la carte graphique" Description="Commune au PC et à la Switch.">
                                                <controls:ColorSwatch Style="{StaticResource ColorDot}" Hex="{Binding GpuCurveColor}" Margin="0"/>
                                            </controls:SettingRow>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Carte (et image de fond) -->
                                <StackPanel x:Name="StyleCardSection">
                                    <ContentControl Style="{StaticResource SectionHeader}" Content="Carte"/>
                                    <Border Style="{StaticResource RowCard}" local:SettingsSearch.Keywords="carte fond contour opacité arrondi coins bulles">
                                        <StackPanel Style="{StaticResource RowsPanel}">
                                            <controls:SettingRow Label="Propre à ce module" Description="Couleurs du fond et du contour, opacités, arrondi.">
                                                <CheckBox Style="{StaticResource ToggleSwitch}" Margin="0" IsChecked="{Binding CustomCard}"/>
                                            </controls:SettingRow>
                                            <Border x:Name="InheritCardBar" Style="{StaticResource RowBorder}" BorderThickness="0" Padding="0,2,0,14" local:SettingsSearch.Ignore="True">
                                                <TextBlock Text="Suit le thème global" Foreground="{StaticResource Muted}" FontStyle="Italic"/>
                                            </Border>
                                            <Border x:Name="CardEditorHost" Padding="0,0,0,16">
                                                <controls:ThemeEditor x:Name="CardEditor" Section="Card" Embedded="True"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <ContentControl Style="{StaticResource SectionHeader}" Content="Image de fond"/>
                                    <Border Style="{StaticResource RowCard}" local:SettingsSearch.Keywords="image fond opacité voile sombre arrière-plan">
                                        <StackPanel Style="{StaticResource RowsPanel}">
                                            <controls:SettingRow Label="Image" Stacked="True">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="190" Height="110" CornerRadius="8" Background="{StaticResource UiHover}" BorderBrush="{StaticResource InputBorder}"
                                                            BorderThickness="1" Margin="0,0,18,0" VerticalAlignment="Top">
                                                        <Grid>
                                                            <TextBlock Text="Aucune image" Foreground="{StaticResource Muted}" FontSize="11.5"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            <Border CornerRadius="7" Background="{Binding BackgroundImage, Converter={StaticResource ImageToBrush}}"
                                                                    Opacity="{Binding BackgroundImageOpacity}"/>
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                                        <Button Content="Choisir une image…" Style="{StaticResource PrimaryButton}" Click="ChooseBackground_Click" Margin="0,0,8,0"/>
                                                        <Button Content="Retirer" Click="RemoveBackground_Click"/>
                                                    </StackPanel>
                                                </Grid>
                                            </controls:SettingRow>
                                            <controls:SettingRow Label="Opacité de l'image">
                                                <DockPanel Width="260">
                                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}" Text="{Binding BackgroundImageOpacity, Converter={StaticResource Percent}}"/>
                                                    <Slider Minimum="0.05" Maximum="1" Value="{Binding BackgroundImageOpacity}"/>
                                                </DockPanel>
                                            </controls:SettingRow>
                                            <controls:SettingRow Label="Voile sombre" Description="Améliore la lisibilité des textes.">
                                                <DockPanel Width="260">
                                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}" Text="{Binding BackgroundDim, Converter={StaticResource Percent}}"/>
                                                    <Slider Minimum="0" Maximum="0.9" Value="{Binding BackgroundDim}"/>
                                                </DockPanel>
                                            </controls:SettingRow>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Jauges (masquées pour un module sans option de jauge) -->
                                <StackPanel x:Name="StyleGaugesSection">
                                    <ContentControl Style="{StaticResource SectionHeader}" Content="Jauges"/>
                                    <Border Style="{StaticResource RowCard}" local:SettingsSearch.Keywords="jauge jauges forme épaisseur graduations halo">
                                        <StackPanel Style="{StaticResource RowsPanel}">
                                            <controls:SettingRow Label="Propre à ce module" Description="Style, forme, épaisseur, graduations, halo.">
                                                <CheckBox Style="{StaticResource ToggleSwitch}" Margin="0" IsChecked="{Binding CustomGauges}"/>
                                            </controls:SettingRow>
                                            <Border x:Name="InheritGaugesBar" Style="{StaticResource RowBorder}" BorderThickness="0" Padding="0,2,0,14" local:SettingsSearch.Ignore="True">
                                                <TextBlock Text="Suit le thème global" Foreground="{StaticResource Muted}" FontStyle="Italic"/>
                                            </Border>
                                            <Border x:Name="GaugesEditorHost" Padding="0,0,0,16">
                                                <controls:ThemeEditor x:Name="GaugesEditor" Section="Gauges" Embedded="True"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Animations -->
                                <StackPanel x:Name="StyleAnimationsSection">
                                    <ContentControl Style="{StaticResource SectionHeader}" Content="Animations"/>
                                    <Border Style="{StaticResource RowCard}" local:SettingsSearch.Keywords="animation animations durée mouvement fondu">
                                        <StackPanel Style="{StaticResource RowsPanel}">
                                            <controls:SettingRow Label="Propre à ce module" Description="Durée, mouvement, remplissage et apparition.">
                                                <CheckBox Style="{StaticResource ToggleSwitch}" Margin="0" IsChecked="{Binding CustomAnimations}"/>
                                            </controls:SettingRow>
                                            <Border x:Name="InheritAnimationsBar" Style="{StaticResource RowBorder}" BorderThickness="0" Padding="0,2,0,14" local:SettingsSearch.Ignore="True">
                                                <TextBlock Text="Suit le thème global" Foreground="{StaticResource Muted}" FontStyle="Italic"/>
                                            </Border>
                                            <Border x:Name="AnimationsEditorHost" Padding="0,0,0,16">
                                                <controls:ThemeEditor x:Name="AnimationsEditor" Section="Animations" Embedded="True"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <Button Content="Revenir au thème global" HorizontalAlignment="Left" Margin="0,20,0,8" local:SettingsSearch.Ignore="True"
                                        Click="ResetModuleTheme_Click"
                                        ToolTip="Désactive les 4 réglages « Propre à ce module » : le module suit de nouveau le thème global"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- ===== Page : Barre de raccourcis ===== -->
                <ScrollViewer x:Name="PageDock" Grid.Row="1" Style="{StaticResource PageScroller}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Barre de raccourcis" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Apparence et comportement du dock de lancement rapide." Style="{StaticResource PageSubtitle}"/>

                        <ContentControl Style="{StaticResource SectionHeader}" Content="Disposition"/>
                        <Border Style="{StaticResource RowCard}" local:SettingsSearch.Keywords="dock orientation horizontale verticale icônes espacement taille animation survol">
                            <StackPanel Style="{StaticResource RowsPanel}">
                                <controls:SettingRow Label="Orientation">
                                    <WrapPanel>
                                        <RadioButton x:Name="OrientationHorizontal" Style="{StaticResource Chip}" Content="Horizontale" GroupName="DockOrientation" Checked="DockStyle_RadioChanged" Margin="0,0,0,0"/>
                                        <RadioButton x:Name="OrientationVertical" Style="{StaticResource Chip}" Content="Verticale" GroupName="DockOrientation" Checked="DockStyle_RadioChanged" Margin="6,0,0,0"/>
                                    </WrapPanel>
                                </controls:SettingRow>
                                <controls:SettingRow Label="Sens de l'animation au survol" Stacked="True">
                                    <WrapPanel>
                                        <RadioButton x:Name="DirUp" Style="{StaticResource Chip}" Content="Vers le haut" GroupName="DockDirection" Checked="DockStyle_RadioChanged"/>
                                        <RadioButton x:Name="DirDown" Style="{StaticResource Chip}" Content="Vers le bas" GroupName="DockDirection" Checked="DockStyle_RadioChanged"/>
                                        <RadioButton x:Name="DirLeft" Style="{StaticResource Chip}" Content="Vers la gauche" GroupName="DockDirection" Checked="DockStyle_RadioChanged"/>
                                        <RadioButton x:Name="DirRight" Style="{StaticResource Chip}" Content="Vers la droite" GroupName="DockDirection" Checked="DockStyle_RadioChanged"/>
                                    </WrapPanel>
                                </controls:SettingRow>
                                <controls:SettingRow Label="Taille des icônes">
                                    <DockPanel Width="260">
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}" Text="{Binding Value, ElementName=IconSizeSlider, StringFormat={}{0:0} px}"/>
                                        <Slider x:Name="IconSizeSlider" Minimum="30" Maximum="80" ValueChanged="DockStyle_SliderChanged"/>
                                    </DockPanel>
                                </controls:SettingRow>
                                <controls:SettingRow Label="Espacement des icônes">
                                    <DockPanel Width="260">
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}" Text="{Binding Value, ElementName=IconSpacingSlider, StringFormat={}{0:0} px}"/>
                                        <Slider x:Name="IconSpacingSlider" Minimum="0" Maximum="24" ValueChanged="DockStyle_SliderChanged"/>
                                    </DockPanel>
                                </controls:SettingRow>
                            </StackPanel>
                        </Border>

                        <ContentControl Style="{StaticResource SectionHeader}" Content="Transparence"/>
                        <Border Style="{StaticResource RowCard}" local:SettingsSearch.Keywords="dock opacité fond contour transparent">
                            <StackPanel Style="{StaticResource RowsPanel}">
                                <controls:SettingRow Label="Opacité du fond">
                                    <DockPanel Width="260">
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}" Text="{Binding Value, ElementName=DockPanelOpacitySlider, Converter={StaticResource Percent}}"/>
                                        <Slider x:Name="DockPanelOpacitySlider" Minimum="0" Maximum="1" ValueChanged="DockOpacitySlider_Changed"/>
                                    </DockPanel>
                                </controls:SettingRow>
                                <controls:SettingRow Label="Opacité du contour">
                                    <DockPanel Width="260">
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}" Text="{Binding Value, ElementName=DockBorderOpacitySlider, Converter={StaticResource Percent}}"/>
                                        <Slider x:Name="DockBorderOpacitySlider" Minimum="0" Maximum="1" ValueChanged="DockOpacitySlider_Changed"/>
                                    </DockPanel>
                                </controls:SettingRow>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== Page : Switch (façon Stream Deck : aperçu au centre, inspecteur en bas, bibliothèque et réglages à droite) ===== -->
                <Grid x:Name="PageSwitch" Grid.Row="1" Visibility="Collapsed" Margin="24,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="360"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="370" MinWidth="280"/>
                    </Grid.ColumnDefinitions>

                    <!-- Colonne principale : en-tête, aperçu, pages, inspecteur de la tuile -->
                    <Grid Margin="0,0,20,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DockPanel Margin="0,0,0,12">
                            <TextBlock x:Name="DeckStatusText" DockPanel.Dock="Right" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="Switch" Style="{StaticResource PageTitle}"/>
                                <TextBlock x:Name="SwitchViewHint" Text="Glisse une action de la bibliothèque sur une case, puis clique sur la tuile pour la régler."
                                           Style="{StaticResource PageSubtitle}"/>
                                <!-- Vue : écran de la Switch ou manettes (Joy-Con) -->
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <RadioButton x:Name="SwitchViewScreen" Content="Écran" Style="{StaticResource TabButton}" GroupName="SwitchView"
                                                 IsChecked="True" MinWidth="110" Checked="SwitchView_Checked"/>
                                    <RadioButton x:Name="SwitchViewJoyCon" Content="Manettes (Joy-Con)" Style="{StaticResource TabButton}" GroupName="SwitchView"
                                                 MinWidth="150" Checked="SwitchView_Checked"/>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>

                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Aperçu en direct de l'écran ; les .exe et .lnk glissés depuis l'Explorateur y sont acceptés -->
                            <Border x:Name="SwitchScreenView" Grid.Row="0" AllowDrop="True" DragOver="DeckApps_DragOver" Drop="DeckApps_Drop" Background="Transparent">
                            <controls:DeckLayoutEditor x:Name="DeckEditor" VerticalAlignment="Center"/>
                            </Border>

                        <!-- Manettes : les deux Joy-Con dessinés, une touche se clique (ou reçoit une action glissée) -->
                        <DockPanel x:Name="SwitchJoyConView" Grid.Row="0" Visibility="Collapsed">
                            <TextBlock x:Name="JoyConStatusText" DockPanel.Dock="Top" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <ContentControl x:Name="JoyConDiagramHost" Focusable="False"/>
                        </DockPanel>

                        <!-- Pages (comme les points du Stream Deck) et tuiles hors grille -->
                        <StackPanel Grid.Row="1" Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <ListBox x:Name="DeckPagesList" Style="{StaticResource ChipList}"
                                         SelectionChanged="DeckPages_SelectionChanged" ToolTip="Pages de l'écran : sur la Switch, glisse à gauche ou à droite pour en changer">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel MinWidth="118" MaxWidth="190">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <Border Width="110" Height="62" Background="#0B0C10" CornerRadius="4"
                                                        ClipToBounds="True" Margin="0,5,0,0">
                                                    <Viewbox Stretch="Fill">
                                                        <ItemsControl Width="1280" Height="720" ItemsSource="{Binding PreviewElements}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <Canvas Width="1280" Height="720" ClipToBounds="True"/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemContainerStyle>
                                                                <Style TargetType="ContentPresenter">
                                                                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                                                    <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                                                </Style>
                                                            </ItemsControl.ItemContainerStyle>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Width="{Binding Width}" Height="{Binding Height}" CornerRadius="18"
                                                                            Background="#557C8794" BorderBrush="#AAB4BEC8" BorderThickness="8"/>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Viewbox>
                                                </Border>
                                                <TextBlock Text="{Binding PreviewSummary}" FontSize="10" Foreground="{StaticResource Muted}"
                                                           TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Button Content="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Top" Margin="2,0,0,8"
                                        ToolTip="Nouvelle page" Click="DeckPageAdd_Click"/>
                            </StackPanel>
                            <StackPanel x:Name="DeckHiddenAppsPanel" Visibility="Collapsed" Margin="0,4,0,0">
                                <TextBlock x:Name="DeckHiddenAppsText" FontSize="11.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                                <WrapPanel x:Name="DeckHiddenAppsList" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        </Grid>

                        <!-- Inspecteur : réglages de la tuile sélectionnée (ou de la touche de manette) -->
                        <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" ShowsPreview="False"
                                      Background="Transparent" Cursor="SizeNS" ToolTip="Faire glisser pour agrandir ou réduire les réglages de la tuile"/>
                        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,8,0,0" MinHeight="128">
                            <Grid>
                                <!-- Touche d'un Joy-Con -->
                                <Grid x:Name="JoyConInspector" Visibility="Collapsed" Panel.ZIndex="5" Background="{StaticResource CardBg}">
                                    <TextBlock x:Name="JoyConInspectorEmpty" Text="Clique sur une touche des Joy-Con pour lui donner une action (ou glisse une action de la bibliothèque dessus)."
                                               Foreground="{StaticResource Muted}" FontSize="12.5" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    <DockPanel x:Name="JoyConInspectorBody" Visibility="Collapsed">
                                        <StackPanel DockPanel.Dock="Right" Margin="16,0,0,0" MinWidth="190" VerticalAlignment="Top">
                                            <Button x:Name="JoyConEditButton" Content="Régler l'action…" Style="{StaticResource PrimaryButton}" Click="JoyConEdit_Click"/>
                                            <Button Content="Aucune action" Margin="0,8,0,0" Click="JoyConClear_Click"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock x:Name="JoyConInspectorTitle" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource UiAccent}"/>
                                            <TextBlock x:Name="JoyConInspectorAction" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource UiText}" Margin="0,6,0,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <CheckBox x:Name="JoyConPageCheck" Style="{StaticResource ToggleSwitch}" Margin="0,10,0,0" Click="JoyConPage_Click"/>
                                            <StackPanel x:Name="JoyConTargetPagePanel" Margin="0,10,0,0" Visibility="Collapsed">
                                                <TextBlock Text="Aller à la page" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                                <ComboBox x:Name="JoyConTargetPageBox" SelectionChanged="JoyConTargetPage_Changed"/>
                                            </StackPanel>
                                            <StackPanel x:Name="JoyConStickPanel" Orientation="Horizontal" Margin="0,10,0,0">
                                                <TextBlock Text="Mouvement du stick" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <ComboBox x:Name="JoyConStickBox" Width="220" SelectionChanged="JoyConStick_Changed"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DockPanel>
                                </Grid>
                                <!-- Widget sélectionné dans l'aperçu : tous ses réglages pour la Switch (éditeur de Personnaliser emprunté) -->
                                <Grid x:Name="DeckWidgetInspector" Visibility="Collapsed" Panel.ZIndex="4" Background="{StaticResource CardBg}" Height="380">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <DockPanel Margin="0,0,0,10">
                                        <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Top">
                                            <Button Content="Reprendre l'apparence du bureau" Margin="0,0,8,6" Click="DeckWidgetCopyDesktop_Click"
                                                    ToolTip="Remplace l'apparence Switch de ce widget par celle du bureau"/>
                                            <Button Content="Retirer de l'écran" Style="{StaticResource DangerButton}" Margin="0,0,0,6" Click="DeckWidgetHide_Click"/>
                                        </WrapPanel>
                                        <StackPanel>
                                            <TextBlock Text="WIDGET" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource UiAccent}"/>
                                            <TextBlock x:Name="DeckWidgetTitle" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource UiText}" Margin="0,2,0,0"/>
                                            <DockPanel x:Name="DeckWidgetScaleRow" Margin="0,8,0,0" MaxWidth="420" HorizontalAlignment="Left">
                                                <TextBlock Text="Taille sur l'écran" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <TextBlock x:Name="DeckWidgetScaleText" DockPanel.Dock="Right" Width="44" TextAlignment="Right" VerticalAlignment="Center"
                                                           Foreground="{StaticResource Muted}" FontSize="12"/>
                                                <Slider x:Name="DeckWidgetScaleSlider" Minimum="0.2" Maximum="3" SmallChange="0.05" LargeChange="0.1" Width="220"
                                                        IsSnapToTickEnabled="True" TickFrequency="0.05" VerticalAlignment="Center" ValueChanged="DeckWidgetScale_Changed"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </DockPanel>
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="260"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Aperçu cliquable du widget : un élément cliqué affiche ses réglages à droite -->
                                        <ContentControl x:Name="DeckWidgetPreviewHost" Focusable="False"/>
                                        <ContentControl x:Name="DeckWidgetEditorHost" Grid.Column="1" Focusable="False"/>
                                    </Grid>
                                </Grid>
                                <TextBlock x:Name="DeckInspectorEmpty" Text="Sélectionne une tuile ou un widget dans l'aperçu pour le configurer."
                                           Foreground="{StaticResource Muted}" FontSize="12.5" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                <Grid x:Name="DeckInspector" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <!-- Page de réglages d'un plugin Stream Deck (Property Inspector), affichée par WebView2 -->
                                    <Border x:Name="DeckPluginPageHost" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,14,0,0" Visibility="Collapsed"
                                            BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Text="RÉGLAGES DU PLUGIN" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="0,0,0,8"/>
                                            <TextBlock x:Name="DeckPluginPageMessage" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Visibility="Collapsed"/>
                                            <ContentControl x:Name="DeckPluginPageSlot" Height="300" Focusable="False"/>
                                        </StackPanel>
                                    </Border>
                                    <!-- Aperçu de la tuile -->
                                    <Border x:Name="DeckInspectorTile" Width="76" Height="76" CornerRadius="14" VerticalAlignment="Top"
                                            Background="#1E2130" BorderBrush="{StaticResource InputBorder}" BorderThickness="1" Margin="0,0,16,0">
                                        <ContentControl x:Name="DeckInspectorIcon" Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Stretch">
                                        <TextBlock x:Name="DeckInspectorKind" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource UiAccent}"/>
                                        <TextBlock Text="Nom" Style="{StaticResource FieldLabel}" Margin="0,8,0,4"/>
                                        <TextBox x:Name="DeckInspectorName" HorizontalAlignment="Stretch" TextChanged="DeckInspectorName_Changed"/>
                                        <TextBlock x:Name="DeckInspectorDetail" FontSize="11.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis" MaxHeight="34" Margin="0,6,0,0"/>
                                        <StackPanel x:Name="DeckInspectorAppsSubpageRow" Margin="0,8,0,0">
                                            <TextBlock Text="Page du widget des tuiles" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="DeckInspectorAppsSubpageBox" SelectionChanged="DeckInspectorAppsSubpage_Changed"/>
                                        </StackPanel>
                                        <StackPanel x:Name="DeckInspectorJoyConMapRow" Margin="0,8,0,0" Visibility="Collapsed">
                                            <TextBlock Text="Bouton Joy-Con sur cette page" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="DeckInspectorJoyConMapBox" SelectionChanged="DeckInspectorJoyConMap_Changed"
                                                      ToolTip="Sur cette page, ce bouton commande cette flèche. Sur les autres pages, son action Joy-Con habituelle est conservée."/>
                                        </StackPanel>
                                        <CheckBox x:Name="DeckInspectorConfirm" Style="{StaticResource ToggleSwitch}" Content="Confirmer par un second appui"
                                                  Margin="0,8,0,0" Click="DeckInspectorConfirm_Click"/>
                                        <CheckBox x:Name="DeckInspectorShowName" Style="{StaticResource ToggleSwitch}" Content="Afficher le nom"
                                                  Margin="0,8,0,0" Click="DeckInspectorShowName_Click"
                                                  ToolTip="Afficher ou masquer le nom de cette tuile seulement, quel que soit le réglage de la page"/>
                                        <CheckBox x:Name="DeckInspectorOwnIconSize" Style="{StaticResource ToggleSwitch}" Content="Taille d'icône personnalisée"
                                                  Margin="0,8,0,0" Click="DeckInspectorOwnIconSize_Click"
                                                  ToolTip="Activé : cette icône a sa propre taille et ne suit plus la taille des icônes de la page"/>
                                        <DockPanel x:Name="DeckInspectorIconSizeRow" Margin="0,6,0,0" Visibility="Collapsed">
                                            <TextBlock x:Name="DeckInspectorIconSizeText" DockPanel.Dock="Right" Width="44" TextAlignment="Right" VerticalAlignment="Center"
                                                       Foreground="{StaticResource Muted}" FontSize="12"/>
                                            <Slider x:Name="DeckInspectorIconSizeSlider" Minimum="0.25" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                                                    IsSnapToTickEnabled="True" TickFrequency="0.05" VerticalAlignment="Center" ValueChanged="DeckInspectorIconSize_Changed"/>
                                        </DockPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="16,0,0,0" MinWidth="170" VerticalAlignment="Top">
                                        <Button x:Name="DeckInspectorEdit" Content="Configurer l'action…" Style="{StaticResource PrimaryButton}" Click="DeckTileEdit_Click"/>
                                        <Button x:Name="DeckInspectorIconButton" Content="Icône et couleurs…" Margin="0,8,0,0" Click="DeckAppIcon_Click"
                                                ToolTip="Icône, couleurs, taille, nom masqué, apparence quand la tuile est active"/>
                                        <UniformGrid Columns="3" Margin="0,8,0,0">
                                            <Button x:Name="DeckInspectorLeft" Content="&#xE76B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                    ToolTip="Échanger avec la case précédente" Margin="0,0,4,0" Click="DeckAppLeft_Click"/>
                                            <Button x:Name="DeckInspectorRight" Content="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                    ToolTip="Échanger avec la case suivante" Margin="2,0,2,0" Click="DeckAppRight_Click"/>
                                            <Button x:Name="DeckInspectorRemove" Content="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                    Style="{StaticResource DangerButton}" ToolTip="Retirer la tuile de la page" Margin="4,0,0,0" Click="DeckAppRemove_Click"/>
                                        </UniformGrid>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Panneau de droite : bibliothèque d'actions et réglages de la Switch -->
                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                  ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="False"
                                  Background="{StaticResource CardBorder}" Cursor="SizeWE"
                                  ToolTip="Faire glisser pour élargir ou réduire le panneau de droite"/>
                    <Border Grid.Column="2" Background="{StaticResource SidebarBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1,0,0,0">
                        <DockPanel>
                            <UniformGrid DockPanel.Dock="Top" Columns="2" Margin="14,4,14,10">
                                <RadioButton x:Name="SwitchTabActions" Content="Actions" Style="{StaticResource TabButton}" GroupName="SwitchPanel"
                                             IsChecked="True" Checked="SwitchPanelTab_Checked"/>
                                <RadioButton x:Name="SwitchTabSettings" Content="Réglages" Style="{StaticResource TabButton}" GroupName="SwitchPanel"
                                             Checked="SwitchPanelTab_Checked"/>
                            </UniformGrid>

                            <Grid>
                                <!-- Bibliothèque d'actions -->
                                <DockPanel x:Name="SwitchActionsPanel">
                                    <Border DockPanel.Dock="Top" Margin="14,0,14,8" Height="34" CornerRadius="8"
                                            Background="{StaticResource InputBg}" BorderBrush="{StaticResource InputBorder}" BorderThickness="1">
                                        <Grid>
                                            <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Foreground="{StaticResource Muted}"
                                                       VerticalAlignment="Center" Margin="11,0,0,0"/>
                                            <TextBox x:Name="DeckActionSearch" Background="Transparent" BorderThickness="0" Height="32" Padding="30,0,6,0"
                                                     TextChanged="DeckActionSearch_TextChanged"/>
                                            <TextBlock Text="Rechercher une action…" Foreground="{StaticResource Muted}" FontSize="12.5" IsHitTestVisible="False"
                                                       VerticalAlignment="Center" Margin="32,0,0,0"
                                                       Visibility="{Binding Text, ElementName=DeckActionSearch, Converter={StaticResource EmptyToVis}}"/>
                                        </Grid>
                                    </Border>
                                    <TextBlock DockPanel.Dock="Bottom" Text="Clic : ajoute à la première case libre · glisser : dépose sur la case voulue."
                                               FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="16,8,16,12"/>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel x:Name="DeckActionsList" Margin="8,0,8,0"/>
                                    </ScrollViewer>
                                </DockPanel>

                                <!-- Réglages de la Switch -->
                                <ScrollViewer x:Name="SwitchSettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled" Padding="14,0,14,20">
                                    <StackPanel>
                                        <!-- ===== Réglages de la page affichée ===== -->
                                        <TextBlock x:Name="PageLookTitle" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource UiText}"
                                                   Margin="2,4,0,2" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="Chaque page a ses propres tuiles, son fond et son horloge. Change de page sous l'aperçu pour régler les autres."
                                                   FontSize="11.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="2,0,0,8"/>
                                        <Button Content="Appliquer ce style à toutes les pages" HorizontalAlignment="Left" Margin="2,0,0,4"
                                                Click="DeckLookToAllPages_Click"
                                                ToolTip="Copie le style des tuiles, le fond et l'horloge de cette page sur toutes les autres (pas les tuiles ni les éléments)"/>

                                        <ContentControl Style="{StaticResource SectionHeader}" Content="Tuiles de la page"/>
                                        <Border Style="{StaticResource RowCard}" Padding="14,0"
                                                local:SettingsSearch.Keywords="tuiles taille icônes style verre 3d plat nom opacité fond transparence boutons page">
                                            <StackPanel Style="{StaticResource RowsPanel}">
                                                <controls:SettingRow Label="Style des tuiles" Stacked="True"
                                                                     Description="Verre 3D : boutons en relief façon Stream Deck, qui s'enfoncent à l'appui. À plat : fond uni du thème.">
                                                    <ComboBox x:Name="DeckTileStyleBox" SelectionChanged="DeckTileStyle_Changed">
                                                        <ComboBoxItem Content="Verre 3D"/>
                                                        <ComboBoxItem Content="À plat"/>
                                                    </ComboBox>
                                                </controls:SettingRow>
                                                <controls:SettingRow Label="Taille des tuiles" Stacked="True">
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}" Text="{Binding Value, ElementName=DeckTileSlider, StringFormat={}{0:0} px}"/>
                                                        <Slider x:Name="DeckTileSlider" Minimum="60" Maximum="240" ValueChanged="DeckSlider_Changed"/>
                                                    </DockPanel>
                                                </controls:SettingRow>
                                                <controls:SettingRow Label="Taille des icônes" Stacked="True"
                                                                     Description="À 100 %, l'icône remplit la tuile et le nom passe par-dessus. Chaque tuile peut avoir la sienne.">
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}" Text="{Binding Value, ElementName=DeckIconScaleSlider, Converter={StaticResource Percent}}"/>
                                                        <Slider x:Name="DeckIconScaleSlider" Minimum="0.25" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                                                                IsSnapToTickEnabled="True" TickFrequency="0.05" ValueChanged="DeckSlider_Changed"/>
                                                    </DockPanel>
                                                </controls:SettingRow>
                                                <controls:SettingRow Label="Afficher le nom des tuiles">
                                                    <CheckBox x:Name="DeckShowNamesCheck" Style="{StaticResource ToggleSwitch}" Margin="0"
                                                              Checked="DeckShowNames_Changed" Unchecked="DeckShowNames_Changed"/>
                                                </controls:SettingRow>
                                                <controls:SettingRow Label="Opacité du fond des tuiles" Stacked="True"
                                                                     Description="À 0 %, en verre 3D, seul le bord du bouton reste autour de l'icône.">
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}" Text="{Binding Value, ElementName=DeckAppsOpacitySlider, Converter={StaticResource Percent}}"/>
                                                        <Slider x:Name="DeckAppsOpacitySlider" Minimum="0" Maximum="1" ValueChanged="DeckSlider_Changed"/>
                                                    </DockPanel>
                                                </controls:SettingRow>
                                                <controls:SettingRow Label="Fond du widget des tuiles" Description="Un fond arrondi derrière toute la grille de tuiles.">
                                                    <StackPanel Orientation="Horizontal">
                                                        <controls:ColorSwatch x:Name="DeckAppsBackgroundSwatch" Content="Couleur" Margin="0,0,10,0"/>
                                                        <CheckBox x:Name="DeckAppsBackgroundCheck" Style="{StaticResource ToggleSwitch}" Margin="0" VerticalAlignment="Center"
                                                                  Click="DeckAppsBackground_Click"/>
                                                    </StackPanel>
                                                </controls:SettingRow>
                                                <controls:SettingRow x:Name="DeckAppsTextureRow" Label="Texture du fond" Stacked="True"
                                                                     Description="Donne l'aspect d'un vrai Stream Deck. « Ajouter… » copie une image dans tes textures.">
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right" Content="Ajouter…" Margin="8,0,0,0" Click="DeckAppsTextureAdd_Click"/>
                                                        <ComboBox x:Name="DeckAppsTextureBox" SelectionChanged="DeckAppsTexture_Changed"/>
                                                    </DockPanel>
                                                </controls:SettingRow>
                                                <controls:SettingRow x:Name="DeckAppsWellsRow" Label="Boutons encastrés"
                                                                     Description="Chaque bouton est enfoncé dans un creux du fond, comme sur un vrai Stream Deck.">
                                                    <CheckBox x:Name="DeckAppsWellsCheck" Style="{StaticResource ToggleSwitch}" Margin="0" Click="DeckAppsWells_Click"/>
                                                </controls:SettingRow>
                                                <controls:SettingRow x:Name="DeckAppsBackgroundOpacityRow" Label="Opacité du fond du widget" Stacked="True">
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}" Text="{Binding Value, ElementName=DeckAppsBackgroundOpacitySlider, Converter={StaticResource Percent}}"/>
                                                        <Slider x:Name="DeckAppsBackgroundOpacitySlider" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                                                                IsSnapToTickEnabled="True" TickFrequency="0.05" ValueChanged="DeckSlider_Changed"/>
                                                    </DockPanel>
                                                </controls:SettingRow>
                                            </StackPanel>
                                        </Border>

                                        <ContentControl Style="{StaticResource SectionHeader}" Content="Fond de la page"/>
                                        <Border Style="{StaticResource RowCard}" Padding="14,0" local:SettingsSearch.Keywords="fond image couleur assombrissement arrière-plan horloge opacité page">
                                            <StackPanel Style="{StaticResource RowsPanel}">
                                                <controls:SettingRow Label="Couleur de fond">
                                                    <controls:ColorSwatch x:Name="DeckBackgroundSwatch" Content="Couleur" Margin="0"/>
                                                </controls:SettingRow>
                                                <controls:SettingRow Label="Image de fond" Stacked="True">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="Choisir une image…" Style="{StaticResource PrimaryButton}" Click="DeckBackgroundImage_Click"/>
                                                        <Button Content="Retirer" Margin="8,0,0,0" Click="DeckBackgroundImageClear_Click"/>
                                                    </StackPanel>
                                                </controls:SettingRow>
                                                <controls:SettingRow Label="Assombrissement de l'image" Stacked="True">
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}" Text="{Binding Value, ElementName=DeckDimSlider, Converter={StaticResource Percent}}"/>
                                                        <Slider x:Name="DeckDimSlider" Minimum="0" Maximum="0.9" ValueChanged="DeckSlider_Changed"/>
                                                    </DockPanel>
                                                </controls:SettingRow>
                                                <controls:SettingRow Label="Opacité du fond de l'horloge" Stacked="True">
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}" Text="{Binding Value, ElementName=DeckClockOpacitySlider, Converter={StaticResource Percent}}"/>
                                                        <Slider x:Name="DeckClockOpacitySlider" Minimum="0" Maximum="1" ValueChanged="DeckSlider_Changed"/>
                                                    </DockPanel>
                                                </controls:SettingRow>
                                            </StackPanel>
                                        </Border>

                                        <ContentControl Style="{StaticResource SectionHeader}" Content="Éléments de la page"/>
                                        <Border Style="{StaticResource Card}" Padding="14,12" local:SettingsSearch.Title="Éléments de la page"
                                                local:SettingsSearch.Keywords="éléments horloge modules applications tuiles afficher masquer">
                                            <StackPanel>
                                                <ItemsControl x:Name="DeckElementsList">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Columns="2"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <!-- Interrupteur à gauche du nom ; un clic sur le nom bascule aussi l'interrupteur. -->
                                                            <Border Background="Transparent" Cursor="Hand" Margin="0,0,8,10" MouseLeftButtonUp="DeckElementLabel_Click">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <CheckBox Style="{StaticResource ToggleSwitch}" Margin="0"
                                                                              IsChecked="{Binding IsVisible, Mode=OneTime}" Tag="{Binding Id}"
                                                                              Checked="DeckElementCheck_Changed" Unchecked="DeckElementCheck_Changed"/>
                                                                    <TextBlock Text="{Binding Label}" FontSize="12.5" VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock x:Name="DeckEditorHint" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                                                           Text="Dans l'aperçu : glisser déplace, le coin redimensionne, Ctrl+clic sélectionne plusieurs éléments ; clic droit pour masquer."/>
                                            </StackPanel>
                                        </Border>

                                        <ContentControl Style="{StaticResource SectionHeader}" Content="Disposition de départ"/>
                                        <Border Style="{StaticResource RowCard}" Padding="14,0"
                                                local:SettingsSearch.Keywords="disposition modèle organisation alignement grille aimantation">
                                            <StackPanel Style="{StaticResource RowsPanel}">
                                                <controls:SettingRow Label="Appliquer une disposition" Stacked="True"
                                                                     Description="Réorganise les éléments visibles ; vous pourrez ensuite les déplacer et les redimensionner librement.">
                                                    <DockPanel>
                                                        <Button Content="Appliquer" DockPanel.Dock="Right" Margin="8,0,0,0"
                                                                Click="DeckLayoutPreset_Apply"/>
                                                        <ComboBox x:Name="DeckLayoutPresetBox" SelectedIndex="0">
                                                            <ComboBoxItem Content="Équilibrée" Tag="balanced"/>
                                                            <ComboBoxItem Content="Jeu" Tag="gaming"/>
                                                            <ComboBoxItem Content="Monitoring" Tag="monitoring"/>
                                                            <ComboBoxItem Content="Compacte" Tag="minimal"/>
                                                        </ComboBox>
                                                    </DockPanel>
                                                </controls:SettingRow>
                                                <controls:SettingRow Label="Grille et guides d'alignement">
                                                    <CheckBox x:Name="DeckSnapCheck" Style="{StaticResource ToggleSwitch}" Margin="0"
                                                              Checked="DeckSnap_Changed" Unchecked="DeckSnap_Changed"/>
                                                </controls:SettingRow>
                                                <controls:SettingRow Label="Transition entre les pages" Stacked="True">
                                                    <ComboBox x:Name="DeckTransitionStyleBox" SelectionChanged="DeckTransitionStyle_Changed">
                                                        <ComboBoxItem Content="Aucune" Tag="None"/>
                                                        <ComboBoxItem Content="Glissement" Tag="Slide"/>
                                                        <ComboBoxItem Content="Fondu" Tag="Fade"/>
                                                        <ComboBoxItem Content="Glissement et fondu" Tag="SlideFade"/>
                                                        <ComboBoxItem Content="Zoom doux" Tag="Zoom"/>
                                                    </ComboBox>
                                                </controls:SettingRow>
                                                <controls:SettingRow Label="Durée de la transition" Stacked="True">
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}"
                                                                   Text="{Binding Value, ElementName=DeckTransitionDurationSlider, StringFormat={}{0:0} ms}"/>
                                                        <Slider x:Name="DeckTransitionDurationSlider" Minimum="100" Maximum="1000"
                                                                SmallChange="50" LargeChange="100" TickFrequency="50"
                                                                IsSnapToTickEnabled="True" ValueChanged="DeckSlider_Changed"/>
                                                    </DockPanel>
                                                </controls:SettingRow>
                                                <controls:SettingRow Label="Accélération" Stacked="True">
                                                    <ComboBox x:Name="DeckTransitionEasingBox" SelectionChanged="DeckTransitionEasing_Changed">
                                                        <ComboBoxItem Content="Douce" Tag="Smooth"/>
                                                        <ComboBoxItem Content="Linéaire" Tag="Linear"/>
                                                    </ComboBox>
                                                </controls:SettingRow>
                                            </StackPanel>
                                        </Border>

                                        <ContentControl Style="{StaticResource SectionHeader}" Content="Nom et ordre de la page"/>
                                        <Border Style="{StaticResource RowCard}" Padding="14,0" local:SettingsSearch.Keywords="page nom renommer déplacer supprimer pages">
                                            <StackPanel Style="{StaticResource RowsPanel}">
                                                <controls:SettingRow Label="Nom de la page" Stacked="True">
                                                    <TextBox x:Name="DeckPageNameBox" TextChanged="DeckPageName_Changed"/>
                                                </controls:SettingRow>
                                                <Border Style="{StaticResource RowBorder}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="&#xE76B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" ToolTip="Déplacer la page vers la gauche" Click="DeckPageLeft_Click"/>
                                                        <Button Content="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" ToolTip="Déplacer la page vers la droite" Margin="6,0,0,0" Click="DeckPageRight_Click"/>
