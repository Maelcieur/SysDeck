                                <TextBlock Text="Aucune application connectée" Foreground="{StaticResource UiText}" FontSize="14"
                                           FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                <TextBlock Text="Ajoute OBS Studio, Twitch ou Voicemod pour créer des tuiles qui les pilotent depuis la Switch."
                                           Style="{StaticResource PageSubtitle}" TextAlignment="Center" HorizontalAlignment="Center"/>
