<local:TileEditorWindow x:Class="SysDeck.AddPluginTileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SysDeck"
        Title="SysDeck — Plugin"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="Segoe UI" Foreground="#E7E8EB" Background="#1A1B1F">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/SettingsStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <StackPanel Margin="20">
        <TextBlock x:Name="TitleText" Text="Ajouter une tuile de plugin" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBlock Text="Toucher la tuile envoie l'appui au plugin ; il peut changer le titre et l'image de la tuile en direct."
                   FontSize="11.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <TextBlock x:Name="StatusText" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,14"/>

        <TextBlock Text="Plugin" Style="{StaticResource FieldLabel}"/>
        <ComboBox x:Name="PluginBox" Margin="0,0,0,14" SelectionChanged="Plugin_Changed"/>

        <TextBlock Text="Action" Style="{StaticResource FieldLabel}"/>
        <ComboBox x:Name="ActionBox" Margin="0,0,0,4" SelectionChanged="Action_Changed"/>
        <TextBlock x:Name="ActionHint" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,14"/>

        <!-- Réglages de l'action, générés d'après le manifest du plugin -->
        <StackPanel x:Name="SettingsPanel"/>

        <TextBlock Text="Nom" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="NameBox" Margin="0,0,0,14" TextChanged="NameBox_TextChanged"/>

        <CheckBox x:Name="ConfirmCheck" Style="{StaticResource ToggleSwitch}" Content="Confirmer par un second appui" Margin="0,0,0,2"/>
        <TextBlock Text="Premier appui : la tuile devient rouge pendant 3 s ; il faut toucher une seconde fois pour agir."
                   FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,14"/>

        <TextBlock Text="Icône" Style="{StaticResource FieldLabel}"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <ContentControl x:Name="IconHost" Width="32" Height="32" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button Content="Icône…" Click="Icon_Click"/>
        </StackPanel>
        <TextBlock FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,20"
                   Text="Sans choix, la tuile prend l'icône de l'action fournie par le plugin. Une image envoyée par le plugin passe avant."/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Annuler" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button x:Name="AddButton" Content="Ajouter" Style="{StaticResource PrimaryButton}" Click="Add_Click"/>
        </StackPanel>
    </StackPanel>
</local:TileEditorWindow>
