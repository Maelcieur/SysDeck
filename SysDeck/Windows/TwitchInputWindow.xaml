<Window x:Class="SysDeck.TwitchInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SysDeck — Twitch"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Topmost="True"
        FontFamily="Segoe UI" Foreground="#E7E8EB" Background="#1A1B1F">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/SettingsStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <StackPanel Margin="20">
        <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>

        <TextBox x:Name="InputBox" TextWrapping="Wrap" AcceptsReturn="False" MinHeight="34" TextChanged="Input_TextChanged" KeyDown="Input_KeyDown"/>
        <TextBlock x:Name="CounterText" FontSize="11" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" Margin="0,4,0,0"/>

        <ListBox x:Name="ResultsList" Height="220" Margin="0,8,0,0" Visibility="Collapsed" DisplayMemberPath="Name"
                 MouseDoubleClick="Results_DoubleClick"/>

        <TextBlock x:Name="ErrorText" FontSize="12" Foreground="{StaticResource UiDanger}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Annuler" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"/>
            <Button x:Name="SubmitButton" Content="Envoyer" Style="{StaticResource PrimaryButton}" Click="Submit_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
