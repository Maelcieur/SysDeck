<Window x:Class="SysDeck.AddCustomShortcutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SysDeck — Raccourci personnalisé"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Background="#1A1B1F"
        Foreground="#E7E8EB"
        ResizeMode="CanMinimize">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/SettingsStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <StackPanel Margin="20">
        <TextBlock x:Name="TitleText" Text="Raccourci personnalisé" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>

        <TextBlock Text="Nom" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="NameBox" Margin="0,0,0,14"/>

        <TextBlock Text="Lien (exécutable, fichier, dossier, URL, protocole…)" Style="{StaticResource FieldLabel}"/>
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="LinkBox" Grid.Column="0" Margin="0,0,8,0" LostFocus="LinkBox_LostFocus"/>
            <Button Grid.Column="1" Content="Parcourir…" Click="BrowseLink_Click"/>
        </Grid>

        <TextBlock Text="Arguments (facultatif)" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="ArgumentsBox" Margin="0,0,0,14"/>

        <!-- Fenêtre ouverte depuis la barre du bureau : icône PNG à indiquer. -->
        <StackPanel x:Name="LegacyIconPanel">
            <TextBlock Text="Icône personnalisée (PNG, facultatif)" Style="{StaticResource FieldLabel}"/>
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="IconBox" Grid.Column="0" Margin="0,0,8,0"/>
                <Button Grid.Column="1" Content="Parcourir…" Click="BrowseIcon_Click"/>
            </Grid>
        </StackPanel>

        <!-- Fenêtre ouverte depuis les Paramètres › Switch : symbole, émoji ou image, sinon icône détectée du fichier. -->
        <StackPanel x:Name="ChooserIconPanel" Visibility="Collapsed">
            <TextBlock Text="Icône" Style="{StaticResource FieldLabel}"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <ContentControl x:Name="IconHost" Width="32" Height="32" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button Content="Icône…" Click="Icon_Click"/>
            </StackPanel>
            <TextBlock Text="Sans choix, l'icône du fichier ou du programme est utilisée." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,20"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Annuler" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button x:Name="AddButton" Content="Ajouter" Style="{StaticResource PrimaryButton}" Click="Add_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
