<UserControl x:Class="SysDeck.Widgets.RamWidgetContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SysDeck.Controls"
             Width="230">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Width="82" Height="82" controls:Movable.Key="ring">
            <controls:RadialGauge x:Name="LoadGauge" Thickness="7" ShowTicks="True"/>
            <StackPanel VerticalAlignment="Center" Margin="0,2,0,0">
                <TextBlock controls:TextPart.Key="load" Style="{StaticResource GaugeValueText}">
                    <Run x:Name="LoadValueRun" Text="--" FontSize="22"/><Run Text="%" FontSize="11" Foreground="{DynamicResource SubTextBrush}"/>
                </TextBlock>
                <TextBlock controls:TextPart.Key="loadLabel" Text="UTILISÉE" Style="{StaticResource GaugeLabelText}"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
            <StackPanel controls:Movable.Key="title" Orientation="Horizontal">
                <TextBlock controls:TextPart.Key="title" Text="MÉMOIRE (RAM)" Style="{StaticResource WidgetCaption}"/>
            </StackPanel>

            <UniformGrid controls:Movable.Key="tiles" Columns="2" Margin="0,8,0,0">
                <Border Style="{StaticResource StatTile}" Margin="0,0,4,0">
                    <StackPanel>
                        <TextBlock controls:TextPart.Key="used" x:Name="UsedText" Text="--" Style="{StaticResource GaugeValueText}" FontSize="16"/>
                        <TextBlock controls:TextPart.Key="usedLabel" Text="Go utilisés" Style="{StaticResource GaugeLabelText}" FontWeight="Normal" FontSize="9"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatTile}" Margin="4,0,0,0">
                    <StackPanel>
                        <TextBlock controls:TextPart.Key="free" x:Name="FreeText" Text="--" Style="{StaticResource GaugeValueText}" FontSize="16"/>
                        <TextBlock controls:TextPart.Key="freeLabel" Text="Go libres" Style="{StaticResource GaugeLabelText}" FontWeight="Normal" FontSize="9"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <TextBlock controls:TextPart.Key="total" x:Name="TotalText" controls:Movable.Key="total" Text="Total : -- Go" Style="{StaticResource SubText}" FontSize="10"
                       HorizontalAlignment="Center" Margin="0,6,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
