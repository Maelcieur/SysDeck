<UserControl x:Class="SysDeck.Widgets.PowerWidgetContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SysDeck.Controls"
             Width="270">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Puissance tirée à la prise : anneau 270° avec graduations -->
        <Grid Width="82" Height="82" VerticalAlignment="Top" controls:Movable.Key="ring">
            <controls:RadialGauge x:Name="WattsGauge" Thickness="7" ShowTicks="True" Maximum="600"/>
            <StackPanel VerticalAlignment="Center" Margin="0,2,0,0">
                <TextBlock controls:TextPart.Key="watts" Style="{StaticResource GaugeValueText}">
                    <Run x:Name="WattsValueRun" Text="--" FontSize="20"/><Run Text="W" FontSize="11" Foreground="{DynamicResource SubTextBrush}"/>
                </TextBlock>
                <TextBlock controls:TextPart.Key="wattsLabel" Text="PUISSANCE" Style="{StaticResource GaugeLabelText}"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
            <StackPanel controls:Movable.Key="title" Orientation="Horizontal">
                <TextBlock controls:TextPart.Key="title" Text="CONSOMMATION" Style="{StaticResource WidgetCaption}"/>
            </StackPanel>

            <!-- Coût depuis l'allumage du PC -->
            <StackPanel controls:Movable.Key="session" Margin="0,2,0,0">
                <TextBlock controls:TextPart.Key="session" x:Name="SessionCostText" Text="-- €" Style="{StaticResource GaugeValueText}"
                           FontSize="22" HorizontalAlignment="Left"/>
                <TextBlock controls:TextPart.Key="sessionLabel" x:Name="SessionLabelText" Text="depuis l'allumage" Style="{StaticResource SubText}"
                           FontSize="10" TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <UniformGrid controls:Movable.Key="tiles" Columns="2" Margin="0,8,0,0">
                <Border Style="{StaticResource StatTile}" Margin="0,0,4,0">
                    <StackPanel>
                        <TextBlock controls:TextPart.Key="today" x:Name="TodayText" Text="--" Style="{StaticResource GaugeValueText}" FontSize="15"/>
                        <TextBlock controls:TextPart.Key="todayLabel" Text="Aujourd'hui" Style="{StaticResource GaugeLabelText}" FontWeight="Normal" FontSize="9"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatTile}" Margin="4,0,0,0">
                    <StackPanel>
                        <TextBlock controls:TextPart.Key="month" x:Name="MonthText" Text="--" Style="{StaticResource GaugeValueText}" FontSize="15"/>
                        <TextBlock controls:TextPart.Key="monthLabel" Text="Ce mois-ci" Style="{StaticResource GaugeLabelText}" FontWeight="Normal" FontSize="9"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Heures d'utilisation du jour, réparties jour / soir -->
            <TextBlock controls:TextPart.Key="usageToday" x:Name="UsageTodayText" controls:Movable.Key="usageToday" Text="" Style="{StaticResource SubText}"
                       FontSize="10" HorizontalAlignment="Center" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>

            <!-- Depuis la première mise en service du PC -->
            <Border controls:Movable.Key="lifetime" Style="{StaticResource StatTile}" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock controls:TextPart.Key="lifetime" x:Name="LifetimeText" Text="--" Style="{StaticResource GaugeValueText}" FontSize="15"/>
                    <TextBlock controls:TextPart.Key="lifetimeLabel" x:Name="LifetimeLabelText" Text="Depuis la mise en service" Style="{StaticResource GaugeLabelText}"
                               FontWeight="Normal" FontSize="9" TextTrimming="CharacterEllipsis"/>
                    <TextBlock controls:TextPart.Key="usageLifetime" x:Name="UsageLifetimeText" Text="" Style="{StaticResource GaugeLabelText}"
                               FontWeight="Normal" FontSize="9" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock controls:TextPart.Key="projection" x:Name="ProjectionText" controls:Movable.Key="projection" Text="" Style="{StaticResource SubText}"
                       FontSize="10" HorizontalAlignment="Center" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
            <TextBlock controls:TextPart.Key="details" x:Name="DetailsText" controls:Movable.Key="details" Text="" Style="{StaticResource SubText}"
                       FontSize="9.5" HorizontalAlignment="Center" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                       ToolTip="« ~ » : valeur estimée (capteur indisponible). « autres » : carte mère, RAM, SSD, ventilateurs (forfait réglable)."/>
        </StackPanel>
    </Grid>
</UserControl>
