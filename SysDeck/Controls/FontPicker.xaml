<UserControl x:Class="SysDeck.Controls.FontPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Chaque police est affichée dans son propre style ; liste virtualisée (plusieurs centaines de polices). -->
        <ComboBox x:Name="Combo" MaxDropDownHeight="340" SelectionChanged="Combo_SelectionChanged"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <ComboBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel/>
                </ItemsPanelTemplate>
            </ComboBox.ItemsPanel>
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Display}" FontFamily="{Binding Family}" FontSize="13.5"
                               Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <Button x:Name="ImportButton" Grid.Column="1" Content="Importer…" Margin="8,0,0,0" Padding="12,0" Click="Import_Click"
                ToolTip="Ajouter une police à partir d'un fichier .ttf ou .otf (sans l'installer dans Windows)"/>
    </Grid>
</UserControl>
