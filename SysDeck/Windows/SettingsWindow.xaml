                <!-- ===== Page : Alertes ===== DataContext = réglages Alerts -->
                <ScrollViewer x:Name="PageAlerts" Grid.Row="1" Style="{StaticResource PageScroller}" Visibility="Collapsed">
                    <StackPanel x:Name="AlertsPanel">
                        <TextBlock Text="Alertes" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="SysDeck te prévient en bas à droite de l'écran quand un seuil est dépassé. Chaque alerte ne s'affiche qu'une fois par dépassement, puis se réarme quand la valeur redescend. Pas besoin que le module soit affiché."
                                   Style="{StaticResource PageSubtitle}"/>

                        <ContentControl Style="{StaticResource SectionHeader}" Content="Processeur"/>
                        <Border Style="{StaticResource RowCard}" local:SettingsSearch.Keywords="alerte cpu processeur température chaud surchauffe">
                            <StackPanel Style="{StaticResource RowsPanel}">
                                <controls:SettingRow Label="Prévenir quand le processeur chauffe"
                                                     Description="Après quelques secondes au-dessus du seuil, pour ignorer les pics brefs.">
                                    <CheckBox Style="{StaticResource ToggleSwitch}" Margin="0" IsChecked="{Binding CpuEnabled}"/>
                                </controls:SettingRow>
                                <controls:SettingRow Label="Température d'alerte" IsEnabled="{Binding CpuEnabled}">
                                    <DockPanel Width="260">
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}" Text="{Binding CpuTemperature, StringFormat={}{0:0} °C}"/>
                                        <Slider Minimum="50" Maximum="105" Value="{Binding CpuTemperature}" IsSnapToTickEnabled="True" TickFrequency="1"/>
                                    </DockPanel>
                                </controls:SettingRow>
                                <controls:SettingRow Label="Tester l'alerte" Description="Affiche une alerte d'exemple.">
                                    <Button Content="Tester" Tag="CpuTemperature" Click="TestAlert_Click"/>
                                </controls:SettingRow>
                            </StackPanel>
                        </Border>

                        <ContentControl Style="{StaticResource SectionHeader}" Content="Carte graphique"/>
                        <Border Style="{StaticResource RowCard}" local:SettingsSearch.Keywords="alerte gpu carte graphique température chaud surchauffe">
                            <StackPanel Style="{StaticResource RowsPanel}">
                                <controls:SettingRow Label="Prévenir quand la carte graphique chauffe"
                                                     Description="Après quelques secondes au-dessus du seuil, pour ignorer les pics brefs.">
                                    <CheckBox Style="{StaticResource ToggleSwitch}" Margin="0" IsChecked="{Binding GpuEnabled}"/>
                                </controls:SettingRow>
                                <controls:SettingRow Label="Température d'alerte" IsEnabled="{Binding GpuEnabled}">
                                    <DockPanel Width="260">
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}" Text="{Binding GpuTemperature, StringFormat={}{0:0} °C}"/>
                                        <Slider Minimum="50" Maximum="105" Value="{Binding GpuTemperature}" IsSnapToTickEnabled="True" TickFrequency="1"/>
                                    </DockPanel>
                                </controls:SettingRow>
                                <controls:SettingRow Label="Tester l'alerte" Description="Affiche une alerte d'exemple.">
                                    <Button Content="Tester" Tag="GpuTemperature" Click="TestAlert_Click"/>
                                </controls:SettingRow>
                            </StackPanel>
                        </Border>

                        <ContentControl Style="{StaticResource SectionHeader}" Content="Batterie de la souris"/>
                        <Border Style="{StaticResource RowCard}" local:SettingsSearch.Keywords="alerte souris batterie logitech charge faible">
                            <StackPanel Style="{StaticResource RowsPanel}">
                                <controls:SettingRow Label="Prévenir quand la batterie de la souris est faible"
                                                     Description="Jamais pendant la charge. Vérifiée toutes les 30 secondes.">
                                    <CheckBox Style="{StaticResource ToggleSwitch}" Margin="0" IsChecked="{Binding MouseEnabled}"/>
                                </controls:SettingRow>
                                <controls:SettingRow Label="Niveau d'alerte" IsEnabled="{Binding MouseEnabled}">
                                    <DockPanel Width="260">
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}" Text="{Binding MousePercent, StringFormat={}{0:0} %}"/>
                                        <Slider Minimum="5" Maximum="50" Value="{Binding MousePercent}" IsSnapToTickEnabled="True" TickFrequency="1"/>
                                    </DockPanel>
                                </controls:SettingRow>
                                <controls:SettingRow Label="Tester l'alerte" Description="Affiche une alerte d'exemple.">
                                    <Button Content="Tester" Tag="MouseBattery" Click="TestAlert_Click"/>
                                </controls:SettingRow>
                            </StackPanel>
                        </Border>

                        <ContentControl Style="{StaticResource SectionHeader}" Content="Quota Claude"/>
                        <Border Style="{StaticResource RowCard}" local:SettingsSearch.Keywords="alerte claude quota session semaine limite usage">
                            <StackPanel Style="{StaticResource RowsPanel}">
                                <controls:SettingRow Label="Prévenir pour la session de 5 h"
                                                     Description="Lu toutes les 2 minutes auprès de Claude Code.">
                                    <CheckBox Style="{StaticResource ToggleSwitch}" Margin="0" IsChecked="{Binding ClaudeSessionEnabled}"/>
                                </controls:SettingRow>
                                <controls:SettingRow Label="Prévenir à partir de" IsEnabled="{Binding ClaudeSessionEnabled}">
                                    <DockPanel Width="260">
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}" Text="{Binding ClaudeSessionPercent, StringFormat={}{0:0} %}"/>
                                        <Slider Minimum="10" Maximum="100" Value="{Binding ClaudeSessionPercent}" IsSnapToTickEnabled="True" TickFrequency="5"/>
                                    </DockPanel>
                                </controls:SettingRow>
                                <controls:SettingRow Label="Tester l'alerte de session" Description="Affiche une alerte d'exemple.">
                                    <Button Content="Tester" Tag="ClaudeSession" Click="TestAlert_Click"/>
                                </controls:SettingRow>
                                <controls:SettingRow Label="Prévenir pour le quota de la semaine">
                                    <CheckBox Style="{StaticResource ToggleSwitch}" Margin="0" IsChecked="{Binding ClaudeWeekEnabled}"/>
                                </controls:SettingRow>
                                <controls:SettingRow Label="Prévenir à partir de" IsEnabled="{Binding ClaudeWeekEnabled}">
                                    <DockPanel Width="260">
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}" Text="{Binding ClaudeWeekPercent, StringFormat={}{0:0} %}"/>
                                        <Slider Minimum="10" Maximum="100" Value="{Binding ClaudeWeekPercent}" IsSnapToTickEnabled="True" TickFrequency="5"/>
                                    </DockPanel>
                                </controls:SettingRow>
                                <controls:SettingRow Label="Tester l'alerte de la semaine" Description="Affiche une alerte d'exemple.">
                                    <Button Content="Tester" Tag="ClaudeWeek" Click="TestAlert_Click"/>
                                </controls:SettingRow>
                            </StackPanel>
                        </Border>

                        <ContentControl Style="{StaticResource SectionHeader}" Content="Apparence des alertes"/>
                        <Border Style="{StaticResource RowCard}" local:SettingsSearch.Keywords="alerte apparence couleur transparence opacité fond arrondi position coin taille contour ombre">
                            <StackPanel Style="{StaticResource RowsPanel}">
                                <controls:SettingRow Label="Couleur du fond">
                                    <controls:ColorSwatch Content="Fond" Hex="{Binding BackgroundColor}" Margin="0"/>
                                </controls:SettingRow>
                                <controls:SettingRow Label="Opacité du fond">
                                    <DockPanel Width="260">
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}" Text="{Binding BackgroundOpacity, Converter={StaticResource Percent}}"/>
                                        <Slider Minimum="0.2" Maximum="1" Value="{Binding BackgroundOpacity}" IsSnapToTickEnabled="True" TickFrequency="0.01"/>
                                    </DockPanel>
                                </controls:SettingRow>
                                <controls:SettingRow Label="Arrondi des coins">
                                    <DockPanel Width="260">
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}" Text="{Binding CornerRadius, StringFormat={}{0:0} px}"/>
                                        <Slider Minimum="0" Maximum="30" Value="{Binding CornerRadius}" IsSnapToTickEnabled="True" TickFrequency="1"/>
                                    </DockPanel>
                                </controls:SettingRow>
                                <controls:SettingRow Label="Taille">
                                    <DockPanel Width="260">
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}" Text="{Binding Scale, Converter={StaticResource Percent}}"/>
                                        <Slider Minimum="0.7" Maximum="1.5" Value="{Binding Scale}" IsSnapToTickEnabled="True" TickFrequency="0.05"/>
                                    </DockPanel>
                                </controls:SettingRow>
                                <controls:SettingRow Label="Couleur selon le type d'alerte"
                                                     Description="Orange (température), jaune (souris), violet (Claude), rouge si critique. Sinon, ta couleur.">
                                    <CheckBox Style="{StaticResource ToggleSwitch}" Margin="0" IsChecked="{Binding AutoAccent}"/>
                                </controls:SettingRow>
                                <controls:SettingRow Label="Couleur des alertes" IsEnabled="{Binding AutoAccent, Converter={StaticResource InverseBool}}">
                                    <controls:ColorSwatch Content="Couleur" Hex="{Binding AccentColor}" Margin="0"/>
                                </controls:SettingRow>
                                <controls:SettingRow Label="Contour coloré">
                                    <CheckBox Style="{StaticResource ToggleSwitch}" Margin="0" IsChecked="{Binding ShowBorder}"/>
                                </controls:SettingRow>
                                <controls:SettingRow Label="Ombre et halo lumineux">
                                    <CheckBox Style="{StaticResource ToggleSwitch}" Margin="0" IsChecked="{Binding ShowGlow}"/>
                                </controls:SettingRow>
                                <controls:SettingRow Label="Position à l'écran" Stacked="True">
                                    <WrapPanel>
                                        <RadioButton Style="{StaticResource Chip}" Content="En bas à droite" IsChecked="{Binding Position, Converter={StaticResource Equals}, ConverterParameter=BottomRight}"/>
                                        <RadioButton Style="{StaticResource Chip}" Content="En haut à droite" IsChecked="{Binding Position, Converter={StaticResource Equals}, ConverterParameter=TopRight}"/>
                                        <RadioButton Style="{StaticResource Chip}" Content="En bas à gauche" IsChecked="{Binding Position, Converter={StaticResource Equals}, ConverterParameter=BottomLeft}"/>
                                        <RadioButton Style="{StaticResource Chip}" Content="En haut à gauche" IsChecked="{Binding Position, Converter={StaticResource Equals}, ConverterParameter=TopLeft}"/>
                                    </WrapPanel>
                                </controls:SettingRow>
                                <controls:SettingRow Label="Aperçu de l'apparence" Description="Affiche une alerte d'exemple avec ces réglages.">
                                    <Button Content="Aperçu" Style="{StaticResource PrimaryButton}" Tag="CpuTemperature" Click="TestAlert_Click"/>
                                </controls:SettingRow>
                                <controls:SettingRow Label="Valeurs d'origine" Description="Remet l'apparence des alertes par défaut.">
                                    <Button Content="Réinitialiser" Click="ResetAlertLook_Click"/>
                                </controls:SettingRow>
                            </StackPanel>
                        </Border>

                        <ContentControl Style="{StaticResource SectionHeader}" Content="Affichage"/>
                        <Border Style="{StaticResource RowCard}" local:SettingsSearch.Keywords="alerte son durée notification">
                            <StackPanel Style="{StaticResource RowsPanel}">
                                <controls:SettingRow Label="Jouer un son avec l'alerte">
                                    <CheckBox Style="{StaticResource ToggleSwitch}" Margin="0" IsChecked="{Binding SoundEnabled}"/>
                                </controls:SettingRow>
                                <controls:SettingRow Label="Durée d'affichage" Description="Reste affichée tant que la souris est dessus.">
                                    <DockPanel Width="260">
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}" Text="{Binding DurationSeconds, StringFormat={}{0:0} s}"/>
                                        <Slider Minimum="3" Maximum="30" Value="{Binding DurationSeconds}" IsSnapToTickEnabled="True" TickFrequency="1"/>
                                    </DockPanel>
                                </controls:SettingRow>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== Page : Correction de texte ===== -->
                <ScrollViewer x:Name="PageCorrection" Grid.Row="1" Style="{StaticResource PageScroller}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Correction de texte" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Sélectionne du texte dans n'importe quelle fenêtre puis appuie sur CTRL+ESPACE pour le corriger via l'API Gemini."
                                   Style="{StaticResource PageSubtitle}"/>
                        <ContentControl Style="{StaticResource SectionHeader}" Content="Clé API Gemini"/>
                        <Border Style="{StaticResource RowCard}" local:SettingsSearch.Keywords="gemini google api clé correction orthographe ia">
                            <StackPanel Style="{StaticResource RowsPanel}">
                                <controls:SettingRow Label="Clé API Gemini" Description="Nécessaire pour corriger le texte sélectionné.">
