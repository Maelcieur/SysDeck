<Window x:Class="SysDeck.AddTwitchTileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SysDeck — Twitch"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="Segoe UI" Foreground="#E7E8EB" Background="#1A1B1F">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/SettingsStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <StackPanel Margin="20">
        <TextBlock x:Name="TitleText" Text="Ajouter une tuile Twitch" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBlock Text="Toucher la tuile agit sur ta chaîne Twitch. L'état des modes du tchat s'affiche en direct sur la tuile."
                   FontSize="11.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <TextBlock x:Name="StatusText" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,14"/>

        <TextBlock Text="Action" Style="{StaticResource FieldLabel}"/>
        <ComboBox x:Name="ActionBox" Margin="0,0,0,14" SelectionChanged="Action_Changed"/>

        <StackPanel x:Name="AskRow">
            <TextBlock Text="Texte" Style="{StaticResource FieldLabel}"/>
            <WrapPanel>
                <RadioButton x:Name="AskModeRadio" Style="{StaticResource Chip}" GroupName="TwitchTextMode" Content="Demander sur la Switch" Checked="AskMode_Changed"/>
                <RadioButton x:Name="FixedModeRadio" Style="{StaticResource Chip}" GroupName="TwitchTextMode" Content="Texte fixe" Checked="AskMode_Changed"/>
            </WrapPanel>
            <TextBlock x:Name="AskHint" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,14"
                       Text="À l'appui, un clavier s'ouvre sur la Switch (avec tes émotes Twitch et les émojis) ; depuis le bureau, une petite fenêtre s'ouvre sur le PC."/>
        </StackPanel>

        <StackPanel x:Name="TextRow">
            <TextBlock x:Name="TextLabel" Text="Message" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="TextBoxValue" Margin="0,0,0,14" TextChanged="Text_TextChanged"/>
        </StackPanel>

        <StackPanel x:Name="DurationRow">
            <TextBlock Text="Durée de la pub" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="DurationBox" Margin="0,0,0,14" SelectionChanged="Duration_Changed"/>
        </StackPanel>

        <StackPanel x:Name="CategoryRow">
            <TextBlock Text="Catégorie" Style="{StaticResource FieldLabel}"/>
            <TextBlock x:Name="CategoryCurrent" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"/>
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="CategoryQuery" KeyDown="CategoryQuery_KeyDown"/>
                <Button x:Name="CategorySearchButton" Grid.Column="1" Content="Rechercher" Margin="8,0,0,0" Click="CategorySearch_Click"/>
            </Grid>
            <ComboBox x:Name="CategoryResults" Margin="0,0,0,14" Visibility="Collapsed" SelectionChanged="CategoryResults_Changed"/>
        </StackPanel>

        <TextBlock Text="Nom" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="NameBox" Margin="0,0,0,14" TextChanged="NameBox_TextChanged"/>

        <CheckBox x:Name="ConfirmCheck" Style="{StaticResource ToggleSwitch}" Content="Confirmer par un second appui" Margin="0,0,0,2" Click="Confirm_Click"/>
        <TextBlock Text="Premier appui : la tuile devient rouge pendant 3 s ; il faut toucher une seconde fois pour agir."
                   FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,14"/>

        <TextBlock Text="Icône" Style="{StaticResource FieldLabel}"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <ContentControl x:Name="IconHost" Width="32" Height="32" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button Content="Icône…" Click="Icon_Click"/>
        </StackPanel>
        <TextBlock FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,20"
                   Text="Sans choix, l'icône suit l'action. Les tuiles des modes du tchat s'allument quand le mode est actif."/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Annuler" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button x:Name="AddButton" Content="Ajouter" Style="{StaticResource PrimaryButton}" Click="Add_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
