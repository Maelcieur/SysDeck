                </ScrollViewer>

                <!-- ===== Page : Mode console (TV, audio, bibliothèque de jeux et émulateurs) ===== -->
                <ScrollViewer x:Name="PageConsole" Grid.Row="1" Style="{StaticResource PageScroller}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Mode console" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Bascule le PC sur la TV avec une interface manette : seule la TV reste affichée, le son suit, et tout est remis à la sortie."
                                   Style="{StaticResource PageSubtitle}"/>

                        <ContentControl Style="{StaticResource SectionHeader}" Content="Télévision"/>
                        <Border Style="{StaticResource RowCard}" local:SettingsSearch.Title="Télévision et son"
                                local:SettingsSearch.Keywords="mode console tv télévision écran hdmi sortie audio son désactiver actualiser">
                            <StackPanel Style="{StaticResource RowsPanel}">
                                <controls:SettingRow Label="Écran de la TV"
                                                     Description="Les écrans inactifs (TV éteinte ou désactivée dans Windows) sont listés aussi.">
                                    <StackPanel Orientation="Horizontal">
                                        <ComboBox x:Name="ConsoleTvCombo" Width="280" SelectionChanged="ConsoleTv_Changed"/>
                                        <Button x:Name="ConsoleTvRefreshButton" Content="Actualiser" Margin="8,0,0,0" Click="ConsoleTvRefresh_Click"/>
                                    </StackPanel>
                                </controls:SettingRow>
                                <controls:SettingRow Label="Sortie audio de la TV"
                                                     Description="Devient la sortie par défaut pendant le mode console, puis l'ancienne est rétablie.">
                                    <ComboBox x:Name="ConsoleAudioCombo" Width="280" SelectionChanged="ConsoleAudio_Changed"/>
                                </controls:SettingRow>
                                <controls:SettingRow Label="Désactiver la TV hors mode console"
                                                     Description="La TV disparaît de Windows (plus de fenêtres perdues dessus) et revient à l'entrée du mode.">
                                    <CheckBox x:Name="ConsoleDisableTvCheck" Style="{StaticResource ToggleSwitch}" Margin="0"
                                              Checked="ConsoleDisableTv_Changed" Unchecked="ConsoleDisableTv_Changed"/>
                                </controls:SettingRow>
                                <Border Style="{StaticResource RowBorder}" BorderThickness="0">
                                    <TextBlock x:Name="ConsoleTvStatus" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" Margin="0"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <ContentControl Style="{StaticResource SectionHeader}" Content="TV et manette"/>
                        <Border Style="{StaticResource RowCard}" local:SettingsSearch.Title="Allumer la TV et volume par le réseau"
                                local:SettingsSearch.Keywords="mode console tv allumer éteindre veille volume réseau google tv appairer appairage manette combinaison">
                            <StackPanel Style="{StaticResource RowsPanel}">
                                <controls:SettingRow Label="TV Google TV sur le réseau"
                                                     Description="Pour allumer, éteindre et régler le volume de la TV. Allume la TV, clique sur « Rechercher », puis « Appairer » : un code s'affiche sur la TV.">
                                    <StackPanel Orientation="Horizontal">
                                        <ComboBox x:Name="ConsoleTvHostBox" Width="220" IsEditable="True"/>
                                        <Button x:Name="ConsoleTvFindButton" Content="Rechercher" Margin="8,0,0,0" Click="ConsoleTvFind_Click"/>
                                        <Button x:Name="ConsoleTvPairButton" Content="Appairer" Margin="8,0,0,0" Click="ConsoleTvPair_Click"/>
                                    </StackPanel>
                                </controls:SettingRow>
                                <Border x:Name="ConsoleTvCodePanel" Style="{StaticResource RowBorder}" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Code affiché sur la TV :" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBox x:Name="ConsoleTvCodeBox" Width="110" MaxLength="6" CharacterCasing="Upper" FontFamily="Consolas" FontSize="16"/>
                                        <Button Content="Valider" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="ConsoleTvCode_Click"/>
                                        <Button Content="Annuler" Margin="8,0,0,0" Click="ConsoleTvCodeCancel_Click"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource RowBorder}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="ConsoleTvRemoteStatus" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" Margin="0" VerticalAlignment="Center"/>
                                        <Button x:Name="ConsoleTvForgetButton" Content="Oublier" Style="{StaticResource LinkButton}" Margin="10,0,0,0" Click="ConsoleTvForget_Click"/>
                                    </StackPanel>
                                </Border>
                                <controls:SettingRow Label="Entrée HDMI du PC"
                                                     Description="Le port HDMI de la TV où est branché le PC : la TV y passe toute seule en mode console. Si « Tester » ne change pas d'entrée, utilise « Trouver la méthode » (chaque marque de TV a la sienne).">
                                    <StackPanel Orientation="Horizontal">
                                        <ComboBox x:Name="ConsoleTvHdmiBox" Width="140" SelectionChanged="ConsoleTvHdmi_Changed">
                                            <ComboBoxItem Content="Ne pas changer" Tag="0"/>
                                            <ComboBoxItem Content="HDMI 1" Tag="1"/>
                                            <ComboBoxItem Content="HDMI 2" Tag="2"/>
                                            <ComboBoxItem Content="HDMI 3" Tag="3"/>
                                            <ComboBoxItem Content="HDMI 4" Tag="4"/>
                                        </ComboBox>
                                        <Button Content="Tester" Margin="8,0,0,0" Click="ConsoleTvHdmiTest_Click"/>
                                        <Button Content="Trouver la méthode…" Margin="8,0,0,0" Click="ConsoleTvWizard_Click"/>
                                    </StackPanel>
                                </controls:SettingRow>
                                <Border x:Name="ConsoleTvWizardPanel" Style="{StaticResource RowBorder}" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock x:Name="ConsoleTvWizardText" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="ConsoleTvWizardYes" Content="Oui, c'est la bonne" Style="{StaticResource PrimaryButton}" Click="ConsoleTvWizardYes_Click"/>
                                            <Button x:Name="ConsoleTvWizardNo" Content="Non, essai suivant" Margin="8,0,0,0" Click="ConsoleTvWizardNo_Click"/>
                                            <Button Content="Annuler" Margin="8,0,0,0" Click="ConsoleTvWizardCancel_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <controls:SettingRow Label="Allumer la TV en entrant en mode console"
                                                     Description="La TV s'allume toute seule (TV appairée, « Wake on Wireless LAN » activé sur la TV).">
                                    <CheckBox x:Name="ConsoleTvAutoPowerCheck" Style="{StaticResource ToggleSwitch}" Margin="0"
                                              Checked="ConsoleTvAutoPower_Changed" Unchecked="ConsoleTvAutoPower_Changed"/>
                                </controls:SettingRow>
                                <controls:SettingRow Label="Éteindre la TV en revenant au PC"
                                                     Description="La TV se met en veille quand tu quittes le mode console (TV appairée).">
                                    <CheckBox x:Name="ConsoleTvAutoOffCheck" Style="{StaticResource ToggleSwitch}" Margin="0"
                                              Checked="ConsoleTvAutoOff_Changed" Unchecked="ConsoleTvAutoOff_Changed"/>
                                </controls:SettingRow>
                                <controls:SettingRow Label="Lancer le mode console avec la manette"
                                                     Description="Appuie en même temps sur ces boutons de la manette Xbox, depuis le PC. En mode console (menu et jeux), View ⧉ + LT / RT règlent le volume.">
                                    <ComboBox x:Name="ConsoleComboBox" Width="300" SelectionChanged="ConsoleCombo_Changed"/>
                                </controls:SettingRow>
                            </StackPanel>
                        </Border>

                        <ContentControl Style="{StaticResource SectionHeader}" Content="Lancement"/>
                        <Border Style="{StaticResource RowCard}" local:SettingsSearch.Title="Lancer le mode console"
                                local:SettingsSearch.Keywords="mode console lancer quitter raccourci de secours urgence tv manette">
                            <StackPanel Style="{StaticResource RowsPanel}">
                                <controls:SettingRow Label="Mode console"
                                                     Description="Tu peux aussi ajouter la tuile « Mode console » à la Switch (Switch › Système).">
                                    <Button x:Name="ConsoleLaunchButton" Content="Lancer le mode console" Style="{StaticResource PrimaryButton}"
                                            Click="ConsoleLaunch_Click"/>
                                </controls:SettingRow>
                                <controls:SettingRow Label="Raccourci de secours"
                                                     Description="Quitte le mode console depuis n'importe où (clavier). Clique dans la zone puis appuie sur la combinaison.">
                                    <StackPanel Orientation="Horizontal">
                                        <controls:HotkeyBox x:Name="ConsoleHotkeyBox" Width="200" Style="{StaticResource {x:Type TextBox}}"
                                                            GestureCaptured="ConsoleHotkeyBox_GestureCaptured" CaptureStateChanged="ConsoleHotkeyBox_CaptureStateChanged"/>
                                        <Button Content="Par défaut" Margin="8,0,0,0" Click="ConsoleHotkeyReset_Click"/>
                                    </StackPanel>
                                </controls:SettingRow>
                                <Border Style="{StaticResource RowBorder}" BorderThickness="0">
                                    <TextBlock x:Name="ConsoleHotkeyStatus" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" Margin="0"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <ContentControl Style="{StaticResource SectionHeader}" Content="Apparence de la console"/>
                        <Border Style="{StaticResource RowCard}" local:SettingsSearch.Title="Thème et intro du mode console"
                                local:SettingsSearch.Keywords="mode console thème apparence couleurs intro animation lancement logo son aperçu">
                            <StackPanel Style="{StaticResource RowsPanel}">
                                <Border Style="{StaticResource RowBorder}">
                                    <StackPanel>
                                        <TextBlock Text="Thème de l'interface TV" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="ConsoleThemeName" Style="{StaticResource PageSubtitle}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                                        <WrapPanel x:Name="ConsoleThemeGallery"/>
                                    </StackPanel>
                                </Border>
                                <controls:SettingRow Label="Aperçu"
                                                     Description="Ouvre l'interface ou l'intro sur cet écran (Échap ou « Retour au PC » pour fermer). Dans la console, le bouton Menu ☰ ouvre aussi les thèmes.">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Aperçu de l'interface" Click="ConsolePreviewUi_Click"/>
                                        <Button Content="Voir l'intro" Margin="8,0,0,0" Click="ConsolePreviewIntro_Click"/>
                                    </StackPanel>
                                </controls:SettingRow>
                                <controls:SettingRow Label="Style de l'intro et des bruitages"
                                                     Description="Cyberpunk par défaut. Automatique : cyberpunk avec le thème Néon glitch, élégant avec les autres thèmes.">
                                    <ComboBox x:Name="ConsoleIntroStyleBox" Width="200" SelectionChanged="ConsoleIntroStyle_Changed">
                                        <ComboBoxItem Content="Automatique" Tag="auto"/>
                                        <ComboBoxItem Content="Élégant" Tag="elegant"/>
                                        <ComboBoxItem Content="Cyberpunk" Tag="cyber"/>
                                    </ComboBox>
                                </controls:SettingRow>
                                <controls:SettingRow Label="Bruitages"
                                                     Description="Petits sons quand tu te déplaces, valides, reviens en arrière ou lances un jeu (sur la sortie son de la TV).">
                                    <CheckBox x:Name="ConsoleSoundsCheck" Style="{StaticResource ToggleSwitch}" Margin="0"
                                              Checked="ConsoleSounds_Changed" Unchecked="ConsoleSounds_Changed"/>
                                </controls:SettingRow>
                                <controls:SettingRow Label="Vibrations de la manette"
                                                     Description="Légère en te déplaçant, plus marquée en validant, forte au lancement d'un jeu (manette Xbox).">
                                    <CheckBox x:Name="ConsoleVibrationCheck" Style="{StaticResource ToggleSwitch}" Margin="0"
                                              Checked="ConsoleVibration_Changed" Unchecked="ConsoleVibration_Changed"/>
                                </controls:SettingRow>
                                <controls:SettingRow Label="Animation de lancement"
                                                     Description="Intro de 10 s avec son à l'entrée en mode console (A ou Entrée pour la passer).">
                                    <CheckBox x:Name="ConsoleIntroCheck" Style="{StaticResource ToggleSwitch}" Margin="0"
                                              Checked="ConsoleIntro_Changed" Unchecked="ConsoleIntro_Changed"/>
                                </controls:SettingRow>
                                <controls:SettingRow Label="Intro personnalisée (facultatif)"
                                                     Description="Dossier d'images et de vidéos jouées dans l'ordre du nom : image + son du même nom (01.png + 01.wav) ou vidéo avec son son (02.mp4). Vide = intro SysDeck.">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox x:Name="ConsoleIntroFolderBox" Width="220" IsReadOnly="True"/>
                                        <Button Content="Parcourir…" Margin="8,0,0,0" Click="ConsoleIntroBrowse_Click"/>
                                        <Button Content="Effacer" Margin="8,0,0,0" Click="ConsoleIntroClear_Click"/>
                                    </StackPanel>
                                </controls:SettingRow>
                            </StackPanel>
                        </Border>

                        <ContentControl Style="{StaticResource SectionHeader}" Content="Jaquettes"/>
                        <Border Style="{StaticResource RowCard}" local:SettingsSearch.Title="Clé SteamGridDB"
                                local:SettingsSearch.Keywords="steamgriddb clé api jaquette fond logo images recherche émulateur">
                            <StackPanel Style="{StaticResource RowsPanel}">
                                <controls:SettingRow Label="Clé SteamGridDB (facultative)"
                                                     Description="Améliore la recherche d'images, nécessaire pour les jeux d'émulateur. Enregistrée chiffrée pour ton compte Windows.">
                                    <StackPanel Orientation="Horizontal">
                                        <PasswordBox x:Name="ConsoleGridKeyBox" Width="240" LostFocus="ConsoleGridKey_LostFocus"/>
                                        <Button Content="Obtenir une clé" Style="{StaticResource LinkButton}" Margin="8,0,0,0" Click="ConsoleGridKeyLink_Click"/>
                                    </StackPanel>
                                </controls:SettingRow>
                            </StackPanel>
                        </Border>

                        <ContentControl Style="{StaticResource SectionHeader}" Content="Jeux"/>
                        <Border Style="{StaticResource RowCard}" local:SettingsSearch.Title="Jeux du mode console"
                                local:SettingsSearch.Keywords="jeux bibliothèque ajouter modifier supprimer steam exécutable lien émulateur rom jaquette plateforme">
                            <StackPanel Style="{StaticResource RowsPanel}">
                                <Border Style="{StaticResource RowBorder}">
                                    <Button Content="+ Ajouter un jeu" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="ConsoleGameAdd_Click"/>
                                </Border>
                                <TextBlock x:Name="ConsoleGamesEmpty" Style="{StaticResource PageSubtitle}" Margin="0,12" Text="Aucun jeu pour le moment."/>
                                <StackPanel x:Name="ConsoleGamesList"/>
                            </StackPanel>
                        </Border>

                        <ContentControl Style="{StaticResource SectionHeader}" Content="Émulateurs"/>
                        <Border Style="{StaticResource RowCard}" local:SettingsSearch.Title="Émulateurs"
                                local:SettingsSearch.Keywords="émulateurs retroarch dolphin pcsx2 duckstation ppsspp rpcs3 cemu ryujinx yuzu xemu mgba arguments core">
                            <StackPanel Style="{StaticResource RowsPanel}">
                                <Border Style="{StaticResource RowBorder}">
                                    <Button Content="+ Ajouter un émulateur" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="ConsoleEmulatorAdd_Click"/>
                                </Border>
                                <TextBlock x:Name="ConsoleEmulatorsEmpty" Style="{StaticResource PageSubtitle}" Margin="0,12" Text="Aucun émulateur configuré."/>
                                <StackPanel x:Name="ConsoleEmulatorsList"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== Page : Plugins (onglets : installés / catalogue GitHub) ===== -->
                <ScrollViewer x:Name="PagePlugins" Grid.Row="1" Style="{StaticResource PageScroller}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Plugins" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Les plugins ajoutent de nouvelles actions de tuiles : plugins SysDeck, et plugins du Stream Deck d'Elgato publiés en open source. Chacun est un petit programme lancé par SysDeck."
                                   Style="{StaticResource PageSubtitle}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,4">
                            <RadioButton x:Name="PluginsTabInstalled" Content="Installés" Style="{StaticResource TabButton}" GroupName="PluginsTabs"
                                         IsChecked="True" Checked="PluginsTab_Checked" MinWidth="120"/>
                            <RadioButton x:Name="PluginsTabCatalog" Content="Catalogue" Style="{StaticResource TabButton}" GroupName="PluginsTabs"
                                         Checked="PluginsTab_Checked" MinWidth="120"/>
                        </StackPanel>

                        <!-- Plugins installés -->
                        <StackPanel x:Name="PluginsInstalledPanel">
                            <WrapPanel Margin="0,12,0,0">
                                <Button Content="+ Installer un fichier…" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="InstallPlugin_Click"
                                        local:SettingsSearch.Keywords="plugin extension installer sysdeckplugin streamdeckplugin elgato"/>
                                <Button Content="Vérifier les mises à jour" Margin="0,0,8,0" Click="CheckPluginUpdates_Click"/>
                                <Button Content="Ouvrir le dossier des plugins" Click="OpenPluginsFolder_Click"/>
                            </WrapPanel>
                            <TextBlock Text="Un plugin exécute du code sur ce PC avec tes droits : n'installe que des plugins de confiance."
                                       FontSize="11.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>

                            <Border x:Name="PluginsEmptyCard" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="20,28">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="&#xEA86;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="30"
                                               Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Aucun plugin installé" Foreground="{StaticResource UiText}" FontSize="14"
                                               FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                    <TextBlock Text="Cherche-en un dans l'onglet Catalogue, ou installe un fichier .sysdeckplugin ou .streamDeckPlugin."
                                               Style="{StaticResource PageSubtitle}" TextAlignment="Center" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <StackPanel x:Name="PluginsList"/>
                        </StackPanel>

                        <!-- Catalogue : plugins vérifiés et dépôts GitHub -->
                        <StackPanel x:Name="PluginsCatalogPanel" Visibility="Collapsed">
                            <DockPanel Margin="0,12,0,0">
                                <Button DockPanel.Dock="Right" x:Name="CatalogSearchButton" Content="Rechercher" Style="{StaticResource PrimaryButton}"
                                        Margin="8,0,0,0" Click="CatalogSearch_Click"/>
                                <Border Height="34" CornerRadius="8" Background="{StaticResource InputBg}" BorderBrush="{StaticResource InputBorder}" BorderThickness="1">
                                    <Grid>
                                        <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Foreground="{StaticResource Muted}"
                                                   VerticalAlignment="Center" Margin="11,0,0,0"/>
                                        <TextBox x:Name="CatalogSearchBox" Background="Transparent" BorderThickness="0" Height="32" Padding="30,0,6,0"
                                                 KeyDown="CatalogSearchBox_KeyDown"/>
                                        <TextBlock Text="Nom ou usage du plugin (ex. : spotify, obs, discord, météo…) — vide : les plus populaires"
                                                   Foreground="{StaticResource Muted}" FontSize="12.5" IsHitTestVisible="False" VerticalAlignment="Center" Margin="32,0,0,0"
                                                   Visibility="{Binding Text, ElementName=CatalogSearchBox, Converter={StaticResource EmptyToVis}}"/>
                                    </Grid>
                                </Border>
                            </DockPanel>
                            <TextBlock x:Name="CatalogStatusText" FontSize="11.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="2,8,0,0"
                                       Text="Plugins publiés sur GitHub avec le sujet « sysdeck-plugin » ou « streamdeck-plugin ». Les plugins « Vérifiés » ont été testés avec SysDeck ; les autres viennent de la communauté."/>
                            <StackPanel x:Name="CatalogList" Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== Page : Émojis ===== -->
                <ScrollViewer x:Name="PageEmoji" Grid.Row="1" Style="{StaticResource PageScroller}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Émojis" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Un raccourci ouvre le sélecteur d'émojis ; un clic insère l'émoji dans le champ de texte où tu écris (navigateur, Discord, Word…). Le sélecteur reste ouvert jusqu'à ce que tu cliques sur sa croix."
                                   Style="{StaticResource PageSubtitle}"/>

                        <ContentControl Style="{StaticResource SectionHeader}" Content="Raccourci clavier"/>
                        <Border Style="{StaticResource RowCard}" local:SettingsSearch.Keywords="hotkey touche combinaison emoji émoji ctrl">
                            <StackPanel Style="{StaticResource RowsPanel}">
                                <controls:SettingRow Label="Combinaison"
                                                     Description="Clique dans la zone puis appuie sur ta combinaison (avec Ctrl, Maj, Alt ou Win). Évite Ctrl+Alt : sur un clavier AZERTY, c'est la touche AltGr (€, @, #…).">
                                    <StackPanel Orientation="Horizontal">
                                        <controls:HotkeyBox x:Name="EmojiHotkeyBox" Width="200" Style="{StaticResource {x:Type TextBox}}"
                                                            GestureCaptured="EmojiHotkeyBox_GestureCaptured" CaptureStateChanged="EmojiHotkeyBox_CaptureStateChanged"/>
                                        <Button Content="Désactiver" Margin="8,0,0,0" Click="ClearEmojiHotkey_Click"/>
                                    </StackPanel>
                                </controls:SettingRow>
                                <Border Style="{StaticResource RowBorder}" BorderThickness="0">
                                    <TextBlock x:Name="EmojiHotkeyStatus" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" Margin="0"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Apparence du sélecteur ; DataContext = réglages EmojiPicker -->
                        <ContentControl Style="{StaticResource SectionHeader}" Content="Apparence du sélecteur"/>
                        <Border x:Name="EmojiAppearanceCard" Style="{StaticResource RowCard}">
                            <StackPanel Style="{StaticResource RowsPanel}">
                                <controls:SettingRow Description="Le sélecteur est transparent : on voit ce qu'il y a derrière à travers son fond."/>
                                <controls:SettingRow Label="Couleurs">
                                    <WrapPanel>
                                        <controls:ColorSwatch Content="Fond" Hex="{Binding BackgroundColor}" Margin="0"/>
                                        <controls:ColorSwatch Content="Bordure" Hex="{Binding BorderColor}" Margin="10,0,0,0"/>
                                    </WrapPanel>
                                </controls:SettingRow>
                                <controls:SettingRow Label="Opacité du fond">
                                    <DockPanel Width="260">
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}" Text="{Binding BackgroundOpacity, Converter={StaticResource Percent}}"/>
                                        <Slider Minimum="0" Maximum="1" Value="{Binding BackgroundOpacity}" IsSnapToTickEnabled="True" TickFrequency="0.01"/>
                                    </DockPanel>
                                </controls:SettingRow>
                                <controls:SettingRow Label="Opacité de la bordure">
                                    <DockPanel Width="260">
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}" Text="{Binding BorderOpacity, Converter={StaticResource Percent}}"/>
                                        <Slider Minimum="0" Maximum="1" Value="{Binding BorderOpacity}" IsSnapToTickEnabled="True" TickFrequency="0.01"/>
                                    </DockPanel>
                                </controls:SettingRow>
                                <controls:SettingRow Label="Arrondi des coins">
                                    <DockPanel Width="260">
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}" Text="{Binding CornerRadius, StringFormat={}{0:0} px}"/>
                                        <Slider Minimum="0" Maximum="36" Value="{Binding CornerRadius}" IsSnapToTickEnabled="True" TickFrequency="1"/>
                                    </DockPanel>
                                </controls:SettingRow>
                                <controls:SettingRow Label="Valeurs d'origine">
                                    <Button Content="Réinitialiser" Click="ResetEmojiAppearance_Click"/>
                                </controls:SettingRow>
                            </StackPanel>
                        </Border>

                        <ContentControl Style="{StaticResource SectionHeader}" Content="Émojis récents"/>
                        <Border Style="{StaticResource RowCard}">
                            <StackPanel Style="{StaticResource RowsPanel}">
                                <controls:SettingRow Label="Effacer les émojis récents"
                                                     Description="Les derniers émojis insérés sont proposés en premier, dans l'onglet « Récents » du sélecteur.">
                                    <Button Content="Effacer" Click="ClearRecentEmojis_Click"/>
                                </controls:SettingRow>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== Page : Général ===== -->
                <ScrollViewer x:Name="PageGeneral" Grid.Row="1" Style="{StaticResource PageScroller}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Général" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Application, éléments masqués et réinitialisation." Style="{StaticResource PageSubtitle}"/>

                        <!-- Mesure des FPS (module Carte graphique) -->
                        <ContentControl Style="{StaticResource SectionHeader}" Content="Application"/>
                        <Border Style="{StaticResource RowCard}" local:SettingsSearch.Title="Images par seconde (FPS)"
                                local:SettingsSearch.Keywords="fps jeu jeux images seconde presentmon performance autoriser mesure carte graphique gpu">
                            <StackPanel Style="{StaticResource RowsPanel}">
                                <controls:SettingRow Label="Images par seconde (FPS)"
                                                     Description="La tuile FPS du module Carte graphique affiche les images par seconde du jeu au premier plan (DirectX, Vulkan, OpenGL), mesurées par PresentMon d'Intel. Windows réserve cette mesure aux administrateurs et au groupe « Utilisateurs du journal de performances » : il suffit d'y ajouter ton compte une fois.">
                                    <Button x:Name="FpsPermissionButton" Content="Autoriser la mesure des FPS" Style="{StaticResource PrimaryButton}"
                                            Click="FpsPermission_Click"/>
                                </controls:SettingRow>
                                <Border Style="{StaticResource RowBorder}" BorderThickness="0">
                                    <TextBlock x:Name="FpsStatusText" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <ContentControl Style="{StaticResource SectionHeader}" Content="Éléments masqués"/>
                        <Border Style="{StaticResource RowCard}" local:SettingsSearch.Keywords="réafficher périphériques audio mixeur applications masqués">
                            <StackPanel Style="{StaticResource RowsPanel}">
                                <controls:SettingRow Label="Périphériques audio" Description="Réaffiche tous les périphériques audio masqués.">
                                    <Button Content="Réafficher" Click="ResetHiddenAudio_Click"/>
                                </controls:SettingRow>
                                <controls:SettingRow Label="Applications du mixeur" Description="Réaffiche toutes les applications masquées du mixeur de volume.">
                                    <Button Content="Réafficher" Click="ResetHiddenVolumeMixerApps_Click"/>
                                </controls:SettingRow>
                            </StackPanel>
                        </Border>

                        <ContentControl Style="{StaticResource SectionHeader}" Content="Réinitialisation"/>
                        <Border Style="{StaticResource RowCard}" local:SettingsSearch.Keywords="reset remettre zéro défaut valeurs d'origine apparence réinitialiser">
                            <StackPanel Style="{StaticResource RowsPanel}">
                                <controls:SettingRow Label="Apparence"
                                                     Description="Remet le thème global et l'apparence de tous les modules aux valeurs d'origine. Les positions, raccourcis et éléments masqués sont conservés.">
                                    <Button x:Name="ResetAppearanceButton" Content="Réinitialiser toute l'apparence" Style="{StaticResource DangerButton}"
                                            Click="ResetAppearance_Click"/>
                                </controls:SettingRow>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== Page : Énergie (module Consommation électrique) ===== DataContext = réglages Power -->
                <ScrollViewer x:Name="PageEnergy" Grid.Row="1" Style="{StaticResource PageScroller}" Visibility="Collapsed">
                    <StackPanel x:Name="EnergyPanel">
                        <TextBlock Text="Énergie" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Prix de l'électricité et estimation de la consommation, utilisés par le module Consommation électrique."
                                   Style="{StaticResource PageSubtitle}"/>

                        <ContentControl Style="{StaticResource SectionHeader}" Content="Prix de l'électricité"/>
                        <Border Style="{StaticResource RowCard}"
                                local:SettingsSearch.Keywords="prix tarif kwh facture euro électricité heures creuses pleines watts puissance coût estimation consommation">
                            <StackPanel Style="{StaticResource RowsPanel}">
                                <controls:SettingRow Description="Prix TTC du kWh indiqué sur ta facture. Il est appliqué à chaque mesure : le changer ne modifie pas les montants déjà comptés."/>
                                <controls:SettingRow Label="Prix du kWh (€)" Description="Heures pleines si l'option heures creuses est active.">
                                    <TextBox Width="120" Text="{Binding PricePerKwh, Converter={StaticResource DecimalText}, UpdateSourceTrigger=LostFocus}"/>
                                </controls:SettingRow>
                                <controls:SettingRow Label="Heures pleines / heures creuses"
                                                     Description="Un second prix s'applique pendant la plage des heures creuses.">
                                    <CheckBox Style="{StaticResource ToggleSwitch}" Margin="0" IsChecked="{Binding UseOffPeak}"/>
                                </controls:SettingRow>
                                <StackPanel Visibility="{Binding UseOffPeak, Converter={StaticResource BoolToVis}}">
                                    <controls:SettingRow Label="Prix du kWh en heures creuses (€)">
                                        <TextBox Width="120" Text="{Binding OffPeakPricePerKwh, Converter={StaticResource DecimalText}, UpdateSourceTrigger=LostFocus}"/>
                                    </controls:SettingRow>
                                    <controls:SettingRow Label="Début des heures creuses">
                                        <DockPanel Width="260">
                                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}" Text="{Binding OffPeakStartHour, Converter={StaticResource Hour}}"/>
                                            <Slider Minimum="0" Maximum="23.5" Value="{Binding OffPeakStartHour}" IsSnapToTickEnabled="True" TickFrequency="0.5"/>
                                        </DockPanel>
                                    </controls:SettingRow>
                                    <controls:SettingRow Label="Fin des heures creuses">
                                        <DockPanel Width="260">
                                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}" Text="{Binding OffPeakEndHour, Converter={StaticResource Hour}}"/>
                                            <Slider Minimum="0" Maximum="23.5" Value="{Binding OffPeakEndHour}" IsSnapToTickEnabled="True" TickFrequency="0.5"/>
                                        </DockPanel>
                                    </controls:SettingRow>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <ContentControl Style="{StaticResource SectionHeader}" Content="Estimation de la puissance"/>
                        <Border Style="{StaticResource RowCard}" local:SettingsSearch.Keywords="watts puissance processeur écran alimentation rendement jauge estimation">
                            <StackPanel Style="{StaticResource RowsPanel}">
                                <controls:SettingRow Description="La carte graphique est mesurée par son capteur. Le processeur aussi quand son capteur est accessible ; sinon (Intégrité de la mémoire activée) il est estimé selon sa charge, entre les deux valeurs ci-dessous. Le reste n'a aucun capteur : c'est un forfait."/>
                                <controls:SettingRow Label="Processeur au repos" Description="Si estimé.">
                                    <DockPanel Width="260">
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}" Text="{Binding CpuIdleWatts, StringFormat={}{0:0} W}"/>
                                        <Slider Minimum="5" Maximum="100" Value="{Binding CpuIdleWatts}" IsSnapToTickEnabled="True" TickFrequency="1"/>
                                    </DockPanel>
                                </controls:SettingRow>
                                <controls:SettingRow Label="Processeur à pleine charge" Description="Si estimé.">
                                    <DockPanel Width="260">
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}" Text="{Binding CpuMaxWatts, StringFormat={}{0:0} W}"/>
                                        <Slider Minimum="30" Maximum="350" Value="{Binding CpuMaxWatts}" IsSnapToTickEnabled="True" TickFrequency="5"/>
                                    </DockPanel>
                                </controls:SettingRow>
                                <controls:SettingRow Label="Autres composants" Description="Carte mère, RAM, SSD, ventilateurs, USB.">
                                    <DockPanel Width="260">
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}" Text="{Binding OtherWatts, StringFormat={}{0:0} W}"/>
                                        <Slider Minimum="0" Maximum="200" Value="{Binding OtherWatts}" IsSnapToTickEnabled="True" TickFrequency="5"/>
                                    </DockPanel>
                                </controls:SettingRow>
                                <controls:SettingRow Label="Écran(s)" Description="0 pour ne pas les compter.">
                                    <DockPanel Width="260">
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}" Text="{Binding MonitorWatts, StringFormat={}{0:0} W}"/>
                                        <Slider Minimum="0" Maximum="300" Value="{Binding MonitorWatts}" IsSnapToTickEnabled="True" TickFrequency="5"/>
                                    </DockPanel>
                                </controls:SettingRow>
                                <controls:SettingRow Label="Rendement de l'alimentation" Description="80+ Gold ≈ 90 %.">
                                    <DockPanel Width="260">
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}" Text="{Binding PsuEfficiency, Converter={StaticResource Percent}}"/>
                                        <Slider Minimum="0.7" Maximum="0.98" Value="{Binding PsuEfficiency}" IsSnapToTickEnabled="True" TickFrequency="0.01"/>
                                    </DockPanel>
                                </controls:SettingRow>
                                <controls:SettingRow Label="Maximum de la jauge">
                                    <DockPanel Width="260">
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}" Text="{Binding GaugeMaxWatts, StringFormat={}{0:0} W}"/>
                                        <Slider Minimum="100" Maximum="1500" Value="{Binding GaugeMaxWatts}" IsSnapToTickEnabled="True" TickFrequency="50"/>
                                    </DockPanel>
                                </controls:SettingRow>
                            </StackPanel>
                        </Border>

                        <ContentControl Style="{StaticResource SectionHeader}" Content="Heures d'utilisation"/>
                        <Border Style="{StaticResource RowCard}" local:SettingsSearch.Keywords="jour soir heures début fin utilisation">
                            <StackPanel Style="{StaticResource RowsPanel}">
                                <controls:SettingRow Description="Le temps d'allumage (hors veille) est réparti en « jour » et « soir ». Le soir va de la fin du jour jusqu'au début du jour suivant. Les heures déjà mesurées gardent la plage en vigueur au moment de la mesure ; les heures reprises du journal Windows suivent le réglage actuel."/>
                                <controls:SettingRow Label="Début du jour">
                                    <DockPanel Width="260">
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}" Text="{Binding DayStartHour, Converter={StaticResource Hour}}"/>
                                        <Slider Minimum="0" Maximum="23.5" Value="{Binding DayStartHour}" IsSnapToTickEnabled="True" TickFrequency="0.5"/>
                                    </DockPanel>
                                </controls:SettingRow>
                                <controls:SettingRow Label="Fin du jour" Description="Début du soir.">
                                    <DockPanel Width="260">
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}" Text="{Binding DayEndHour, Converter={StaticResource Hour}}"/>
                                        <Slider Minimum="0" Maximum="23.5" Value="{Binding DayEndHour}" IsSnapToTickEnabled="True" TickFrequency="0.5"/>
                                    </DockPanel>
                                </controls:SettingRow>
                            </StackPanel>
                        </Border>

                        <ContentControl Style="{StaticResource SectionHeader}" Content="Depuis la mise en service"/>
                        <Border Style="{StaticResource RowCard}" local:SettingsSearch.Keywords="mise en service date installation windows journal moyenne remise zéro cumul réinitialiser session mois">
                            <StackPanel Style="{StaticResource RowsPanel}">
                                <controls:SettingRow Description="Avant SysDeck, rien n'a été mesuré : les heures d'allumage sont reprises du journal Windows (qui ne garde que les derniers mois), puis extrapolées jusqu'à la mise en service au même rythme. Elles sont comptées à la puissance moyenne ci-dessous et au prix actuel. C'est une estimation."/>
                                <controls:SettingRow Label="Date de la première mise en service" Description="jj/mm/aaaa — vide = installation de Windows.">
                                    <TextBox Width="120" Text="{Binding FirstPowerOnDate, Converter={StaticResource DateText}, UpdateSourceTrigger=LostFocus, TargetNullValue=''}"/>
                                </controls:SettingRow>
                                <controls:SettingRow Label="Puissance moyenne avant SysDeck" Description="0 = moyenne mesurée par SysDeck.">
                                    <DockPanel Width="260">
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}" Text="{Binding PastAverageWatts, StringFormat={}{0:0} W}"/>
                                        <Slider Minimum="0" Maximum="800" Value="{Binding PastAverageWatts}" IsSnapToTickEnabled="True" TickFrequency="10"/>
                                    </DockPanel>
                                </controls:SettingRow>
                                <Border Style="{StaticResource RowBorder}">
                                    <Border Background="{StaticResource UiHover}" CornerRadius="6" Padding="12,10">
                                        <TextBlock x:Name="LifetimeDetailsText" FontSize="11.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="18"/>
                                    </Border>
                                </Border>
                                <controls:SettingRow Label="Compteurs de la période" Description="Le cumul depuis la mise en service est conservé.">
                                    <Button x:Name="ResetPowerButton" Content="Réinitialiser session, jour et mois" Click="ResetPower_Click"/>
                                </controls:SettingRow>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
