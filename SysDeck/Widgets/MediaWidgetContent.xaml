<UserControl x:Class="SysDeck.Widgets.MediaWidgetContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SysDeck.Controls"
             Width="230">
    <UserControl.Resources>
        <Storyboard x:Key="SpinStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="DiscRotation" Storyboard.TargetProperty="Angle"
                              From="0" To="360" Duration="0:0:6"/>
        </Storyboard>
    </UserControl.Resources>
    <StackPanel>
        <StackPanel Orientation="Horizontal">
            <Grid controls:Movable.Key="disc" Margin="0,0,12,0">
            <Grid x:Name="DiscRoot" Width="56" Height="56" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <RotateTransform x:Name="DiscRotation" Angle="0"/>
                </Grid.RenderTransform>

                <!-- Pochette/vignette du média, découpée en disque -->
                <Ellipse Width="56" Height="56" Fill="#1E2027"/>
                <Image x:Name="ThumbnailImage" Width="56" Height="56" Stretch="UniformToFill">
                    <Image.Clip>
                        <EllipseGeometry Center="28,28" RadiusX="28" RadiusY="28"/>
                    </Image.Clip>
                </Image>

                <!-- Anneau extérieur façon CD/vinyle -->
                <Ellipse Width="56" Height="56" Stroke="{DynamicResource GaugeGradientBrush}" StrokeThickness="2"/>
                <!-- Trou central -->
                <Ellipse Width="14" Height="14" Fill="{DynamicResource BgBrush}" Stroke="{DynamicResource AccentBrush2}" StrokeThickness="1"/>
                <Ellipse Width="4" Height="4" Fill="{DynamicResource AccentBrush2}"/>
            </Grid>
            </Grid>

            <StackPanel controls:Movable.Key="track" VerticalAlignment="Center" Width="150">
                <TextBlock controls:TextPart.Key="track" x:Name="TitleText" Text="Aucune lecture en cours" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock controls:TextPart.Key="artist" x:Name="SubtitleText" Text="" Style="{StaticResource SubText}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
            </StackPanel>
        </StackPanel>

        <StackPanel controls:Movable.Key="controls" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
            <!-- Icônes : formes définies dans le code-behind selon le jeu choisi (SetIconSet). -->
            <Button x:Name="PrevButton" Click="Prev_Click" Style="{StaticResource IconButtonStyle}" Margin="0,0,14,0"
                    controls:ButtonPart.Key="previous">
                <Path x:Name="PrevIcon" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      StrokeLineJoin="Round" Width="12" Height="12" Stretch="Uniform"/>
            </Button>
            <!-- Clé « play » / « pause » mise à jour par le code selon l'état de la lecture (ApplyIcons). -->
            <Button x:Name="PlayPauseButton" Click="PlayPause_Click" Margin="0,0,14,0" Cursor="Hand" controls:ButtonPart.Key="play">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid Width="34" Height="34">
                            <Ellipse x:Name="Bg" Fill="{DynamicResource GaugeGradientBrush}"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- Jeu « Néon » : anneau au dégradé au lieu d'un disque plein. -->
                            <Trigger Property="Tag" Value="Outline">
                                <Setter TargetName="Bg" Property="Fill" Value="Transparent"/>
                                <Setter TargetName="Bg" Property="Stroke" Value="{DynamicResource GaugeGradientBrush}"/>
                                <Setter TargetName="Bg" Property="StrokeThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <Path x:Name="PlayPauseIcon" StrokeThickness="1.6" StrokeLineJoin="Round"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="13" Height="13" Stretch="Uniform"/>
            </Button>
            <Button x:Name="NextButton" Click="Next_Click" Style="{StaticResource IconButtonStyle}" controls:ButtonPart.Key="next">
                <Path x:Name="NextIcon" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      StrokeLineJoin="Round" Width="12" Height="12" Stretch="Uniform"/>
            </Button>

            <!-- Ferme complètement Spotify (pas juste une pause) — visible seulement si la lecture
                 en cours vient de Spotify, puisque cette action n'a de sens que pour cette appli. -->
            <Button x:Name="StopSpotifyButton" Click="StopSpotify_Click" Style="{StaticResource IconButtonStyle}"
                    Margin="14,0,0,0" controls:ButtonPart.Wanted="False" controls:ButtonPart.Key="stopSpotify" ToolTip="Fermer Spotify">
                <Path x:Name="StopIcon" StrokeThickness="1.6" StrokeLineJoin="Round" Width="11" Height="11" Stretch="Uniform"/>
            </Button>
        </StackPanel>
    </StackPanel>
</UserControl>
