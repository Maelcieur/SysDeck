                                        <PasswordBox x:Name="GeminiApiKeyBox" Width="240"/>
                                        <Button Content="Enregistrer la clé" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Click="SaveGeminiKey_Click"/>
                                    </StackPanel>
                                </controls:SettingRow>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

