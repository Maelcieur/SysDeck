<UserControl x:Class="SysDeck.Widgets.DiskWidgetContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SysDeck.Controls"
             Width="230">
    <UserControl.Resources>
        <!-- Forme « Anneaux » : une jauge circulaire par disque, côte à côte -->
        <ItemsPanelTemplate x:Key="RingPanel">
            <WrapPanel Orientation="Horizontal"/>
        </ItemsPanelTemplate>
        <DataTemplate x:Key="RingTemplate">
            <StackPanel Width="76" Margin="0,0,0,8" controls:Movable.Key="{Binding Key}">
                <Grid Width="66" Height="66">
                    <controls:RadialGauge x:Name="Gauge" Thickness="5" Value="{Binding LoadPercent, Mode=OneWay}"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock controls:TextPart.Key="drive" Text="{Binding Name}" Style="{StaticResource GaugeValueText}" FontSize="14"/>
                        <TextBlock controls:TextPart.Key="percent" Text="{Binding DisplayValue, ElementName=Gauge, StringFormat={}{0:0}%}"
                                   Style="{StaticResource GaugeLabelText}" FontSize="9.5"/>
                    </StackPanel>
                </Grid>
                <TextBlock controls:TextPart.Key="usage" Style="{StaticResource SubText}" FontSize="9.5" HorizontalAlignment="Center" Margin="0,1,0,0">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0:0} / {1:0} Go">
                            <Binding Path="UsedGb"/>
                            <Binding Path="TotalGb"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </StackPanel>
        </DataTemplate>

        <!-- Forme « Lignes » : une barre horizontale par disque, les uns sous les autres -->
        <ItemsPanelTemplate x:Key="BarPanel">
            <StackPanel/>
        </ItemsPanelTemplate>
        <DataTemplate x:Key="BarTemplate">
            <StackPanel Margin="0,0,0,10" controls:Movable.Key="{Binding Key}">
                <DockPanel Margin="0,0,0,4">
                    <TextBlock controls:TextPart.Key="percent" DockPanel.Dock="Right" Style="{StaticResource NumberText}" FontSize="12"
                               Text="{Binding DisplayValue, ElementName=Bar, StringFormat={}{0:0} %}" VerticalAlignment="Bottom"/>
                    <TextBlock controls:TextPart.Key="drive" Text="{Binding Name}" Style="{StaticResource NumberText}" FontSize="13" VerticalAlignment="Bottom"/>
                    <TextBlock controls:TextPart.Key="usage" Style="{StaticResource SubText}" FontSize="9.5" Margin="8,0,0,1" VerticalAlignment="Bottom">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0:0} / {1:0} Go">
                                <Binding Path="UsedGb"/>
                                <Binding Path="TotalGb"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </DockPanel>
                <controls:LinearGauge x:Name="Bar" Height="6" Value="{Binding LoadPercent, Mode=OneWay}"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <StackPanel controls:Movable.Key="title" Orientation="Horizontal">
            <TextBlock controls:TextPart.Key="title" Text="DISQUES" Style="{StaticResource WidgetCaption}"/>
        </StackPanel>

        <ItemsControl x:Name="DrivesList" Margin="0,10,0,0"
                      ItemsPanel="{StaticResource RingPanel}" ItemTemplate="{StaticResource RingTemplate}"/>
    </StackPanel>
</UserControl>
